---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteShell from "./SiteShell.astro";
import { localePath, type SiteLocale } from "../lib/i18n.ts";

type Props = {
  locale?: SiteLocale;
};

const { locale = "en" } = Astro.props as Props;
const isZh = locale === "zh-CN";

const currentPath = localePath(locale, "/ai/");
const alternatePath = localePath(isZh ? "en" : "zh-CN", "/ai/");
const aiDocHref = localePath(locale, "/docs/extensions/ai/");
const agentDocHref = localePath(locale, "/docs/extensions/agent/");
const executionDocHref = localePath(locale, "/docs/extensions/execution/");

const pageTitle = isZh ? "Bitty AI 与 Wheel — Bitty" : "Bitty AI & Wheel — Bitty";
const pageDescription = isZh
  ? "Bitty 零信任 AI 进程边界：bitty、bittyd (bitty-ai) 与 wheel 智能体套件。"
  : "Bitty's zero-trust AI boundary: bitty, bittyd (bitty-ai), and the wheel agent harness.";

const commands = isZh
  ? [
      { cmd: ":WheelSend", desc: "将当前有界选区或终端快照发送至活跃的 Wheel 会话。" },
      { cmd: ":WheelApprove", desc: "在终端内批准当前排队的 .approvals.lock 工具调用。" },
      { cmd: ":WheelDeny", desc: "拒绝当前暂存的高风险工具调用。" },
      { cmd: ":WheelThinking high", desc: "切换思考深度档位（off | low | medium | high | auto）。" },
      { cmd: ":Dashboard (Ctrl+Shift+D)", desc: "切换实时 AI 与系统遥测覆盖层。" },
    ]
  : [
      { cmd: ":WheelSend", desc: "Send the bounded selection or terminal snapshot to the active Wheel session." },
      { cmd: ":WheelApprove", desc: "Approve the pending tool call in the .approvals.lock queue." },
      { cmd: ":WheelDeny", desc: "Deny the staged tool call and record a reason." },
      { cmd: ":WheelThinking high", desc: "Switch thinking gear (off | low | medium | high | auto)." },
      { cmd: ":Dashboard (Ctrl+Shift+D)", desc: "Toggle the live AI and system telemetry overlay." },
    ];
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  currentPath={currentPath}
  alternatePath={alternatePath}
>
  <SiteHeader
    locale={locale}
    activeNav="ai"
    alternateHref={alternatePath}
    currentPath={currentPath}
  />

  <SiteShell locale={locale} activeSection="ai">
    <main id="main-content" class="niri-main" tabindex="-1">
    <article class="niri-prose">
      <h1>{isZh ? "Bitty AI 与 Wheel" : "Bitty AI & Wheel"}</h1>

      {
        isZh ? (
          <>
            <p>
              Bitty 将终端核心与 AI 运行时严格隔离在零信任进程边界两侧：
              <code>bitty ↔ bittyd (bitty-ai) ↔ wheel</code>。终端核心不持有任何
              API 密钥，也不具备自主命令执行权。
            </p>
            <p>
              凭据仅存于受限权限的本地配置文件中，<code>bittyd</code> 通过{" "}
              <code>0600</code> 本地 Unix 套接字与能力令牌调度模型与 MCP
              桥接，所有高风险变更均进入原子化{" "}
              <code>.approvals.lock</code> 队列等待显式批准。
            </p>
          </>
        ) : (
          <>
            <p>
              Bitty enforces a zero-trust process boundary between the terminal
              core and the AI runtime: <code>bitty ↔ bittyd (bitty-ai) ↔ wheel</code>.
              The terminal core holds zero API credentials and zero autonomous
              execution authority.
            </p>
            <p>
              <code>bittyd</code> communicates over a <code>0600</code> local
              Unix domain socket with capability tokens, multi-provider and MCP
              routing, and an atomic <code>.approvals.lock</code> queue that
              stages high-risk mutations for explicit approval.
            </p>
          </>
        )
      }

      <h2>{isZh ? "快速开始 (CLI)" : "Quickstart CLI"}</h2>
      <pre><code>wheel chat
wheel ask "explain the last failing cargo test"
wheel status
wheel approve &lt;id&gt;</code></pre>

      <h2>{isZh ? "终端内命令" : "In-Terminal Commands"}</h2>
      <div class="table-scroll" tabindex="0">
        <table>
          <thead>
            <tr>
              <th>{isZh ? "命令" : "Command"}</th>
              <th>{isZh ? "说明" : "Description"}</th>
            </tr>
          </thead>
          <tbody>
            {
              commands.map((item) => (
                <tr>
                  <td>
                    <code>{item.cmd}</code>
                  </td>
                  <td>{item.desc}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>{isZh ? "相关文档与仓库" : "Documentation & Repositories"}</h2>
      <ul>
        <li>
          <a href={aiDocHref}>
            {isZh ? "ai (原生扩展)" : "ai (native extension)"}
          </a>
        </li>
        <li>
          <a href={agentDocHref}>
            {isZh ? "agent (原生扩展)" : "agent (native extension)"}
          </a>
        </li>
        <li>
          <a href={executionDocHref}>
            {isZh ? "execution (原生扩展)" : "execution (native extension)"}
          </a>
        </li>
        <li>
          <a
            href="https://github.com/bitty-terminal/bitty-ai"
            target="_blank"
            rel="noopener noreferrer"
          >
            bitty-ai (GitHub)
          </a>
        </li>
        <li>
          <a
            href="https://github.com/bitty-terminal/wheel"
            target="_blank"
            rel="noopener noreferrer"
          >
            wheel (GitHub)
          </a>
        </li>
      </ul>
    </article>
  </main>
  </SiteShell>
</BaseLayout>
