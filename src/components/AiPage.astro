---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import { localePath, type SiteLocale } from "../lib/i18n.ts";

type Props = {
  locale?: SiteLocale;
};

const { locale = "en" } = Astro.props as Props;
const isZh = locale === "zh-CN";

const currentPath = localePath(locale, "/ai/");
const alternatePath = localePath(isZh ? "en" : "zh-CN", "/ai/");
const aiDocHref = localePath(locale, "/docs/extensions/ai/");
const agentDocHref = localePath(locale, "/docs/extensions/agent/");
const executionDocHref = localePath(locale, "/docs/extensions/execution/");

const pageTitle = isZh ? "Bitty AI 与 Wheel — Bitty" : "Bitty AI & Wheel — Bitty";
const pageDescription = isZh
  ? "Bitty AI (bittyd) 与 Wheel (Bittie) 零信任进程隔离智能体架构。"
  : "Zero-trust process boundary between bitty, bittyd (bitty-ai), and the wheel (Bittie) agent harness.";
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  currentPath={currentPath}
  alternatePath={alternatePath}
>
  <SiteHeader
    locale={locale}
    activeNav="ai"
    currentPath={currentPath}
    alternateHref={alternatePath}
  />

  <main id="main-content" class="minimal-main" tabindex="-1">
    <header class="minimal-header">
      <h1>{isZh ? "Bitty AI 与 Wheel" : "Bitty AI & Wheel"}</h1>
      <p class="minimal-lead">
        {
          isZh
            ? "Bitty 通过严格的三方零信任边界隔离终端与智能体：bitty 核心不持有任何 API 密钥或自主执行权；AI 凭据与推理仅在 bittyd（bitty-ai）与 wheel（Bittie）中运行，经由 0600 权限本地 Unix 套接字（~/.local/state/bitty/bittyd.sock）通信，高风险操作进入 .approvals.lock 审批队列，并支持五档思考深度与 MCP 桥接。"
            : "Bitty isolates terminal rendering from AI execution across a zero-trust boundary: bitty ↔ bittyd (bitty-ai) ↔ wheel (Bittie). The terminal core holds zero API credentials and zero autonomous shell authority; bittyd communicates over a 0600 local Unix socket (~/.local/state/bitty/bittyd.sock), stages risky mutations into an atomic .approvals.lock queue, and supports 5 thinking gears plus MCP."
        }
      </p>
    </header>

    <section class="minimal-section" aria-labelledby="ai-commands-title">
      <h2 id="ai-commands-title">
        {isZh ? "命令行与终端内快捷键" : "CLI & Keybindings"}
      </h2>
      <pre class="cli-block"><code>{`wheel chat                 # ${isZh ? "启动 Bittie 交互式会话" : "Start an interactive Bittie session"}
wheel status               # ${isZh ? "检查 bittyd 与审批队列状态" : "Inspect bittyd daemon & approval queue"}
:WheelApprove              # ${isZh ? "批准当前暂存的工具调用" : "Approve staged .approvals.lock mutation"}
:WheelThinking high        # ${isZh ? "切换思考档位 (off|low|medium|high|auto)" : "Switch thinking gear (off|low|medium|high|auto)"}
Ctrl+Shift+D               # ${isZh ? "打开实时 AI 遥测覆盖层" : "Toggle live AI telemetry dashboard"}`}</code></pre>
    </section>

    <section class="minimal-section" aria-labelledby="ai-links-title">
      <h2 id="ai-links-title">
        {isZh ? "文档与仓库" : "Documentation & Repositories"}
      </h2>
      <ul class="resource-list">
        <li>
          <a href={aiDocHref}>
            {isZh ? "AI 扩展手册 (bitty-ai / bittyd)" : "AI Extension Docs (bitty-ai / bittyd)"}
          </a>
          <span class="link-path">/docs/extensions/ai/</span>
        </li>
        <li>
          <a href={agentDocHref}>
            {isZh ? "Agent 协议手册 (bitty-agent)" : "Agent Protocol Docs (bitty-agent)"}
          </a>
          <span class="link-path">/docs/extensions/agent/</span>
        </li>
        <li>
          <a href={executionDocHref}>
            {isZh ? "Execution 监管手册 (bitty-execution)" : "Execution Supervisor Docs (bitty-execution)"}
          </a>
          <span class="link-path">/docs/extensions/execution/</span>
        </li>
        <li>
          <a
            href="https://github.com/bitty-terminal/wheel"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub: bitty-terminal/wheel ↗
          </a>
        </li>
        <li>
          <a
            href="https://github.com/bitty-terminal/bitty-ai"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub: bitty-terminal/bitty-ai ↗
          </a>
        </li>
      </ul>
    </section>
  </main>

  <SiteFooter locale={locale} />
</BaseLayout>

<style>
  .minimal-main {
    flex: 1 0 auto;
    width: min(52rem, calc(100% - 2rem));
    margin-inline: auto;
    padding-block: 2.75rem 4.5rem;
  }

  .minimal-header {
    margin-bottom: 2.25rem;
  }

  .minimal-header h1 {
    margin: 0 0 0.85rem;
    font-size: clamp(1.75rem, 3.5vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .minimal-lead {
    margin: 0;
    color: var(--fg-secondary);
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .minimal-section + .minimal-section {
    margin-top: 2.25rem;
  }

  .minimal-section h2 {
    margin: 0 0 0.85rem;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .cli-block {
    margin: 0;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  .resource-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .resource-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    padding-block: 0.65rem;
    border-bottom: 1px solid var(--line);
  }

  .resource-list a {
    color: var(--accent);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
  }

  .resource-list a:hover {
    text-decoration: underline;
  }

  .link-path {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }
</style>
