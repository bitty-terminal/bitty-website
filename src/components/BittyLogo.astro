---
/**
 * Bitty wordmark: the mascot, served from the public CDN.
 *
 * The artwork is source material owned outside this repository
 * (`recording/bitty-mascot/raster`). Published derivatives are
 * content-addressed immutable objects in the R2 bucket `bitty`, referenced
 * through `cdnUrl()` so the Astro `dist/` output stays text-only
 * (see docs/cdn-assets.md).
 *
 * DPR handling: the mark renders in a 36px box, so a single 512px PNG would
 * push ~150 KB to every page for a decorative glyph. `srcset` offers three
 * WebP derivatives instead, and the browser picks the smallest one at least as
 * large as the device pixel ratio needs. WebP is the only format offered
 * because every target browser supports it; no `<picture>` fallback is needed.
 *
 * Accessibility: the adjacent word "Bitty" already names the brand, so the
 * image is decorative — `alt=""` plus `aria-hidden` keeps it out of the
 * accessibility tree. Explicit `width`/`height` reserve the box before load
 * and prevent layout shift, and `decoding="async"` keeps the header from
 * blocking first paint on the image decode.
 */
import { cdnUrl } from "../lib/cdn.ts";

// Content-addressed object names; the hash covers the asset bytes, so changed
// artwork yields a new key instead of a stale immutable cache hit.
const MASCOT_64 = "images/bitty-mascot-64-f11de4cc2933.webp";
const MASCOT_128 = "images/bitty-mascot-128-6b2705ae3c9c.webp";
const MASCOT_512 = "images/bitty-mascot-512-cb8596eecb67.webp";

const LOGO_BOX_PX = 36;
---

<img
  class="brand-logo"
  src={cdnUrl(MASCOT_128)}
  alt=""
  aria-hidden="true"
  decoding="async"
  fetchpriority="high"
  width={LOGO_BOX_PX}
  height={LOGO_BOX_PX}
  srcset={`${cdnUrl(MASCOT_64)} 64w, ${cdnUrl(MASCOT_128)} 128w, ${cdnUrl(
    MASCOT_512,
  )} 512w`}
  sizes={`${LOGO_BOX_PX}px`}
/>
