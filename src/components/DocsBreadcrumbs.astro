---
/**
 * Docs breadcrumb trail & R2 metadata bar.
 * Shows the locale, section, document filename, and CF-Cache status.
 */
import { getManualBreadcrumb } from "../lib/manualDocs.ts";

type Props = {
  slug: string;
  /** Optional locale, default 'en'. */
  locale?: string;
  /** Raw markdown content. */
  rawMarkdown?: string;
};

const { slug, locale = "en" } = Astro.props as Props;

const info = getManualBreadcrumb(slug, locale);
const isZh = locale === "zh-CN";
const sectionTitle = info?.sectionTitle ?? (isZh ? "手册" : "Documentation");
const r2Key = info?.r2Key ?? `${slug}.md`;
const fileName = r2Key.split("/").pop() ?? r2Key;
---

<nav
  class="docs-metadata-bar font-mono-tech text-xs"
  aria-label={isZh ? "面包屑导航" : "Breadcrumb"}
>
  <div class="breadcrumb-trail">
    <a href={isZh ? "/zh-CN/docs/" : "/docs/"} class="crumb-link">
      {isZh ? "手册" : "docs"}
    </a>
    <span class="crumb-sep">/</span>
    <span class="crumb-locale">{locale}</span>
    <span class="crumb-sep">/</span>
    <span class="crumb-section">{sectionTitle}</span>
    <span class="crumb-sep">/</span>
    <span class="crumb-file">{fileName}</span>
  </div>

  <div class="metadata-actions">
    <span class="cf-cache-pill">bitty-manual · {locale}</span>
  </div>
</nav>

<style>
  .docs-metadata-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block-end: 1rem;
    margin-block-end: 1.5rem;
    border-block-end: 1px solid var(--border-subtle);
  }

  .breadcrumb-trail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    color: var(--fg-muted);
  }

  .crumb-link {
    color: var(--fg-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .crumb-link:hover {
    color: var(--accent);
  }

  .crumb-sep {
    color: var(--border-focus);
    opacity: 0.4;
  }

  .crumb-locale {
    padding: 0.1rem 0.35rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 3px;
    color: var(--fg-primary);
  }

  .crumb-section {
    color: var(--fg-secondary);
  }

  .crumb-file {
    color: var(--accent);
    font-weight: 600;
  }

  .metadata-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cf-cache-pill {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--fg-muted);
    font-size: 0.65rem;
  }
</style>
