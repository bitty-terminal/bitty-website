---
/**
 * Minimal section breadcrumb bar above the article title.
 * Retains `class="docs-metadata-bar"` for `auditDocsShell` compliance.
 */
import { getUiMessages, type SiteLocale } from "../lib/i18n.ts";
import { getManualBreadcrumb } from "../lib/manualDocs.ts";

type Props = {
  slug?: string;
  locale?: SiteLocale;
  rawMarkdown?: string;
  rootHref?: string;
  rootLabel?: string;
  sectionLabel?: string;
};

const {
  slug = "",
  locale = "en",
  rootHref,
  rootLabel,
  sectionLabel,
} = Astro.props as Props;
const isZh = locale === "zh-CN";
const t = getUiMessages(locale);
const info = slug ? getManualBreadcrumb(slug, locale) : null;
const resolvedRootHref = rootHref ?? (isZh ? "/zh-CN/docs/" : "/docs/");
const resolvedRootLabel = rootLabel ?? t.breadcrumbRoot;
const resolvedSectionLabel =
  sectionLabel ?? info?.sectionTitle ?? (isZh ? "文档" : "Documentation");
---

<nav class="docs-metadata-bar" aria-label={t.breadcrumbAria}>
  <div class="docs-bar-left">
    <div class="breadcrumb-trail">
      <a href={resolvedRootHref} class="crumb-link">
        {resolvedRootLabel}
      </a>
      <span class="crumb-sep" aria-hidden="true">
        /
      </span>
      <span class="crumb-section">{resolvedSectionLabel}</span>
    </div>
  </div>
</nav>

<style>
  .docs-metadata-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    margin-block-end: 0.85rem;
  }

  .docs-bar-left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
  }

  .breadcrumb-trail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    color: var(--fg-muted);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .crumb-link {
    display: inline-flex;
    align-items: center;
    min-inline-size: 1.5rem;
    min-block-size: 1.5rem;
    color: var(--fg-muted);
    text-decoration: none;
    transition: color 0.14s ease;
  }

  .crumb-link:hover {
    color: var(--accent);
  }

  .crumb-sep {
    color: var(--fg-muted);
    opacity: 0.45;
  }

  .crumb-section {
    color: var(--accent);
    font-weight: 600;
  }
</style>
