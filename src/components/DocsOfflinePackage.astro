---
/**
 * Offline bitty-manual archive links.
 * Positioned across the bottom of documentation pages.
 * Recommends users to directly download packaged docs from Cloudflare R2.
 */
interface Props {
  locale?: string;
  version?: string;
}

const { locale = "en", version = "0.1.0" } = Astro.props as Props;
const isZh = locale === "zh-CN";

const R2_MANUAL_BASE = "https://cdn.bitty.run/manual";
const manualArchive = `${R2_MANUAL_BASE}/bitty-manual/v${version}/${locale}.tar.gz`;
const manualZip = `${R2_MANUAL_BASE}/bitty-manual/v${version}/${locale}.zip`;
---

<section
  class="docs-offline-box"
  aria-label={isZh ? "离线手册" : "Offline documentation"}
>
  <div class="offline-card">
    <div class="offline-copy">
      <div class="offline-title-row">
        <span class="offline-title">
          {isZh
            ? "离线手册归档 (Cloudflare R2)"
            : "Offline Manual Archive (Cloudflare R2)"}
        </span>
        <span class="offline-badge">v{version} · SHA-256</span>
      </div>
      <p class="offline-desc">
        {isZh
          ? "包含当前语言完整的 Markdown 源文件与导航清单，固定版本摘要记录在构建锁文件中。"
          : "Complete Markdown source tree and navigation manifest for this language, pinned in the repository build lock."}
      </p>
    </div>

    <div class="offline-actions">
      <a href={manualArchive} class="dev-btn" download>
        <svg
          class="dl-icon"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M8 2.5v7.5M5 7.25L8 10.25l3-3M2.75 12.75h10.5"></path>
        </svg>
        <span>{locale}.tar.gz</span>
      </a>
      <a href={manualZip} class="dev-btn" download>
        <svg
          class="dl-icon"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M8 2.5v7.5M5 7.25L8 10.25l3-3M2.75 12.75h10.5"></path>
        </svg>
        <span>{locale}.zip</span>
      </a>
    </div>
  </div>
</section>

<style>
  .docs-offline-box {
    margin-block-start: 2rem;
  }

  .offline-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    padding: 1.15rem 1.35rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-surface);
    box-shadow: var(--shadow-xs);
  }

  .offline-copy {
    flex: 1 1 20rem;
    min-width: 0;
  }

  .offline-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .offline-title {
    color: var(--fg-primary);
    font-family: var(--font-display);
    font-size: 0.925rem;
    font-weight: 600;
  }

  .offline-badge {
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-elevated);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
  }

  .offline-desc {
    margin: 0;
    color: var(--fg-secondary);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .offline-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .dl-icon {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
  }
</style>
