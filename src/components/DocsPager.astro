---
/**
 * Docs previous/next pager (CTX-0050, CTX-0064).
 * Reads the linear reading order from bitty-manual.
 */
import { getManualPager } from "../lib/manualDocs.ts";

type Props = {
  locale?: "en" | "zh-CN";
  currentSlug: string;
};

const { locale = "en", currentSlug } = Astro.props as Props;

const { previous, next } = getManualPager(currentSlug, locale);
const isZh = locale === "zh-CN";
---

{(previous !== null || next !== null) && (
  <nav class="docs-pager" aria-label={isZh ? "分页导航" : "Pagination"}>
    {previous !== null ? (
      <a
        class="docs-pager-link docs-pager-prev"
        href={previous.href}
        rel="prev"
      >
        <span class="docs-pager-hint">
          {locale === "zh-CN" ? "← 上一篇" : "← Previous"}
        </span>
        <span class="docs-pager-target">{previous.title}</span>
      </a>
    ) : (
      <div class="docs-pager-placeholder" aria-hidden="true"></div>
    )}
    {next !== null && (
      <a class="docs-pager-link docs-pager-next" href={next.href} rel="next">
        <span class="docs-pager-hint">
          {locale === "zh-CN" ? "下一篇 →" : "Next →"}
        </span>
        <span class="docs-pager-target">{next.title}</span>
      </a>
    )}
  </nav>
)}

<style>
  .docs-pager {
    display: grid;
    gap: 1rem;
    margin-block-start: 3rem;
    padding-block-start: 1.75rem;
    border-block-start: 1px solid var(--line);
  }

  @media (min-width: 40rem) {
    .docs-pager {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .docs-pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-block-size: var(--touch-target);
    padding: 0.95rem 1.15rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-surface);
    color: var(--fg-primary);
    text-decoration: none;
    box-shadow: var(--shadow-xs);
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  .docs-pager-link:hover {
    border-color: var(--accent);
    background: var(--bg-elevated);
    transform: translateY(-1px);
  }

  .docs-pager-link:hover .docs-pager-target,
  .docs-pager-link:hover .docs-pager-hint {
    color: var(--accent);
  }

  .docs-pager-next {
    text-align: end;
  }

  .docs-pager-hint {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.15s ease;
  }

  .docs-pager-target {
    color: var(--fg-primary);
    font-size: 0.9rem;
    font-weight: 600;
    transition: color 0.15s ease;
  }

  .docs-pager-placeholder {
    display: none;
  }

  @media (min-width: 40rem) {
    .docs-pager-placeholder {
      display: block;
    }
  }
</style>
