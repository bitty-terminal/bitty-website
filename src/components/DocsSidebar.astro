---
/**
 * Documentation sidebar navigation.
 * Clean left rail listing the 6 canonical sections and their documents, with a
 * collapse button in the rail header.
 */
import { getUiMessages, type SiteLocale } from "../lib/i18n.ts";
import { getManualNavGroups } from "../lib/manualDocs.ts";

type Props = {
  locale?: SiteLocale;
  currentSlug: string;
};

const { locale = "en", currentSlug } = Astro.props as Props;
const t = getUiMessages(locale);
const groups = getManualNavGroups(currentSlug, locale);
const docsPrefix = locale === "zh-CN" ? "/zh-CN/docs" : "/docs";
---

<details class="docs-nav-drawer" open>
  <summary>{t.sidebarToggle}</summary>
  <nav class="docs-sidebar" aria-label={t.sidebarAria}>
    <div class="docs-rail-head">
      <span class="docs-rail-head-title">{t.toggleLeftRail}</span>
      <button
        type="button"
        class="docs-rail-collapse-btn"
        data-toggle-rail="left"
        title={t.hideRailLabel}
      >
        <span aria-hidden="true">«</span>
        <span>{t.hideRailLabel}</span>
      </button>
    </div>
    <ul class="docs-nav-tree">
      {groups.map((group) => (
        <li class="docs-nav-group">
          <details class="docs-nav-group-details" open>
            <summary>{group.label}</summary>
            <ul>
              {group.entries.map((entry) => {
                const isActive =
                  entry.fullSlug === currentSlug ||
                  (currentSlug === "" && entry.order === 0);
                const href = `${docsPrefix}/${entry.fullSlug}/`;
                return (
                  <li class="docs-nav-entry">
                    <a
                      href={href}
                      aria-current={isActive ? "page" : undefined}
                      class={isActive ? "active" : undefined}
                    >
                      {entry.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          </details>
        </li>
      ))}
    </ul>
  </nav>
</details>

<script is:inline>
  const drawer = document.querySelector("details.docs-nav-drawer");
  const narrow = window.matchMedia("(max-width: 49.9375rem)");
  const syncDrawer = () => {
    if (drawer instanceof HTMLDetailsElement) {
      if (narrow.matches) {
        drawer.removeAttribute("open");
      } else {
        drawer.setAttribute("open", "");
      }
    }
  };
  syncDrawer();
  narrow.addEventListener("change", syncDrawer);
</script>

<style>
  .docs-nav-drawer {
    min-width: 0;
  }

  .docs-nav-drawer > summary {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch-target);
    padding: 0.4rem 0.8rem;
    margin-bottom: 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    cursor: pointer;
    color: var(--fg-primary);
    font-size: var(--text-xs);
    font-weight: 600;
    list-style: none;
    box-shadow: var(--shadow-xs);
  }

  .docs-nav-drawer > summary::-webkit-details-marker {
    display: none;
  }

  .docs-nav-drawer > summary::before {
    content: "\25B8";
    margin-inline-end: 0.45rem;
    color: var(--fg-muted);
    transition: transform 0.15s ease;
  }

  .docs-nav-drawer[open] > summary::before {
    transform: rotate(90deg);
  }

  .docs-rail-head {
    display: none;
  }

  @media (width >= 50rem) {
    .docs-nav-drawer > summary {
      display: none;
    }

    .docs-rail-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      margin-bottom: 0.65rem;
      padding: 0 0.25rem 0.45rem;
      border-bottom: 1px solid var(--line);
    }

    .docs-rail-head-title {
      color: var(--fg-muted);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .docs-rail-collapse-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.2rem;
      padding: 0.12rem 0.42rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-xs);
      background: var(--bg-surface);
      color: var(--fg-muted);
      font-family: var(--font-mono);
      font-size: 0.65rem;
      cursor: pointer;
      transition:
        border-color 0.14s ease,
        color 0.14s ease;
    }

    .docs-rail-collapse-btn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
  }

  .docs-sidebar {
    font-size: var(--text-xs);
    line-height: 1.45;
    padding-inline-end: 0.5rem;
  }

  .docs-nav-tree,
  .docs-nav-tree ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .docs-nav-group + .docs-nav-group {
    margin-top: 0.9rem;
  }

  .docs-nav-tree ul {
    margin: 0.25rem 0 0 0.25rem;
    padding-inline-start: 0.65rem;
    border-inline-start: 1px solid var(--line);
  }

  .docs-nav-group-details > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.25rem 0.35rem;
    border-radius: var(--radius-xs);
    cursor: pointer;
    color: var(--fg-primary);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    list-style: none;
    user-select: none;
  }

  .docs-nav-group-details > summary::-webkit-details-marker {
    display: none;
  }

  .docs-nav-group-details > summary:hover {
    color: var(--accent);
  }

  .docs-nav-group-details > summary::after {
    content: "\25B8";
    color: var(--fg-muted);
    font-size: 0.65rem;
    transition: transform 0.15s ease;
  }

  .docs-nav-group-details[open] > summary::after {
    transform: rotate(90deg);
  }

  .docs-sidebar li a {
    display: block;
    min-block-size: 1.9rem;
    align-content: center;
    padding: 0.24rem 0.6rem;
    margin-inline-start: -1px;
    border-inline-start: 2px solid transparent;
    color: var(--fg-secondary);
    font-size: 0.8rem;
    text-decoration: none;
    border-radius: 0 var(--radius-xs) var(--radius-xs) 0;
    transition:
      color 0.12s ease,
      background-color 0.12s ease,
      border-color 0.12s ease;
  }

  .docs-sidebar li a:hover {
    color: var(--fg-primary);
    background-color: var(--bg-elevated);
  }

  .docs-sidebar li a[aria-current="page"] {
    border-inline-start-color: var(--accent);
    color: var(--accent);
    background-color: var(--accent-soft);
    font-weight: 600;
  }
</style>
