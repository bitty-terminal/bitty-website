---
/**
 * Documentation sidebar navigation (CTX-0045, website#86): a nested
 * collapsible tree derived from route paths.
 *
 * Data source: the `docs` content collection filtered to
 * `website_publish: true` (LD-3), ordered by `sidebar_order` (then title).
 * Slugs reuse the authoritative route mapper (`../lib/docsRoutes.ts`,
 * RM-6); links preserve the current version segment (`latest`, `stable`,
 * or `x.y.z`), so the sidebar is version-aware without reimplementing
 * routing. Tree construction and display titles live in
 * `../lib/docsSidebar.ts` (unit-tested with `bun test src/lib`).
 *
 * Display titles strip machine prefixes (`ADR NNNN - `, `Finding NNNN - `)
 * and trailing ` RFC` suffixes AT RENDER TIME ONLY — canonical
 * frontmatter titles, slugs, links, and pages are unchanged (canonical
 * renames are a bitty-docs follow-up, not this issue).
 *
 * Progressive enhancement: folder nodes are native `<details>` groups
 * (keyboard reachable, no script), and the whole sidebar is a `<details>`
 * drawer that renders `open` — modern Chrome clips `::details-content`
 * regardless of the `display` override, so a CSS-forced desktop open does
 * not work. A tiny inline script (CTX-0047) collapses the drawer on
 * narrow viewports during parse, before first paint; without JS it stays
 * open everywhere (usable, never empty). The current document carries
 * `aria-current="page"`.
 */
import { getCollection } from "astro:content";
import { sep } from "node:path";
import { sourcePathToRouteIdentity } from "../lib/docsRoutes.ts";
import {
  buildSidebarTree,
  markCurrent,
  renderSidebarTree,
  type SidebarEntry,
} from "../lib/docsSidebar.ts";

type Props = {
  /** Raw version route segment, e.g. `latest`, `stable`, or `0.1.0`. */
  version: string;
  /** Canonical slug of the rendered page (`""` for the revision index). */
  currentSlug: string;
};

const { version, currentSlug } = Astro.props as Props;

function sourcePathFromFilePath(filePath: string, id: string): string {
  const posix = filePath.split(sep).join("/");
  const marker = "src/content/docs/";
  const index = posix.lastIndexOf(marker);
  if (index === -1) {
    throw new Error(
      `Docs entry "${id}" is outside src/content/docs: ${filePath}`,
    );
  }
  return posix.slice(index + marker.length);
}

function slugFromSourceFile(filePath: string | undefined, id: string): string {
  if (filePath === undefined || filePath.length === 0) {
    throw new Error(`Docs entry "${id}" has no filePath`);
  }
  const sourcePath = sourcePathFromFilePath(filePath, id);
  const identity = sourcePathToRouteIdentity(sourcePath);
  const withoutDocs = identity.routeWithoutVersion.slice("/docs/".length);
  return withoutDocs.endsWith("/") ? withoutDocs.slice(0, -1) : withoutDocs;
}

const eligible = (await getCollection("docs")).filter(
  (entry) => entry.data.website_publish === true,
);

const entries: SidebarEntry[] = eligible.map((entry) => ({
  slug: slugFromSourceFile(entry.filePath, entry.id),
  title: entry.data.title,
  order: entry.data.sidebar_order,
}));

const tree = markCurrent(buildSidebarTree(entries), currentSlug);
const treeHtml = renderSidebarTree(tree, version);
---

<details class="docs-nav-drawer" open>
  <summary>Browse documentation</summary>
  <nav class="docs-sidebar" aria-label="Documentation" set:html={treeHtml} />
</details>

<script is:inline>
  // CTX-0047: collapse the drawer on narrow viewports BEFORE first paint.
  // The drawer renders `open` so desktop (and no-JS) never shows an empty
  // sidebar; removing `open` from a deferred module script made the article
  // jump by the tree height after paint (Lighthouse CLS 0.202 on docs
  // pages), so this runs inline, during parse, and keeps the breakpoint
  // listener for later resizes. Scoped to this component instance.
  const drawer = document.querySelector("details.docs-nav-drawer");
  const narrow = window.matchMedia("(max-width: 49.9375rem)");
  const syncDrawer = () => {
    if (drawer instanceof HTMLDetailsElement && narrow.matches) {
      drawer.removeAttribute("open");
    }
  };
  syncDrawer();
  narrow.addEventListener("change", syncDrawer);
</script>

<style>
  .docs-nav-drawer {
    min-width: 0;
  }

  .docs-nav-drawer > summary {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch-target);
    cursor: pointer;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  /* `display: inline-flex` suppresses the native disclosure marker, so the
   * drawer toggle gets an explicit chevron (rotates when open). Without it
   * the summary reads as a dead heading on narrow viewports. */
  .docs-nav-drawer > summary::before {
    content: "\25B8";
    margin-inline-end: 0.375rem;
    color: var(--muted);
  }

  .docs-nav-drawer[open] > summary::before {
    transform: rotate(90deg);
  }

  .docs-sidebar {
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .docs-nav-tree,
  .docs-nav-tree ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .docs-nav-tree ul {
    margin: 0 0 0.5rem;
    padding-inline-start: 0.75rem;
    border-inline-start: 1px solid var(--line);
  }

  .docs-nav-sub > summary {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-block-size: 2rem;
    align-content: center;
    padding-block: 0.375rem;
    cursor: pointer;
    color: var(--ink);
    font-weight: 700;
  }

  .docs-nav-folder-label {
    display: block;
    min-block-size: 2rem;
    align-content: center;
    padding-block: 0.375rem;
    color: var(--ink);
    font-weight: 700;
  }

  .docs-sidebar li a {
    display: block;
    min-block-size: 2rem;
    align-content: center;
    padding-block: 0.25rem;
    padding-inline-start: 0.75rem;
    border-inline-start: 2px solid transparent;
    color: var(--muted);
    text-decoration: none;
  }

  .docs-sidebar li a:hover {
    color: var(--indigo-deep);
  }

  .docs-sidebar li a[aria-current="page"] {
    border-inline-start-color: var(--accent);
    color: var(--ink);
    font-weight: 700;
  }
</style>
