---
/**
 * Documentation sidebar navigation (CTX-0045, CTX-0050): two-layer
 * reader-intent navigation.
 *
 * Data source: the `docs` content collection, filtered by the shared
 * publication policy (`../lib/publicationPolicy.ts`, website#97) and mapped
 * through the shared entry derivation (`../lib/docsEntries.ts`), so the
 * sidebar, the breadcrumbs, and the previous/next pager all agree on the same
 * canonical slugs.
 *
 * Shape: the six reader-intent groups of `../lib/docsNavGroups.ts` are the
 * only top level, and each group renders exactly one flat list of page links
 * — route depth never adds a third level (website#96). A route that is both a
 * folder and a page is an ordinary entry labelled with its real page title,
 * replacing the previous fixed "Contents" disclosure. Grouping, ordering,
 * breadcrumbs, pager neighbours, and display titles all live in
 * `../lib/docsSidebar.ts` (unit-tested with `bun test src/lib`).
 *
 * Display titles strip machine prefixes (`ADR NNNN - `, `Finding NNNN - `)
 * and trailing ` RFC` suffixes AT RENDER TIME ONLY — canonical
 * frontmatter titles, slugs, links, and pages are unchanged (canonical
 * renames are a bitty-docs follow-up, not this issue).
 *
 * Progressive enhancement: group nodes are native `<details>` groups
 * (keyboard reachable, no script), and the whole sidebar is a `<details>`
 * drawer that renders `open` — modern Chrome clips `::details-content`
 * regardless of the `display` override, so a CSS-forced desktop open does
 * not work. A tiny inline script (CTX-0047) collapses the drawer on
 * narrow viewports during parse, before first paint; without JS it stays
 * open everywhere (usable, never empty). The current document carries
 * `aria-current="page"`.
 */
import { getCollection } from "astro:content";
import { sidebarEntriesFrom } from "../lib/docsEntries.ts";
import {
  buildNavGroups,
  renderSidebarTree,
  type SidebarEntry,
} from "../lib/docsSidebar.ts";

type Props = {
  /** Raw version route segment, e.g. `latest`, `stable`, or `0.1.0`. */
  version: string;
  /** Canonical slug of the rendered page (`""` for the revision index). */
  currentSlug: string;
};

const { version, currentSlug } = Astro.props as Props;

const entries: readonly SidebarEntry[] = sidebarEntriesFrom(
  await getCollection("docs"),
);

const groups = buildNavGroups(entries, currentSlug);
const treeHtml = renderSidebarTree(groups, version, currentSlug);
---

<details class="docs-nav-drawer" open>
  <summary>Browse documentation</summary>
  <div class="r2-sync-pill">
    <div class="r2-sync-row">
      <span class="r2-sync-tag">SOURCE BUCKET</span>
      <span class="r2-sync-status">
        <span class="r2-sync-dot"></span>
        R2 Live
      </span>
    </div>
    <div class="r2-sync-path">cdn.bitty.run/manual/{version}/...</div>
  </div>
  <nav class="docs-sidebar" aria-label="Documentation" set:html={treeHtml} />
</details>

<script is:inline>
  // CTX-0047: collapse the drawer on narrow viewports BEFORE first paint.
  // The drawer renders `open` so desktop (and no-JS) never shows an empty
  // sidebar; removing `open` from a deferred module script made the article
  // jump by the tree height after paint (Lighthouse CLS 0.202 on docs
  // pages), so this runs inline, during parse, and keeps the breakpoint
  // listener for later resizes. Scoped to this component instance.
  const drawer = document.querySelector("details.docs-nav-drawer");
  const narrow = window.matchMedia("(max-width: 49.9375rem)");
  const syncDrawer = () => {
    if (drawer instanceof HTMLDetailsElement && narrow.matches) {
      drawer.removeAttribute("open");
    }
  };
  syncDrawer();
  narrow.addEventListener("change", syncDrawer);
</script>

<style>
  .docs-nav-drawer {
    min-width: 0;
  }

  .docs-nav-drawer > summary {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch-target);
    cursor: pointer;
    color: var(--fg-primary);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  /* `display: inline-flex` suppresses the native disclosure marker, so the
   * drawer toggle gets an explicit chevron (rotates when open). Without it
   * the summary reads as a dead heading on narrow viewports. */
  .docs-nav-drawer > summary::before {
    content: "\25B8";
    margin-inline-end: 0.375rem;
    color: var(--fg-muted);
  }

  .docs-nav-drawer[open] > summary::before {
    transform: rotate(90deg);
  }

  .r2-sync-pill {
    margin-block: 0.5rem 1rem;
    padding: 0.625rem 0.75rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .r2-sync-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-end: 0.25rem;
  }

  .r2-sync-tag {
    color: var(--fg-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .r2-sync-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--accent-mint);
    font-weight: 600;
  }

  .r2-sync-dot {
    inline-size: 0.375rem;
    block-size: 0.375rem;
    border-radius: 50%;
    background: var(--accent-mint);
    box-shadow: 0 0 6px var(--accent-mint);
  }

  .r2-sync-path {
    color: var(--fg-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .docs-sidebar {
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .docs-nav-tree,
  .docs-nav-tree ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .docs-nav-tree ul {
    margin: 0 0 0.5rem;
    padding-inline-start: 0.75rem;
    border-inline-start: 1px solid var(--border-subtle);
  }

  .docs-nav-group-details > summary {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-block-size: 2rem;
    align-content: center;
    padding-block: 0.375rem;
    cursor: pointer;
    color: var(--fg-primary);
    font-weight: 700;
  }

  .docs-sidebar li a {
    display: block;
    min-block-size: 2rem;
    align-content: center;
    padding-block: 0.25rem;
    padding-inline-start: 0.75rem;
    border-inline-start: 2px solid transparent;
    color: var(--fg-secondary);
    text-decoration: none;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .docs-sidebar li a:hover {
    color: var(--accent);
    background-color: var(--bg-elevated);
  }

  .docs-sidebar li a[aria-current="page"] {
    border-inline-start-color: var(--accent);
    color: var(--fg-primary);
    background-color: var(--accent-soft);
    font-weight: 700;
  }
</style>
