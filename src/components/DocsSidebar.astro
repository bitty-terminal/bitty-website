---
/**
 * Documentation sidebar navigation.
 * Renders the 6 canonical categories and 41 items from bitty-manual.
 */
import { getManualNavGroups } from "../lib/manualDocs.ts";

type Props = {
  /** Raw version route segment, e.g. `latest`, `stable`, or `0.1.0`. */
  version: string;
  /** Canonical slug of the rendered page (`""` for the revision index). */
  currentSlug: string;
};

const { version, currentSlug } = Astro.props as Props;
const groups = getManualNavGroups(currentSlug, version);
---

<details class="docs-nav-drawer" open>
  <summary>Browse documentation</summary>
  <div class="r2-sync-pill">
    <div class="r2-sync-row">
      <span class="r2-sync-tag">SOURCE BUCKET</span>
      <span class="r2-sync-status">
        <span class="r2-sync-dot"></span>
        R2 Live
      </span>
    </div>
    <div class="r2-sync-path">
      cdn.bitty.run/manual/bitty-manual/{version}/...
    </div>
  </div>
  <nav class="docs-sidebar" aria-label="Documentation">
    <ul class="docs-nav-tree">
      {groups.map((group) => (
        <li class="docs-nav-group">
          <details
            class="docs-nav-group-details"
            open={group.isCurrent || group.id === "getting-started"}
          >
            <summary>{group.label}</summary>
            <ul>
              {group.entries.map((entry) => {
                const isActive =
                  entry.fullSlug === currentSlug ||
                  (currentSlug === "" && entry.order === 0);
                const href = `/docs/${version}/${entry.fullSlug}/`;
                return (
                  <li class="docs-nav-entry">
                    <a
                      href={href}
                      aria-current={isActive ? "page" : undefined}
                      class={isActive ? "active" : undefined}
                    >
                      {entry.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          </details>
        </li>
      ))}
    </ul>
  </nav>
</details>

<script is:inline>
  // CTX-0047: collapse the drawer on narrow viewports BEFORE first paint.
  const drawer = document.querySelector("details.docs-nav-drawer");
  const narrow = window.matchMedia("(max-width: 49.9375rem)");
  const syncDrawer = () => {
    if (drawer instanceof HTMLDetailsElement) {
      if (narrow.matches) {
        drawer.removeAttribute("open");
      } else {
        drawer.setAttribute("open", "");
      }
    }
  };
  syncDrawer();
  narrow.addEventListener("change", syncDrawer);
</script>

<style>
  .docs-nav-drawer {
    min-width: 0;
  }

  .docs-nav-drawer > summary {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch-target);
    cursor: pointer;
    color: var(--fg-primary);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .docs-nav-drawer > summary::before {
    content: "\25B8";
    margin-inline-end: 0.375rem;
    color: var(--fg-muted);
  }

  .docs-nav-drawer[open] > summary::before {
    transform: rotate(90deg);
  }

  .r2-sync-pill {
    margin-block: 0.5rem 1rem;
    padding: 0.625rem 0.75rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .r2-sync-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-end: 0.25rem;
  }

  .r2-sync-tag {
    color: var(--fg-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .r2-sync-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--accent-mint);
    font-weight: 600;
  }

  .r2-sync-dot {
    inline-size: 0.375rem;
    block-size: 0.375rem;
    border-radius: 50%;
    background: var(--accent-mint);
    box-shadow: 0 0 6px var(--accent-mint);
  }

  .r2-sync-path {
    color: var(--fg-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .docs-sidebar {
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .docs-nav-tree,
  .docs-nav-tree ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .docs-nav-tree ul {
    margin: 0 0 0.5rem;
    padding-inline-start: 0.75rem;
    border-inline-start: 1px solid var(--border-subtle);
  }

  .docs-nav-group-details > summary {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-block-size: 2rem;
    align-content: center;
    padding-block: 0.375rem;
    cursor: pointer;
    color: var(--fg-primary);
    font-weight: 700;
  }

  .docs-sidebar li a {
    display: block;
    min-block-size: 2rem;
    align-content: center;
    padding-block: 0.25rem;
    padding-inline-start: 0.75rem;
    border-inline-start: 2px solid transparent;
    color: var(--fg-secondary);
    text-decoration: none;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .docs-sidebar li a:hover {
    color: var(--accent);
    background-color: var(--bg-elevated);
  }

  .docs-sidebar li a[aria-current="page"] {
    border-inline-start-color: var(--accent);
    color: var(--fg-primary);
    background-color: var(--accent-soft);
    font-weight: 700;
  }
</style>
