---
/**
 * Per-article table of contents (CTX-0039, CTX-0050): the H2/H3 headings of
 * the rendered article as plain anchor links.
 *
 * Data source: the `headings` returned by Astro's `render(entry)` — the same
 * pipeline that emits the article's heading ids, so links match by
 * construction. The list is fully usable with JavaScript disabled; the
 * inline script only highlights the section in view via
 * IntersectionObserver and never owns routing or content.
 *
 * Placement (website#91): one `<nav>`, rendered between the article header
 * and the article body, so a narrow-viewport reader finds section navigation
 * directly under the title instead of at the end of the article. Below the
 * 70rem layout breakpoint it is a `<details>` disclosure that a tiny script
 * collapses (the same pattern as the sidebar drawer); from 70rem
 * `global.css` lifts it out of the article column into the sticky third
 * column and this component swaps the disclosure summary for the inline
 * "On this page" label. One `<nav>`, one set of heading anchors: nothing is
 * duplicated, so an anchor can never appear twice on the page.
 */
type TocHeading = {
  readonly depth: number;
  readonly slug: string;
  readonly text: string;
};

type Props = {
  headings: readonly TocHeading[];
};

const { headings } = Astro.props as Props;
const items = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
---

{items.length > 0 && (
  <details class="docs-toc" open>
    <summary>On this page</summary>
    <nav class="docs-toc-nav" aria-label="On this page">
      <p class="docs-toc-title">On this page</p>
      <ul>
        {items.map((item) => (
          <li data-depth={item.depth}>
            <a href={`#${item.slug}`}>{item.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  </details>
)}

<script>
  // CTX-0050: keep the disclosure collapsed on narrow viewports, where the
  // TOC sits under the article title, and open (summary hidden by CSS) from
  // the 70rem layout where it is the sticky right rail. Runs on breakpoint
  // changes too, so a resize never leaves the rail hidden behind a summary
  // that is display:none. Scoped to this component instance.
  const toc = document.querySelector("details.docs-toc");
  const narrow = window.matchMedia("(max-width: 69.9375rem)");
  const syncToc = () => {
    if (toc instanceof HTMLDetailsElement) {
      toc.open = !narrow.matches;
    }
  };
  syncToc();
  narrow.addEventListener("change", syncToc);
</script>

<script>
  // Progressive enhancement only: the server-rendered anchor links already
  // navigate. Highlight the link whose heading is in view; without
  // IntersectionObserver (or without JS) the TOC stays a plain link list.
  const tocRoot = document.querySelector(".docs-toc");
  if (tocRoot && "IntersectionObserver" in window) {
    const links = new Map<string, HTMLAnchorElement>();
    for (const anchor of tocRoot.querySelectorAll<HTMLAnchorElement>(
      'a[href^="#"]',
    )) {
      const id = decodeURIComponent(
        anchor.getAttribute("href")?.slice(1) ?? "",
      );
      if (id.length > 0 && !links.has(id)) {
        links.set(id, anchor);
      }
    }
    if (links.size > 0) {
      const clear = (): void => {
        for (const anchor of tocRoot.querySelectorAll(
          'a[aria-current="true"]',
        )) {
          anchor.removeAttribute("aria-current");
        }
      };
      const observer = new IntersectionObserver(
        (observed) => {
          for (const entry of observed) {
            if (!entry.isIntersecting) continue;
            const link = links.get(entry.target.id);
            if (link) {
              clear();
              link.setAttribute("aria-current", "true");
            }
          }
        },
        { rootMargin: "-15% 0px -70% 0px" },
      );
      for (const id of links.keys()) {
        const heading = document.getElementById(id);
        if (heading) observer.observe(heading);
      }
    }
  }
</script>

<style>
  .docs-toc {
    min-width: 0;
    margin-block-end: 2.5rem;
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  /* Narrow viewports: the summary is the section toggle, so it carries the
   * "On this page" label and the inline title is hidden. */
  .docs-toc > summary {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch-target);
    cursor: pointer;
    color: var(--ink);
    font-weight: 700;
  }

  .docs-toc > summary::before {
    content: "\25B8";
    margin-inline-end: 0.375rem;
    color: var(--muted);
  }

  .docs-toc[open] > summary::before {
    transform: rotate(90deg);
  }

  .docs-toc-title {
    display: none;
  }

  .docs-toc-nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .docs-toc-nav li[data-depth="3"] a {
    padding-inline-start: 0.75rem;
  }

  .docs-toc-nav a {
    display: block;
    min-block-size: 2rem;
    align-content: center;
    padding-block: 0.25rem;
    border-inline-start: 2px solid transparent;
    color: var(--muted);
    text-decoration: none;
  }

  .docs-toc-nav a:hover {
    color: var(--indigo-deep);
  }

  .docs-toc-nav a[aria-current="true"] {
    border-inline-start-color: var(--accent);
    color: var(--ink);
    font-weight: 700;
  }

  /* Wide viewports: the TOC is the sticky right rail and CSS keeps the
   * disclosure open, so the summary is gone and the inline label returns. */
  @media (width >= 70rem) {
    .docs-toc > summary {
      display: none;
    }

    .docs-toc-title {
      display: block;
      margin-block-end: 0.5rem;
      color: var(--ink);
      font-weight: 700;
    }
  }
</style>
