---
/**
 * Per-article table of contents (CTX-0039, CTX-0050): the H2/H3 headings of
 * the rendered article as plain anchor links in the right column, with a
 * collapse button to hide the right TOC rail.
 */
import { getUiMessages, type SiteLocale } from "../lib/i18n.ts";

type TocHeading = {
  readonly depth: number;
  readonly slug: string;
  readonly text: string;
};

type Props = {
  headings: readonly TocHeading[];
  locale?: SiteLocale;
};

const { headings, locale = "en" } = Astro.props as Props;
const t = getUiMessages(locale);
const items = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
---

{items.length > 0 && (
  <details class="docs-toc" open>
    <summary>{t.tocSummary}</summary>
    <nav class="docs-toc-nav" aria-label={t.tocSummary}>
      <div class="docs-toc-head">
        <p class="docs-toc-title">{t.tocSummary}</p>
        <button
          type="button"
          class="docs-rail-collapse-btn"
          data-toggle-rail="right"
          title={t.hideRailLabel}
        >
          <span>{t.hideRailLabel}</span>
          <span aria-hidden="true">»</span>
        </button>
      </div>
      <ul>
        {items.map((item) => (
          <li data-depth={item.depth}>
            <a href={`#${item.slug}`}>{item.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  </details>
)}

<script>
  const toc = document.querySelector("details.docs-toc");
  const narrow = window.matchMedia("(max-width: 49.9375rem)");
  const syncToc = () => {
    if (toc instanceof HTMLDetailsElement) {
      toc.open = !narrow.matches;
    }
  };
  syncToc();
  narrow.addEventListener("change", syncToc);
</script>

<script>
  const tocRoot = document.querySelector(".docs-toc");
  if (tocRoot && "IntersectionObserver" in window) {
    const links = new Map<string, HTMLAnchorElement>();
    for (const anchor of tocRoot.querySelectorAll<HTMLAnchorElement>(
      'a[href^="#"]',
    )) {
      const id = decodeURIComponent(
        anchor.getAttribute("href")?.slice(1) ?? "",
      );
      if (id.length > 0 && !links.has(id)) {
        links.set(id, anchor);
      }
    }
    if (links.size > 0) {
      const clear = (): void => {
        for (const anchor of tocRoot.querySelectorAll(
          'a[aria-current="true"]',
        )) {
          anchor.removeAttribute("aria-current");
        }
      };
      const observer = new IntersectionObserver(
        (observed) => {
          for (const entry of observed) {
            if (!entry.isIntersecting) continue;
            const link = links.get(entry.target.id);
            if (link) {
              clear();
              link.setAttribute("aria-current", "true");
            }
          }
        },
        { rootMargin: "-12% 0px -72% 0px" },
      );
      for (const id of links.keys()) {
        const heading = document.getElementById(id);
        if (heading) observer.observe(heading);
      }
    }
  }
</script>

<style>
  .docs-toc {
    min-width: 0;
    margin-block-end: 1.25rem;
    font-size: var(--text-xs);
    line-height: 1.45;
  }

  .docs-toc > summary {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch-target);
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    cursor: pointer;
    color: var(--fg-primary);
    font-size: var(--text-xs);
    font-weight: 600;
    list-style: none;
    box-shadow: var(--shadow-xs);
  }

  .docs-toc > summary::-webkit-details-marker {
    display: none;
  }

  .docs-toc > summary::before {
    content: "\25B8";
    margin-inline-end: 0.4rem;
    color: var(--fg-muted);
    transition: transform 0.15s ease;
  }

  .docs-toc[open] > summary::before {
    transform: rotate(90deg);
  }

  .docs-toc-head {
    display: none;
  }

  .docs-toc-nav ul {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    border-inline-start: 1px solid var(--line);
  }

  .docs-toc-nav li[data-depth="3"] a {
    padding-inline-start: 1.2rem;
    font-size: 0.73rem;
  }

  .docs-toc-nav a {
    display: block;
    min-block-size: 1.7rem;
    align-content: center;
    padding: 0.2rem 0.45rem 0.2rem 0.7rem;
    margin-inline-start: -1px;
    border-inline-start: 2px solid transparent;
    color: var(--fg-muted);
    text-decoration: none;
    font-size: 0.76rem;
    transition:
      color 0.14s ease,
      border-color 0.14s ease;
  }

  .docs-toc-nav a:hover {
    color: var(--fg-primary);
  }

  .docs-toc-nav a[aria-current="true"] {
    border-inline-start-color: var(--accent);
    color: var(--accent);
    font-weight: 600;
  }

  @media (width >= 50rem) {
    .docs-toc {
      margin-block-end: 0;
    }

    .docs-toc > summary {
      display: none;
    }

    .docs-toc-nav ul {
      margin-top: 0;
    }

    .docs-toc-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      margin: 0 0 0.6rem;
      padding-bottom: 0.45rem;
      border-bottom: 1px solid var(--line);
    }

    .docs-toc-title {
      margin: 0;
      color: var(--fg-primary);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: -0.01em;
    }
  }
</style>
