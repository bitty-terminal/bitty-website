---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteSidebar from "./SiteSidebar.astro";
import { getUiMessages, localePath, type SiteLocale } from "../lib/i18n.ts";

const locale = (Astro.props as { locale?: SiteLocale }).locale ?? "en";
const isZh = locale === "zh-CN";
const t = getUiMessages(locale);

const currentPath = localePath(locale, "/");
const alternatePath = localePath(isZh ? "en" : "zh-CN", "/");
const quickstartHref = localePath(locale, "/docs/getting-started/quickstart/");
const configHref = localePath(locale, "/docs/configuration/overview/");
const pluginsHref = localePath(locale, "/plugins/");
const aiHref = localePath(locale, "/ai/");
const manualHref = localePath(locale, "/docs/");

const pageTitle = isZh
  ? "Bitty — 现代可编程终端工作区"
  : "Bitty — Programmable Terminal Workspace";
const pageDescription = t.heroSubtitle;
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  currentPath={currentPath}
  alternatePath={alternatePath}
  xDefaultPath="/"
>
  <SiteHeader
    locale={locale}
    activeNav="hero"
    alternateHref={alternatePath}
    currentPath={currentPath}
  />
  <SiteSidebar locale={locale} activeSection="home" />

  <main id="main-content" class="niri-main" tabindex="-1">
    <article class="niri-prose">
      <h1>bitty</h1>

      {
        isZh ? (
          <>
            <p>
              <strong>bitty</strong> 是一个基于 Rust 与 <code>wgpu</code>{" "}
              构建的 GPU 加速终端工作区，在 Linux、macOS 与 Windows
              上提供低延迟帧渲染与确定性终端状态机。
            </p>
            <p>
              工作区内置类似 Hyprland 的 Dwindle
              平铺分屏、原生标签页与可组合状态栏，并搭载无栈 Phodopus Lua 5.4
              沙箱引擎——通过 <code>bitty-plugin.toml</code>{" "}
              显式声明能力授权，零默认权限、零 VM 延迟激活。
            </p>
            <p>
              针对 AI 辅助开发，bitty 通过零信任本地守护进程{" "}
              <code>bittyd</code> 与 <code>wheel</code>{" "}
              智能体套件隔离凭据与高风险执行操作，所有变更均需经过跨进程审批队列确认。
            </p>
          </>
        ) : (
          <>
            <p>
              <strong>bitty</strong> is a GPU-accelerated terminal workspace
              written in Rust with a low-latency <code>wgpu</code> frame
              pipeline and deterministic terminal state across Linux, macOS, and
              Windows.
            </p>
            <p>
              It combines Hyprland-like Dwindle tiling, native splits and tabs,
              and a sandboxed Phodopus Lua 5.4 plugin runtime with explicit{" "}
              <code>bitty-plugin.toml</code> capability grants and zero-VM lazy
              activation.
            </p>
            <p>
              For AI workflows, bitty enforces a zero-trust boundary via the{" "}
              <code>bittyd</code> local daemon and the <code>wheel</code> agent
              harness, keeping credentials out of the terminal core and staging
              mutations behind an explicit approval queue.
            </p>
          </>
        )
      }

      <h2 id="install">{isZh ? "快速安装" : "Quick Install"}</h2>
      <p>
        {
          isZh
            ? "通过官方安装脚本或 Arch AUR 安装最新稳定版本："
            : "Install the latest release with the installer script or from the Arch AUR:"
        }
      </p>
      <pre><code>curl -fsSL https://cdn.bitty.run/install.sh | sh
paru -S bitty-bin</code></pre>
      <p>
        {isZh ? "更多平台与包管理器请见 " : "See "}
        <a
          href="https://github.com/bitty-terminal/bitty/blob/main/packaging/INSTALL.md"
          target="_blank"
          rel="noopener noreferrer"
        >
          packaging/INSTALL.md
        </a>
        {isZh ? " 与 " : " and "}
        <a
          href="https://cdn.bitty.run/install/latest.txt"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.installPointer}
        </a>
        {isZh ? "。" : "."}
      </p>

      <h2>{isZh ? "文档与生态" : "Documentation"}</h2>
      <ul>
        <li>
          <a href={quickstartHref}>
            {isZh ? "快速开始" : "Getting Started"}
          </a>
          {isZh
            ? " — 安装、首次启动与基本快捷键"
            : " — installation, first launch, and keybindings"}
        </li>
        <li>
          <a href={configHref}>
            {isZh ? "配置参考" : "Configuration"}
          </a>
          {isZh
            ? " — 主题、分屏布局、动作目录与插件配置"
            : " — themes, workspaces, actions, and plugin settings"}
        </li>
        <li>
          <a href={pluginsHref}>{isZh ? "插件与扩展" : "Plugins"}</a>
          {isZh
            ? " — L1 原生 Rust 扩展与 13 款官方 Lua 插件"
            : " — L1 native Rust extensions and 13 official Lua plugins"}
        </li>
        <li>
          <a href={aiHref}>{isZh ? "Bitty AI 与 Wheel" : "AI"}</a>
          {isZh
            ? " — 零信任进程边界、审批队列与命令面板集成"
            : " — zero-trust process boundary, approval queue, and CLI"}
        </li>
        <li>
          <a href={manualHref}>{isZh ? "完整手册目录" : "Full Manual"}</a>
          {isZh
            ? " — 浏览全部 6 个章节文档"
            : " — browse all 6 manual sections"}
        </li>
      </ul>
    </article>
  </main>

  <SiteFooter locale={locale} />
</BaseLayout>
