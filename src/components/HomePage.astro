---
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import { packageChannels, primaryChannels } from "../data/installChannels.ts";
import { getUiMessages, localePath, type SiteLocale } from "../lib/i18n.ts";
import "../styles/global.css";

const locale = (Astro.props as { locale?: SiteLocale }).locale ?? "en";
const isZh = locale === "zh-CN";
const t = getUiMessages(locale);
const allInstallTabs = [...primaryChannels, ...packageChannels];

const shortTabLabel = (id: string, fallback: string): string => {
  const map: Record<string, { en: string; "zh-CN": string }> = {
    "unix-installer": { en: "Linux / macOS", "zh-CN": "Linux / macOS" },
    "windows-installer": { en: "Windows", "zh-CN": "Windows" },
    source: { en: "Cargo", "zh-CN": "Cargo" },
    apt: { en: "Debian / Ubuntu", "zh-CN": "Debian / Ubuntu" },
    copr: { en: "Fedora / RHEL", "zh-CN": "Fedora / RHEL" },
    aur: { en: "Arch", "zh-CN": "Arch" },
    alpine: { en: "Alpine", "zh-CN": "Alpine" },
    nix: { en: "Nix", "zh-CN": "Nix" },
    homebrew: { en: "Homebrew", "zh-CN": "Homebrew" },
    scoop: { en: "Scoop", "zh-CN": "Scoop" },
    appimage: { en: "AppImage", "zh-CN": "AppImage" },
  };
  return map[id]?.[locale] ?? fallback;
};

const docsHref = localePath(locale, "/docs/getting-started/quickstart/");
const pluginsHref = localePath(locale, "/plugins/");
const aiHref = localePath(locale, "/ai/");
const alternateHref = isZh ? "/" : "/zh-CN/";
const pageTitle = isZh
  ? "bitty — 现代可编程终端工作区"
  : "bitty — Programmable Terminal Workspace";
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.heroSubtitle} />
    <link rel="canonical" href={`https://bitty.run${isZh ? "/zh-CN/" : "/"}`} />
    <link rel="alternate" hreflang="en" href="https://bitty.run/" />
    <link rel="alternate" hreflang="zh-CN" href="https://bitty.run/zh-CN/" />
    <link rel="alternate" hreflang="x-default" href="https://bitty.run/" />
    <link rel="icon" type="image/x-icon" href="/icons/favicon.ico" />
    <title>{pageTitle}</title>
    <script is:inline>
      try {
        const stored = window.localStorage.getItem("bitty-theme");
        if (stored === "dark" || stored === "light") {
          document.documentElement.setAttribute("data-theme", stored);
        }
      } catch {}
    </script>
  </head>
  <body class="site-body">
    <a href="#main-content" class="skip-link">
      {t.skipToContent}
    </a>
    <SiteHeader
      locale={locale}
      activeNav="hero"
      alternateHref={alternateHref}
    />

    <main id="main-content" class="minimal-main" tabindex="-1">
      <section class="minimal-intro" aria-labelledby="home-title">
        <h1 id="home-title">bitty</h1>
        <p class="minimal-lead">
          {
            isZh
              ? "基于 Rust 与低延迟 wgpu 渲染管线构建的 GPU 加速可编程终端工作区。内置 Hyprland 风格原生分屏与标签页、沙箱化 Phodopus Lua 5.4 插件，以及基于 bittyd 与 wheel 的进程隔离 AI 能力。"
              : "A GPU-accelerated, programmable terminal workspace built in Rust on a low-latency wgpu frame pipeline. Features Hyprland-style native tiling and tabs, sandboxed Phodopus Lua 5.4 plugins, and out-of-process AI via bittyd and wheel."
          }
        </p>

        <nav class="quick-links" aria-label={isZh ? "快速入口" : "Quick links"}>
          <a href={docsHref}>{isZh ? "快速开始" : "Getting started"}</a>
          <span aria-hidden="true">·</span>
          <a href="#install">{isZh ? "安装方式" : "Installation"}</a>
          <span aria-hidden="true">·</span>
          <a href={pluginsHref}>{isZh ? "插件与扩展" : "Plugins"}</a>
          <span aria-hidden="true">·</span>
          <a href={aiHref}>{isZh ? "AI 与 Wheel" : "AI & Wheel"}</a>
        </nav>
      </section>

      <section
        id="install"
        class="install-section"
        aria-labelledby="install-title"
      >
        <div class="section-header-bar">
          <h2 id="install-title">{t.installTitle}</h2>
          <div class="section-meta-links">
            <a
              href="https://cdn.bitty.run/install/latest.txt"
              target="_blank"
              rel="noopener noreferrer"
              class="meta-link"
            >
              {t.installPointer} ↗
            </a>
            <a
              href="https://github.com/bitty-terminal/bitty/blob/main/packaging/INSTALL.md"
              target="_blank"
              rel="noopener noreferrer"
              class="meta-link"
            >
              {t.installPackaging} ↗
            </a>
          </div>
        </div>

        <div class="install-dock">
          <div
            class="install-dock-tabs"
            role="tablist"
            aria-label={t.installTitle}
          >
            {allInstallTabs.map((channel, index) => (
              <button
                type="button"
                role="tab"
                id={`install-tab-${channel.id}`}
                aria-controls={`install-pane-${channel.id}`}
                aria-selected={index === 0 ? "true" : "false"}
                tabindex={index === 0 ? 0 : -1}
                class:list={["dock-tab", { "is-active": index === 0 }]}
                data-install-tab={channel.id}
              >
                {shortTabLabel(channel.id, channel.name[locale])}
              </button>
            ))}
          </div>

          <div class="install-dock-panes">
            {allInstallTabs.map((channel, index) => (
              <div
                class="install-dock-pane"
                id={`install-pane-${channel.id}`}
                role="tabpanel"
                aria-labelledby={`install-tab-${channel.id}`}
                tabindex="0"
                data-install-pane={channel.id}
                hidden={index !== 0}
              >
                <div class="dock-pane-meta">
                  <div>
                    <h3>{channel.name[locale]}</h3>
                    <p class="dock-pane-summary">{channel.summary[locale]}</p>
                  </div>
                  <span class="arch-chip">{channel.arch}</span>
                </div>
                <div class="command-stack">
                  {channel.commands.map((command) => (
                    <div class="command-entry">
                      {command.label && (
                        <p class="command-label">{command.label[locale]}</p>
                      )}
                      <div class="command-block">
                        <code>{command.code}</code>
                        <button
                          type="button"
                          data-copy={command.code}
                          aria-label={`${t.copy}: ${channel.name[locale]}`}
                        >
                          {t.copy}
                        </button>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <hr class="minimal-rule" />

      <section class="minimal-note" aria-labelledby="contribute-title">
        <h2 id="contribute-title">{isZh ? "源码与贡献" : "Source & Contributing"}</h2>
        <p>
          {
            isZh
              ? "Bitty 为开源项目，源码与问题追踪托管在 GitHub："
              : "Bitty is open source. Source code, issue tracking, and documentation live on GitHub:"
          }
          {" "}
          <a
            href="https://github.com/bitty-terminal/bitty"
            target="_blank"
            rel="noopener noreferrer"
          >
            bitty-terminal/bitty
          </a>
          {" · "}
          <a
            href="https://github.com/bitty-terminal/bitty-manual"
            target="_blank"
            rel="noopener noreferrer"
          >
            bitty-terminal/bitty-manual
          </a>
        </p>
      </section>
    </main>

    <SiteFooter locale={locale} />

    <script
      define:vars={{
        copiedMessage: t.copied,
        copyFailedMessage: t.copyFailed,
      }}
    >
      const copied = copiedMessage;
      const copyFailed = copyFailedMessage;
      for (const element of document.querySelectorAll("[data-copy]")) {
        if (!(element instanceof HTMLButtonElement)) continue;
        const button = element;
        const original = button.textContent ?? "Copy";
        button.addEventListener("click", async () => {
          const command = button.dataset.copy ?? "";
          try {
            await navigator.clipboard.writeText(command);
            button.textContent = copied;
            button.dataset.copiedState = "true";
            window.setTimeout(() => {
              button.textContent = original;
              delete button.dataset.copiedState;
            }, 1500);
          } catch {
            button.textContent = copyFailed;
          }
        });
      }

      const installTabs = [...document.querySelectorAll("[data-install-tab]")];
      const installPanes = document.querySelectorAll("[data-install-pane]");
      const activateInstallTab = (tab, focus = false) => {
        const target = tab.dataset.installTab;
        for (const item of installTabs) {
          if (!(item instanceof HTMLButtonElement)) continue;
          const active = item === tab;
          item.classList.toggle("is-active", active);
          item.setAttribute("aria-selected", String(active));
          item.tabIndex = active ? 0 : -1;
        }
        for (const pane of installPanes) {
          if (!(pane instanceof HTMLElement)) continue;
          pane.hidden = pane.dataset.installPane !== target;
        }
        if (focus && tab instanceof HTMLButtonElement) tab.focus();
      };
      for (const tab of installTabs) {
        if (!(tab instanceof HTMLButtonElement)) continue;
        tab.addEventListener("click", () => activateInstallTab(tab));
        tab.addEventListener("keydown", (event) => {
          if (
            event.key !== "ArrowLeft" &&
            event.key !== "ArrowRight" &&
            event.key !== "Home" &&
            event.key !== "End"
          ) {
            return;
          }
          event.preventDefault();
          const buttons = installTabs.filter(
            (item) => item instanceof HTMLButtonElement,
          );
          const index = buttons.indexOf(tab);
          let next = index;
          if (event.key === "ArrowLeft") {
            next = (index - 1 + buttons.length) % buttons.length;
          } else if (event.key === "ArrowRight") {
            next = (index + 1) % buttons.length;
          } else if (event.key === "Home") {
            next = 0;
          } else if (event.key === "End") {
            next = buttons.length - 1;
          }
          activateInstallTab(buttons[next], true);
        });
      }
    </script>
  </body>
</html>

<style>
  .site-body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--bg-canvas);
    color: var(--ink);
  }

  .minimal-main {
    flex: 1 0 auto;
    width: min(48rem, calc(100% - 2rem));
    margin-inline: auto;
    padding-block: 3rem 4.5rem;
  }

  .minimal-intro h1 {
    margin: 0 0 0.9rem;
    font-family: var(--font-mono);
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .minimal-lead {
    margin: 0 0 1.4rem;
    color: var(--fg-secondary);
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .quick-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.75rem;
    margin-bottom: 2.75rem;
    font-size: 0.92rem;
  }

  .quick-links a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }

  .quick-links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .quick-links span[aria-hidden="true"] {
    color: var(--fg-muted);
  }

  .install-section {
    scroll-margin-top: 4.5rem;
  }

  .section-header-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.85rem;
  }

  .section-header-bar h2 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .section-meta-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .meta-link {
    color: var(--fg-secondary);
    text-decoration: none;
  }

  .meta-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .install-dock {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    overflow: hidden;
  }

  .install-dock-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.55rem 0.65rem;
    border-bottom: 1px solid var(--line);
    background: var(--bg-elevated);
  }

  .dock-tab {
    min-block-size: 2rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid transparent;
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--fg-secondary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
  }

  .dock-tab:hover {
    color: var(--ink);
  }

  .dock-tab.is-active {
    background: var(--bg-surface);
    border-color: var(--line);
    color: var(--ink);
    font-weight: 600;
  }

  .install-dock-pane {
    padding: 1rem 1.15rem;
  }

  .dock-pane-meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }

  .dock-pane-meta h3 {
    margin: 0 0 0.2rem;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .dock-pane-summary {
    margin: 0;
    color: var(--fg-secondary);
    font-size: 0.84rem;
  }

  .arch-chip {
    flex-shrink: 0;
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .command-stack {
    display: grid;
    gap: 0.7rem;
  }

  .command-label {
    margin: 0 0 0.25rem;
    color: var(--fg-muted);
    font-size: 0.78rem;
  }

  .command-block {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg-canvas);
  }

  .command-block code {
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink);
    white-space: nowrap;
  }

  .command-block button {
    flex-shrink: 0;
    min-block-size: 1.9rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    background: var(--bg-surface);
    color: var(--fg-secondary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    cursor: pointer;
  }

  .command-block button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .minimal-rule {
    margin-block: 2.5rem;
    border: 0;
    border-top: 1px solid var(--line);
  }

  .minimal-note h2 {
    margin: 0 0 0.45rem;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .minimal-note p {
    margin: 0;
    color: var(--fg-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .minimal-note a {
    color: var(--accent);
    text-decoration: none;
  }

  .minimal-note a:hover {
    text-decoration: underline;
  }
</style>
