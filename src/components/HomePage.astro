---
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import {
  packageChannels,
  pendingChannels,
  primaryChannels,
  RELEASE_POINTER,
} from "../data/installChannels.ts";
import { getExtensionCatalog } from "../lib/extensionCatalog.ts";
import "../styles/global.css";

type Locale = "en" | "zh-CN";
const locale = (Astro.props as { locale?: Locale }).locale ?? "en";
const isZh = locale === "zh-CN";
const extensions = getExtensionCatalog(locale);
const graphicsVersion =
  extensions.native.find((extension) => extension.slug === "graphics")
    ?.version ?? null;
const copy = {
  badge: isZh
    ? "GPU 渲染 · Rust 核心 · Lua 扩展"
    : "GPU-RENDERED · RUST CORE · LUA EXTENSIONS",
  title: isZh
    ? "为长期生活在 Shell 中的人打造的可编程终端工作区。"
    : "A programmable terminal workspace for people who live in the shell.",
  description: isZh
    ? "Bitty 将高性能终端核心、多面板工作区和明确授权的 Lua 扩展组合成一个专注的桌面应用。"
    : "Bitty combines a fast terminal core, multi-pane workspaces, and explicit Lua extensions in one focused desktop application.",
  install: isZh ? "安装 Bitty" : "Install Bitty",
  docs: isZh ? "阅读手册" : "Read the manual",
  extensionsAction: isZh ? "扩展体系" : "Extensions",
  release: isZh
    ? "预发布阶段 · R2 发行渠道"
    : "Pre-alpha · R2-backed release channel",
  installTitle: isZh ? "选择安装方式" : "Choose your path",
  installDescription: isZh
    ? "安装脚本、发行版仓库与包管理器渠道并列如下。每个可用条目都已发布并可安装；未发布的渠道会明确标注。"
    : "Install scripts, distribution repositories, and package managers side by side. Every available entry is published and installable; unpublished channels are labeled explicitly.",
  packageTitle: isZh ? "包管理器渠道" : "Package managers",
  pendingTitle: isZh ? "尚未发布" : "Not yet published",
  available: isZh ? "现在可用" : "Available",
  comingSoon: isZh ? "即将提供" : "Coming soon",
  copy: isZh ? "复制" : "Copy",
  copied: isZh ? "已复制" : "Copied",
  copyFailed: isZh ? "复制失败" : "Copy failed",
  note: isZh
    ? "发行包由 Cloudflare R2 提供并带 SHA-256 校验。"
    : "Release artifacts are served from Cloudflare R2 with SHA-256 sidecars.",
  packaging: isZh ? "完整打包说明" : "Full packaging reference",
  pointer: isZh ? "最新发行指针" : "Latest release pointer",
  extensionsTitle: isZh ? "扩展体系" : "Extensions",
  extensionsDescription: isZh
    ? "核心保持精简，可选能力以原生 Rust 扩展或沙箱 Lua 插件的形式安装。两者都在手册中有完整说明。"
    : "The core stays small: optional capability ships as a native Rust extension or as a sandboxed Lua plugin. Both are documented in the manual.",
  nativeTitle: isZh ? "原生扩展" : "Native extensions",
  nativeDescription: isZh
    ? "通过扩展目录按版本固定安装；已发布的扩展会在各自页面给出精确版本。"
    : "Pinned installs from the extension catalog; published extensions list their exact version on their page.",
  pluginTitle: isZh ? "Lua 插件" : "Lua plugins",
  pluginDescription: isZh
    ? "运行在沙箱中的 Lua 插件，每项都声明自己的能力与清单版本。"
    : "Sandboxed Lua plugins, each with declared capabilities and its own manifest version.",
  published: isZh ? "已发布" : "Published",
  unpublished: isZh ? "未发布" : "Unpublished",
  seeManual: isZh ? "见手册" : "See manual",
  catalogLink: isZh ? "手册中的扩展目录" : "Extension catalog in the manual",
  recipes: isZh
    ? "Gentoo、Void、Solus、FreeBSD、OpenBSD 与 NetBSD 的配方位于 bitty 仓库的 packaging/ 目录，尚未作为官方渠道发布。"
    : "Recipes for Gentoo, Void, Solus, FreeBSD, OpenBSD, and NetBSD live in the bitty repository's packaging/ directory and are not published channels yet.",
};
const docsHref = locale === "zh-CN" ? "/zh-CN/docs/" : "/docs/";
---

<!doctype html>
<html lang={locale} data-theme="shibuya-pop">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={copy.description} />
    <link
      rel="canonical"
      href={`https://bitty.run${locale === "zh-CN" ? "/zh-CN/" : "/"}`}
    />
    <link rel="alternate" hreflang="en" href="https://bitty.run/" />
    <link rel="alternate" hreflang="zh-CN" href="https://bitty.run/zh-CN/" />
    <link rel="alternate" hreflang="x-default" href="https://bitty.run/" />
    <link rel="icon" type="image/x-icon" href="/icons/favicon.ico" />
    <title>{isZh ? "Bitty — 可编程终端工作区" : "Bitty — Programmable Terminal Workspace"}</title>
  </head>
  <body class="site-body">
    <a href="#main-content" class="skip-link">
      {isZh ? "跳转到正文" : "Skip to content"}
    </a>
    <SiteHeader locale={locale} activeNav="hero" />

    <main id="main-content" tabindex="-1">
      <section class="hero-shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="hero-kicker">{copy.badge}</p>
          <h1 id="hero-title">{copy.title}</h1>
          <p class="hero-description">{copy.description}</p>
          <p class="hero-release">{copy.release}</p>
          <div class="hero-actions">
            <a class="primary-action" href="#install">
              {copy.install}
            </a>
            <a class="secondary-action" href={docsHref}>
              {copy.docs}
            </a>
            <a class="secondary-action" href="#extensions">
              {copy.extensionsAction}
            </a>
          </div>
        </div>

        <aside
          class="terminal-card"
          aria-label={isZh ? "Bitty 工作区预览" : "Bitty workspace preview"}
        >
          <div class="terminal-card-bar">
            <span>bitty</span>
            <span>workspace / 01</span>
          </div>
          <pre><code><span class="terminal-muted">$</span> bitty init --yes
<span class="terminal-ok">✓</span> configuration ready
<span class="terminal-muted">$</span> bitty

<span class="terminal-accent">╭───────────────╮</span> <span class="terminal-blue">╭───────────────╮</span>
<span class="terminal-accent">│</span> shell         <span class="terminal-accent">│</span> <span class="terminal-blue">│</span> extensions    <span class="terminal-blue">│</span>
<span class="terminal-accent">╰───────────────╯</span> <span class="terminal-blue">╰───────────────╯</span></code></pre>
        </aside>
      </section>

      <section
        id="install"
        class="install-shell"
        aria-labelledby="install-title"
      >
        <div class="section-heading">
          <p class="section-kicker">{isZh ? "下载" : "DOWNLOAD"}</p>
          <h2 id="install-title">{copy.installTitle}</h2>
          <p>{copy.installDescription}</p>
        </div>

        <div class="install-primary">
          {primaryChannels.map((channel) => (
            <article class="install-card install-card-featured">
              <div class="install-card-heading">
                <div>
                  <p class="install-label">{copy.available}</p>
                  <h3>{channel.name[locale]}</h3>
                </div>
                <span class="status-dot status-available" aria-hidden="true">
                  ●
                </span>
              </div>
              <p class="install-arch">{channel.arch}</p>
              <p>{channel.summary[locale]}</p>
              <div class="command-stack">
                {channel.commands.map((command) => (
                  <div class="command-block">
                    <code>{command.code}</code>
                    <button
                      type="button"
                      data-copy={command.code}
                      aria-label={`${copy.copy}: ${channel.name[locale]}`}
                    >
                      {copy.copy}
                    </button>
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>

        <h3 class="install-subhead">{copy.packageTitle}</h3>
        <div class="install-channels">
          {packageChannels.map((channel) => (
            <article class="install-card channel-card">
              <div class="channel-heading">
                <h4>{channel.name[locale]}</h4>
                <span class="arch-chip">{channel.arch}</span>
              </div>
              <p>{channel.summary[locale]}</p>
              <div class="command-stack">
                {channel.commands.map((command) => (
                  <div class="command-entry">
                    {command.label && (
                      <p class="command-label">{command.label[locale]}</p>
                    )}
                    <div class="command-block">
                      <code>{command.code}</code>
                      <button
                        type="button"
                        data-copy={command.code}
                        aria-label={`${copy.copy}: ${channel.name[locale]}${command.label ? ` — ${command.label[locale]}` : ""}`}
                      >
                        {copy.copy}
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>

        <section class="install-pending" aria-labelledby="pending-title">
          <h3 id="pending-title">{copy.pendingTitle}</h3>
          <ul>
            {pendingChannels.map((channel) => (
              <li>
                <span class="pending-name">{channel.name[locale]}</span>
                <span class="pending-detail">{channel.summary[locale]}</span>
                <span class="pending-reason">
                  {channel.pendingReason?.[locale]}
                </span>
              </li>
            ))}
          </ul>
        </section>

        <p class="install-note">
          {copy.note}{" "}
          <a
            href="https://cdn.bitty.run/install/latest.txt"
            target="_blank"
            rel="noopener noreferrer"
          >
            {copy.pointer} ↗
          </a>
          {" · "}
          <a
            href="https://github.com/bitty-terminal/bitty/blob/main/packaging/INSTALL.md"
            target="_blank"
            rel="noopener noreferrer"
          >
            {copy.packaging} ↗
          </a>
        </p>
        <p class="install-recipes">{copy.recipes}</p>
      </section>

      <section
        id="extensions"
        class="extensions-shell"
        aria-labelledby="extensions-title"
      >
        <div class="section-heading">
          <p class="section-kicker">{isZh ? "扩展" : "EXTENSIONS"}</p>
          <h2 id="extensions-title">{copy.extensionsTitle}</h2>
          <p>{copy.extensionsDescription}</p>
        </div>

        <div class="extension-track">
          <h3>{copy.nativeTitle}</h3>
          <p class="track-description">{copy.nativeDescription}</p>
          {graphicsVersion && (
            <p class="track-command">
              <code>{`bitty extension install graphics --version ${graphicsVersion}`}</code>
            </p>
          )}
          <ul class="extension-grid">
            {extensions.native.map((extension) => (
              <li>
                <a class="extension-card" href={extension.href}>
                  <span class="extension-head">
                    <span class="extension-name">{extension.name}</span>
                    <span
                      class:list={[
                        "extension-status",
                        {
                          "is-published": extension.status === "published",
                        },
                      ]}
                    >
                      {extension.status === "published"
                        ? copy.published
                        : extension.status === "unpublished"
                          ? copy.unpublished
                          : copy.seeManual}
                    </span>
                  </span>
                  <span class="extension-summary">{extension.summary}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="extension-track">
          <h3>{copy.pluginTitle}</h3>
          <p class="track-description">{copy.pluginDescription}</p>
          <p class="track-command">
            <code>bitty plugin install bitty-terminal.bar</code>
          </p>
          <p class="track-command">
            <code>bitty plugin enable bitty-terminal.bar</code>
          </p>
          <ul class="plugin-list">
            {extensions.plugins.map((plugin) => (
              <li>
                <a href={plugin.href}>{plugin.id}</a>
              </li>
            ))}
          </ul>
        </div>

        <p class="extensions-note">
          <a href={`${docsHref}extensions/overview/`}>{copy.catalogLink} ↗</a>
        </p>
      </section>
    </main>

    <SiteFooter locale={locale} />

    <script
      define:vars={{
        copiedMessage: copy.copied,
        copyFailedMessage: copy.copyFailed,
      }}
    >
      const copied = copiedMessage;
      const copyFailed = copyFailedMessage;
      for (const element of document.querySelectorAll("[data-copy]")) {
        if (!(element instanceof HTMLButtonElement)) continue;
        const button = element;
        button.addEventListener("click", async () => {
          const command = button.dataset.copy ?? "";
          try {
            await navigator.clipboard.writeText(command);
            const original = button.textContent ?? "Copy";
            button.textContent = copied;
            window.setTimeout(() => {
              button.textContent = original;
            }, 1600);
          } catch {
            button.textContent = copyFailed;
          }
        });
      }
    </script>
  </body>
</html>

<style>
  .site-body {
    min-height: 100vh;
    background: var(--paper);
    color: var(--ink);
  }

  .hero-shell,
  .install-shell,
  .extensions-shell {
    width: min(72rem, calc(100% - 2rem));
    margin-inline: auto;
  }

  .hero-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.14fr) minmax(20rem, 0.86fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    min-height: min(45rem, calc(100vh - 4rem));
    padding-block: 5rem 4rem;
  }

  .hero-copy {
    min-width: 0;
    max-width: 46rem;
  }
  .hero-kicker,
  .section-kicker,
  .install-label {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hero-kicker {
    margin: 0 0 1.25rem;
  }
  .hero-copy h1 {
    max-width: 18ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4.9vw, 3.5rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .hero-description {
    max-width: 42rem;
    margin: 1.75rem 0 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    line-height: 1.65;
  }
  .hero-release,
  .install-note,
  .install-recipes {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .primary-action,
  .secondary-action {
    display: inline-flex;
    min-height: var(--touch-target);
    align-items: center;
    padding: 0.7rem 1rem;
    border: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
  }
  .primary-action {
    background: var(--accent);
    color: white;
  }
  .secondary-action {
    background: var(--card);
    color: var(--ink);
  }
  .primary-action:hover,
  .secondary-action:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-lg);
  }

  .terminal-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--ink);
    background: var(--terminal-bg);
    color: var(--terminal-ink);
    box-shadow: 0.8rem 0.8rem 0 var(--accent-soft);
  }
  .terminal-card-bar {
    display: flex;
    justify-content: space-between;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--terminal-line);
    color: var(--terminal-muted);
    font: 0.75rem var(--font-mono);
  }
  .terminal-card pre {
    margin: 0;
    padding: 1.5rem;
    overflow-x: auto;
    font: 0.85rem/1.8 var(--font-mono);
  }
  .terminal-muted {
    color: var(--terminal-muted);
  }
  .terminal-ok {
    color: var(--ok-soft);
  }
  .terminal-accent {
    color: var(--terminal-prompt);
  }
  .terminal-blue {
    color: #8ab4f8;
  }

  .install-shell {
    padding-block: 3rem 6rem;
  }
  .section-heading {
    max-width: 46rem;
    margin-bottom: 2rem;
  }
  .section-heading h2 {
    margin: 0.3rem 0 0.75rem;
    font: 700 clamp(2rem, 4vw, 3rem)/1.05 var(--font-display);
  }
  .section-heading p:last-child {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }
  .install-primary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .install-channels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 1rem;
  }
  .install-card {
    min-width: 0;
    padding: 1.25rem;
    border: 1px solid var(--line);
    background: var(--card);
    box-shadow: var(--shadow);
  }
  .install-card-featured {
    border-color: var(--accent);
  }
  .install-card-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
  }
  .install-card h3 {
    margin: 0.25rem 0 0;
    font: 700 1.2rem var(--font-display);
  }
  .install-card > p {
    min-height: 2.8rem;
    margin: 0.9rem 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .install-arch {
    min-height: 0 !important;
    margin: 0.55rem 0 0 !important;
    color: var(--accent) !important;
    font-family: var(--font-mono);
    font-size: 0.68rem !important;
    letter-spacing: 0.04em;
  }
  .install-label {
    margin: 0;
    font-size: 0.68rem;
  }
  .status-dot {
    font-size: 1rem;
  }
  .status-available {
    color: var(--ok);
  }
  .install-subhead {
    margin: 2.75rem 0 1rem;
    font: 700 1.35rem var(--font-display);
  }
  .channel-card {
    display: flex;
    flex-direction: column;
  }
  .channel-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .channel-heading h4 {
    margin: 0;
    font: 700 1.05rem var(--font-display);
  }
  .arch-chip {
    border: 1px solid var(--line);
    padding: 0.1rem 0.4rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    white-space: nowrap;
  }
  .channel-card > p {
    min-height: 0;
    margin: 0.5rem 0 0.85rem;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .command-stack {
    display: grid;
    min-width: 0;
    gap: 0.6rem;
    margin-top: auto;
  }
  .command-entry {
    display: grid;
    gap: 0.3rem;
  }
  .command-label {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .command-block {
    display: flex;
    min-width: 0;
    align-items: stretch;
    gap: 0.5rem;
    padding: 0.7rem;
    background: var(--terminal-bg);
    color: var(--terminal-ink);
  }
  .command-block code {
    min-width: 0;
    flex: 1;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
    font: 0.72rem/1.55 var(--font-mono);
  }
  .command-block button {
    align-self: flex-start;
    border: 1px solid var(--terminal-line);
    padding: 0.35rem 0.55rem;
    background: var(--terminal-panel);
    color: var(--terminal-ink);
    font: 700 0.68rem var(--font-mono);
    cursor: pointer;
  }
  .command-block button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .install-pending {
    margin-top: 2.5rem;
    padding: 1.25rem;
    border: 1px dashed var(--line);
  }
  .install-pending h3 {
    margin: 0 0 0.75rem;
    font: 700 1rem var(--font-display);
  }
  .install-pending ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .install-pending li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    align-items: baseline;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .pending-name {
    color: var(--ink);
    font-family: var(--font-mono);
    font-weight: 700;
  }
  .pending-reason {
    flex-basis: 100%;
    font-size: 0.82rem;
  }
  .extensions-shell {
    padding-block: 2rem 6rem;
  }
  .extension-track + .extension-track {
    margin-top: 2.5rem;
  }
  .extension-track h3 {
    margin: 0 0 0.35rem;
    font: 700 1.45rem var(--font-display);
  }
  .track-description {
    max-width: 46rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .track-command {
    margin: 0.75rem 0 1.25rem;
  }
  .track-command code {
    display: inline-block;
    margin-block-end: 0.35rem;
    margin-inline-end: 0.4rem;
    padding: 0.45rem 0.6rem;
    background: var(--terminal-bg);
    color: var(--terminal-ink);
    font: 0.75rem/1.4 var(--font-mono);
  }
  .extension-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .extension-grid li {
    min-width: 0;
  }
  .extension-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem;
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 140ms ease,
      transform 140ms ease;
  }
  .extension-card:hover,
  .extension-card:focus-visible {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .extension-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .extension-name {
    font-family: var(--font-mono);
    font-size: 0.95rem;
