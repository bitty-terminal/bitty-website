const families = [
  { id: "all", label: "All Formats (12)" },
  { id: "arch", label: "Arch / CachyOS" },
  { id: "debian", label: "Debian / Ubuntu" },
  { id: "fedora", label: "Fedora / RHEL" },
  { id: "suse", label: "openSUSE" },
  { id: "alpine", label: "Alpine (musl)" },
  { id: "nix", label: "NixOS" },
  { id: "source", label: "Void & Gentoo" },
  { id: "universal", label: "Universal (AppImage / Flatpak / Snap)" },
];

const filterI18nMap: Record<string, string> = {
  all: "filterAll",
  arch: "filterArch",
  debian: "filterDebian",
  fedora: "filterFedora",
  suse: "filterSuse",
  alpine: "filterAlpine",
  nix: "filterNix",
  source: "filterSource",
  universal: "filterUniversal",
};
---

<section
  id="linux-distros"
  class="linux-distros-section space-y-6"
  aria-labelledby="linux-distros-title"
>
  <div class="section-header flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div class="space-y-2">
      <div class="flex items-center gap-2 font-mono-tech">
        <span
          class="px-2 py-0.5 rounded font-bold bg-[var(--accent)] text-[#0b0914] text-[10px]"
          data-i18n="linuxEcosystemBadge"
        >
          LINUX ECOSYSTEM
        </span>
        <span
          class="text-xs text-[var(--accent-yellow)] font-bold"
          data-i18n="linuxEcosystemSubtitle"
        >
          ★ Universal Linux Distribution &amp; Package Support
        </span>
      </div>
      <h2
        id="linux-distros-title"
        class="font-cyber-display font-bold text-2xl sm:text-3xl text-[var(--fg-primary)]"
        data-i18n="linuxMatrixTitle"
      >
        Universal Linux Distribution Matrix
      </h2>
      <p
        class="text-xs sm:text-sm text-[var(--fg-secondary)] max-w-2xl leading-relaxed"
        data-i18n="linuxMatrixDesc"
      >
        From bleeding-edge rolling releases (Arch, CachyOS) to stable enterprise
        deployments (Debian, Ubuntu, Fedora, openSUSE), lightweight musl systems
        (Alpine), and reproducible environments (NixOS)—Bitty runs natively
        everywhere.
      </p>
    </div>

    <!-- Quick Stats Sticker -->
    <div class="shrink-0 flex items-center gap-3 font-mono-tech text-xs bg-[var(--bg-elevated)] p-3 rounded-xl border-2 border-[var(--ink-border)] shadow-[3px_3px_0px_var(--toon-shadow)]">
      <div class="text-center px-2">
        <div class="font-bold text-[var(--accent)] text-lg">100%</div>
        <div
          class="text-[10px] text-[var(--fg-muted)]"
          data-i18n="statNativeRust"
        >
          NATIVE RUST
        </div>
      </div>
      <div class="h-6 w-px bg-[var(--card-border)]"></div>
      <div class="text-center px-2">
        <div class="font-bold text-[var(--accent-mint)] text-lg">12</div>
        <div
          class="text-[10px] text-[var(--fg-muted)]"
          data-i18n="statPackages"
        >
          FORMATS &amp; PKGS
        </div>
      </div>
      <div class="h-6 w-px bg-[var(--card-border)]"></div>
      <div class="text-center px-2">
        <div class="font-bold text-[var(--accent-yellow)] text-lg">0B</div>
        <div class="text-[10px] text-[var(--fg-muted)]" data-i18n="statIdleMem">
          IDLE MEMORY
        </div>
      </div>
    </div>
  </div>

  <!-- Filter Buttons / Category Bar -->
  <div
    class="distro-filter-bar flex flex-wrap items-center gap-2 font-mono-tech text-xs"
    role="tablist"
    aria-label="Filter Linux Distribution Families"
  >
    {families.map((f, i) => (
      <button
        type="button"
        role="tab"
        id={`distro-tab-${f.id}`}
        aria-selected={i === 0 ? "true" : "false"}
        data-filter={f.id}
        tabindex={i === 0 ? 0 : -1}
        class={`distro-filter-pill px-3 py-1.5 rounded-lg border-2 font-bold cursor-pointer transition-all ${
          i === 0
            ? "active bg-[var(--accent)] text-[#0b0914] border-[var(--ink-border)] shadow-[2px_2px_0px_var(--toon-shadow)]"
            : "bg-[var(--bg-surface)] text-[var(--fg-secondary)] border-[var(--card-border)] hover:border-[var(--ink-border)] hover:text-[var(--fg-primary)]"
        }`}
      >
        <span data-i18n={filterI18nMap[f.id]}>{f.label}</span>
      </button>
    ))}
  </div>

  <!-- Distro Cards Grid (Manga / Bento Style) -->
  <div
    id="distro-cards-grid"
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5"
  >
    {distroList.map((distro) => (
      <article
        class="distro-card toon-card p-4 sm:p-5 flex flex-col justify-between gap-4"
        data-distro-family={distro.family}
      >
        <!-- Card Top Bar: Distro Name + Badges -->
        <div class="space-y-3">
          <div class="flex items-center justify-between gap-2 border-b-2 border-[var(--card-border)] pb-2.5">
            <div class="flex items-center gap-2">
              <span
                class="px-2 py-0.5 rounded text-[10px] font-mono-tech font-bold uppercase tracking-wider text-[#0b0914]"
                style={`background: ${distro.badgeColor};`}
              >
                {distro.badge}
              </span>
              <span class="text-[10px] font-mono-tech text-[var(--fg-muted)] font-bold">
                {distro.categoryName}
              </span>
            </div>
            <span class="text-[10px] font-mono-tech font-bold text-[var(--accent-mint)]">
              ● READY
            </span>
          </div>

          <div class="space-y-1">
            <h3 class="font-cyber-display font-bold text-lg text-[var(--fg-primary)] flex items-center justify-between">
              <span>{distro.name}</span>
            </h3>
            <div class="flex flex-wrap gap-1 font-mono-tech text-[10px] text-[var(--fg-muted)]">
              {distro.distros.map((d) => (
                <span class="px-1.5 py-0.5 rounded bg-[var(--bg-elevated)] border border-[var(--card-border)]">
                  {d}
                </span>
              ))}
            </div>
          </div>

          <p class="text-xs text-[var(--fg-secondary)] leading-relaxed">
            {distro.description}
          </p>

          <!-- Primary Install Command Box with Copy Button -->
          <div class="space-y-1.5 pt-1">
            <div class="distro-code-box p-2.5 rounded-lg bg-[var(--bg-code)] border border-[var(--card-border)] flex items-center justify-between gap-2 overflow-hidden">
              <div
                class="font-mono-tech text-xs text-[#f5f3ff] overflow-x-auto whitespace-nowrap select-all flex-1 py-0.5"
                style="scrollbar-width: thin;"
              >
                <span class="select-none mr-1.5 font-bold text-[var(--accent-pop)]">
                  ❯
                </span>
                <span class="distro-cmd-text">{distro.command}</span>
              </div>
              <button
                type="button"
                class="copy-distro-cmd-btn shrink-0 px-2 py-1 rounded bg-[var(--bg-elevated)] border border-[var(--card-border)] hover:border-[var(--ink-border)] font-mono-tech text-[10px] font-bold text-[var(--fg-primary)] cursor-pointer transition-colors"
                aria-label={`Copy install command for ${distro.name}`}
              >
                COPY
              </button>
            </div>

            {distro.altCommand && (
              <div class="text-[10px] font-mono-tech text-[var(--fg-muted)] flex items-center gap-1.5 px-1 truncate">
                <span class="text-[var(--accent-yellow)] font-bold">ALT:</span>
                <code class="text-[var(--fg-secondary)] truncate">
                  {distro.altCommand}
                </code>
              </div>
            )}
          </div>
        </div>

        <!-- Card Bottom Bar: Architectures & Direct Downloads -->
        <div class="pt-3 border-t-dashed space-y-2 font-mono-tech text-[11px]">
          <div class="flex items-center justify-between">
            <span class="text-[10px] text-[var(--fg-muted)] uppercase tracking-wider font-bold">
              Arch:
            </span>
            <div class="flex items-center gap-1">
              {distro.architectures.map((arch) => (
                <span class="text-[9px] px-1.5 py-0.2 rounded bg-[var(--bg-canvas)] border border-[var(--card-border)] text-[var(--fg-secondary)] font-bold">
                  {arch}
                </span>
              ))}
            </div>
          </div>

          {distro.downloads && distro.downloads.length > 0 && (
            <div class="flex items-center justify-between gap-1 pt-1">
              <span class="text-[10px] text-[var(--fg-muted)] font-bold">
                Direct:
              </span>
              <div class="flex flex-wrap items-center gap-1.5">
                {distro.downloads.map((dl) => (
                  <a
                    href={dl.url}
                    class="px-2 py-0.5 rounded bg-[var(--bg-canvas)] border border-[var(--card-border)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] text-[10px] font-bold transition-colors"
                    title={dl.title}
                  >
                    <span>{dl.label}</span>
                    <span class="text-[var(--accent)] ml-0.5">↓</span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  (() => {
    // 1. Filter pill switching
    const filterPills = document.querySelectorAll<HTMLButtonElement>(
      ".distro-filter-pill",
    );
    const distroCards = document.querySelectorAll<HTMLElement>(".distro-card");
    const pillList = Array.from(filterPills);

    const applyFilter = (
      filterKey: string,
      activePill: HTMLButtonElement,
      focus = true,
    ) => {
      filterPills.forEach((p) => {
        p.classList.remove("active");
        p.setAttribute("aria-selected", "false");
        p.tabIndex = -1;
        p.style.background = "var(--bg-surface)";
        p.style.color = "var(--fg-secondary)";
        p.style.borderColor = "var(--card-border)";
        p.style.boxShadow = "none";
      });

      activePill.classList.add("active");
      activePill.setAttribute("aria-selected", "true");
      activePill.tabIndex = 0;
      activePill.style.background = "var(--accent)";
      activePill.style.color = "#0b0914";
      activePill.style.borderColor = "var(--ink-border)";
      activePill.style.boxShadow = "2px 2px 0px var(--toon-shadow)";

      if (focus) activePill.focus();

      distroCards.forEach((card) => {
        const family = card.getAttribute("data-distro-family");
        if (filterKey === "all" || family === filterKey) {
          card.style.display = "flex";
        } else {
          card.style.display = "none";
        }
      });
    };

    filterPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        const key = pill.getAttribute("data-filter") || "all";
        applyFilter(key, pill, false);
      });

      pill.addEventListener("keydown", (e) => {
        const index = pillList.indexOf(pill);
        if (index === -1) return;
        let nextIndex = -1;

        if (e.key === "ArrowRight") {
          nextIndex = (index + 1) % pillList.length;
        } else if (e.key === "ArrowLeft") {
          nextIndex = (index - 1 + pillList.length) % pillList.length;
        } else if (e.key === "Home") {
          nextIndex = 0;
        } else if (e.key === "End") {
          nextIndex = pillList.length - 1;
        }

        if (nextIndex !== -1) {
          e.preventDefault();
          const target = pillList[nextIndex];
          if (target) {
            const key = target.getAttribute("data-filter") || "all";
            applyFilter(key, target, true);
          }
        }
      });
    });

    // 2. Individual copy buttons on code boxes
    const copyButtons = document.querySelectorAll<HTMLButtonElement>(
      ".copy-distro-cmd-btn",
    );
    copyButtons.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const box = btn.closest(".distro-code-box");
        const cmdEl = box?.querySelector(".distro-cmd-text");
        const text = cmdEl?.textContent?.trim() || "";
        if (!text) return;

        try {
          await navigator.clipboard.writeText(text);
          const original = btn.textContent;
          btn.textContent = "COPIED!";
          btn.style.color = "var(--accent-mint)";
          setTimeout(() => {
            btn.textContent = original;
            btn.style.color = "";
          }, 2000);
        } catch {}
      });
    });
  })();
</script>

