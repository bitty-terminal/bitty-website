    scroll-margin-top: 5rem;
  }

  .distro-code-box {
    box-sizing: border-box;
  }

  .distro-card {
    transition:
      transform 0.16s ease,
      box-shadow 0.16s ease,
      border-color 0.16s ease;
  }

  .distro-filter-pill {
    min-height: 2.25rem;
    display: inline-flex;
    align-items: center;
  }
</style>
