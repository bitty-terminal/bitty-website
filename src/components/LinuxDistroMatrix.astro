---
// src/components/LinuxDistroMatrix.astro
// Universal Linux Packaging & Distribution Matrix for Bitty Terminal.
// Cyber-Pop & Manga Bento style with ultra-compact One-Line Command & Button design.

import { INSTALL_SH_URL, releaseUrl } from "../lib/release";

interface DistroDownload {
  label: string;
  url: string;
  title: string;
}

interface DistroEntry {
  id: string;
  name: string;
  family:
    | "arch"
    | "debian"
    | "fedora"
    | "suse"
    | "alpine"
    | "nix"
    | "source"
    | "universal";
  categoryName: string;
  badge: string;
  badgeColor: string;
  distros: string[];
  command: string;
  altCommand?: string;
  architectures: string[];
  downloads?: DistroDownload[];
}

const distroList: DistroEntry[] = [
  {
    id: "arch",
    name: "Arch Linux & CachyOS",
    family: "arch",
    categoryName: "Arch & Derivatives",
    badge: "AUR",
    badgeColor: "var(--accent-mint)",
    distros: ["Arch Linux", "CachyOS", "Manjaro", "EndeavourOS", "Garuda"],
    command: "paru -S bitty-bin",
    altCommand: "yay -S bitty-bin",
    architectures: ["x86_64 (v3/v4)", "aarch64"],
    downloads: [
      {
        label: "PKGBUILD",
        url: "https://aur.archlinux.org/packages/bitty-bin",
        title: "View AUR Package Build",
      },
      {
        label: ".pkg.tar.zst",
        url: releaseUrl("bitty-{v}-1-x86_64.pkg.tar.zst"),
        title: "Download Prebuilt Pacman Package",
      },
    ],
  },
  {
    id: "debian-ubuntu",
    name: "Debian & Ubuntu",
    family: "debian",
    categoryName: "Debian & Ubuntu Family",
    badge: "APT",
    badgeColor: "var(--accent-pop)",
    distros: [
      "Ubuntu 24.04/22.04 LTS",
      "Debian 12+",
      "Linux Mint",
      "Pop!_OS",
      "Zorin OS",
    ],
    command: "sudo apt install ./bitty_amd64.deb",
    altCommand: `curl -fsSL ${INSTALL_SH_URL} | bash`,
    architectures: ["amd64 (x86_64)", "arm64 (aarch64)"],
    downloads: [
      {
        label: "bitty_amd64.deb",
        url: releaseUrl("bitty-x86_64-unknown-linux-gnu.deb"),
        title: "Download Debian/Ubuntu amd64 package",
      },
      {
        label: "bitty_arm64.deb",
        url: releaseUrl("bitty-aarch64-unknown-linux-gnu.deb"),
        title: "Download Debian/Ubuntu arm64 package",
      },
    ],
  },
  {
    id: "fedora-rhel",
    name: "Fedora & RHEL",
    family: "fedora",
    categoryName: "Fedora & Red Hat Family",
    badge: "DNF",
    badgeColor: "var(--accent-violet)",
    distros: [
      "Fedora 40/41",
      "RHEL 9+",
      "AlmaLinux",
      "Rocky Linux",
      "CentOS Stream",
    ],
    command: "sudo dnf copr enable bitty/bitty && sudo dnf install bitty",
    altCommand: "sudo dnf install ./bitty-x86_64.rpm",
    architectures: ["x86_64", "aarch64"],
    downloads: [
      {
        label: "bitty-x86_64.rpm",
        url: releaseUrl("bitty-x86_64-unknown-linux-gnu.rpm"),
        title: "Download RPM for x86_64",
      },
      {
        label: "bitty-aarch64.rpm",
        url: releaseUrl("bitty-aarch64-unknown-linux-gnu.rpm"),
        title: "Download RPM for aarch64",
      },
    ],
  },
  {
    id: "opensuse",
    name: "openSUSE",
    family: "suse",
    categoryName: "openSUSE Family",
    badge: "OBS",
    badgeColor: "var(--accent-mint)",
    distros: ["openSUSE Tumbleweed", "openSUSE Leap 15.6+", "Aeon", "MicroOS"],
    command: "sudo zypper in bitty",
    altCommand: "sudo zypper install ./bitty-x86_64.rpm",
    architectures: ["x86_64", "aarch64"],
    downloads: [
      {
        label: "bitty-x86_64.rpm",
        url: releaseUrl("bitty-x86_64-unknown-linux-gnu.rpm"),
        title: "Download RPM package",
      },
    ],
  },
  {
    id: "alpine",
    name: "Alpine (musl)",
    family: "alpine",
    categoryName: "Alpine & musl Family",
    badge: "APK",
    badgeColor: "var(--accent-yellow)",
    distros: ["Alpine Linux v3.19+", "postmarketOS", "musl-based Containers"],
    command: "apk add --allow-untrusted ./bitty.apk",
    altCommand: "apk add bitty",
    architectures: ["x86_64", "aarch64", "armv7"],
    downloads: [
      {
        label: "bitty.apk",
        url: releaseUrl("bitty-x86_64-unknown-linux-musl.apk"),
        title: "Download Alpine APK package",
      },
    ],
  },
  {
    id: "nixos",
    name: "NixOS & Flakes",
    family: "nix",
    categoryName: "NixOS & Flakes",
    badge: "NIX",
    badgeColor: "var(--accent-violet)",
    distros: ["NixOS 24.05+", "NixOS Unstable", "Any Linux with Nix"],
    command: "nix profile install github:bitty-terminal/bitty",
    altCommand: "environment.systemPackages = [ pkgs.bitty ];",
    architectures: ["x86_64-linux", "aarch64-linux"],
    downloads: [
      {
        label: "flake.nix",
        url: "https://github.com/bitty-terminal/bitty/blob/main/flake.nix",
        title: "View Bitty Flake Definition",
      },
    ],
  },
  {
    id: "void",
    name: "Void Linux",
    family: "source",
    categoryName: "Void Linux",
    badge: "XBPS",
    badgeColor: "var(--accent-mint)",
    distros: ["Void Linux (glibc)", "Void Linux (musl)"],
    command: "sudo xbps-install -S bitty",
    altCommand: "./xbps-src pkg bitty",
    architectures: ["x86_64", "aarch64"],
    downloads: [
      {
        label: "xbps-template",
        url: "https://github.com/bitty-terminal/bitty/tree/main/packaging/void",
        title: "XBPS package template",
      },
    ],
  },
  {
    id: "gentoo",
    name: "Gentoo Linux",
    family: "source",
    categoryName: "Gentoo Linux",
    badge: "PORTAGE",
    badgeColor: "var(--accent-pop)",
    distros: ["Gentoo Linux", "Funtoo"],
    command: "emerge --ask app-shells/bitty",
    altCommand: 'USE="wayland vulkan" emerge --ask app-shells/bitty',
    architectures: ["x86_64", "aarch64", "riscv64"],
    downloads: [
      {
        label: "bitty.ebuild",
        url: "https://github.com/bitty-terminal/bitty/tree/main/packaging/gentoo",
        title: "Portage ebuild definition",
      },
    ],
  },
  {
    id: "appimage",
    name: "Universal AppImage",
    family: "universal",
    categoryName: "Universal Formats",
    badge: "APPIMAGE",
    badgeColor: "var(--accent)",
    distros: ["All Linux Distributions (glibc 2.31+)"],
    command:
      "chmod +x bitty-linux-x86_64.AppImage && ./bitty-linux-x86_64.AppImage",
    architectures: ["x86_64"],
    downloads: [
      {
        label: "bitty-linux-x86_64.AppImage",
        url: releaseUrl("bitty-x86_64-unknown-linux-gnu.AppImage"),
        title: "Download Standalone AppImage",
      },
    ],
  },
  {
    id: "flatpak",
    name: "Flatpak & Flathub",
    family: "universal",
    categoryName: "Universal Formats",
    badge: "FLATHUB",
    badgeColor: "var(--accent-mint)",
    distros: ["SteamOS", "Fedora Silverblue", "Ubuntu", "Arch", "Debian"],
    command: "flatpak install flathub run.bitty.Bitty",
    altCommand: "flatpak run run.bitty.Bitty",
    architectures: ["x86_64", "aarch64"],
    downloads: [
      {
        label: "Flathub Page",
        url: "https://flathub.org/apps/run.bitty.Bitty",
        title: "View on Flathub",
      },
    ],
  },
  {
    id: "snap",
    name: "Canonical Snap",
    family: "universal",
    categoryName: "Universal Formats",
    badge: "SNAP",
    badgeColor: "var(--accent-violet)",
    distros: ["Ubuntu", "Debian", "Fedora", "Manjaro", "openSUSE"],
    command: "sudo snap install bitty --classic",
    altCommand: "snap info bitty",
    architectures: ["amd64", "arm64"],
    downloads: [
      {
        label: "Snap Store",
        url: "https://snapcraft.io/bitty",
        title: "View on Snapcraft Store",
      },
    ],
  },
  {
    id: "portable-tarball",
    name: "Standalone Tarball",
    family: "universal",
    categoryName: "Universal Formats",
    badge: ".TAR.ZST",
    badgeColor: "var(--accent-yellow)",
    distros: ["All POSIX Linux Distributions"],
    command: "tar -I zstd -xvf bitty-linux-x86_64.tar.zst -C ~/.local/bin/",
    altCommand: `curl -fsSL ${releaseUrl("bitty-{v}-x86_64-unknown-linux-gnu.tar.zst")} | tar -I zstd -x -C ~/.local/bin/`,
    architectures: ["x86_64", "aarch64"],
    downloads: [
      {
        label: "bitty-linux-x86_64.tar.zst",
        url: releaseUrl("bitty-{v}-x86_64-unknown-linux-gnu.tar.zst"),
        title: "Download x86_64 tarball",
      },
      {
        label: "bitty-linux-aarch64.tar.zst",
        url: releaseUrl("bitty-{v}-aarch64-unknown-linux-gnu.tar.zst"),
        title: "Download aarch64 tarball",
      },
    ],
  },
];
---

<section
  id="linux-distros"
  class="linux-distros-section space-y-5"
  aria-labelledby="linux-distros-title"
>
  <!-- 1. Header with Mode Switcher -->
  <div class="section-header flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div class="space-y-1.5">
      <div class="flex items-center gap-2 font-mono-tech">
        <span
          class="px-2 py-0.5 rounded font-bold bg-[var(--accent)] text-[#0b0914] text-[10px]"
          data-i18n="linuxEcosystemBadge"
        >
          LINUX ECOSYSTEM
        </span>
        <span
          class="text-xs text-[var(--accent-yellow)] font-bold"
          data-i18n="linuxEcosystemSubtitle"
        >
          ★ Universal Linux Distribution &amp; Package Support
        </span>
      </div>
      <h2
        id="linux-distros-title"
        class="font-cyber-display font-bold text-2xl sm:text-3xl text-[var(--fg-primary)]"
        data-i18n="linuxMatrixTitle"
      >
        Universal Linux Distribution Matrix
      </h2>
      <p
        class="text-xs sm:text-sm text-[var(--fg-secondary)] max-w-2xl leading-relaxed"
        data-i18n="linuxMatrixDesc"
      >
        From bleeding-edge rolling releases (Arch, CachyOS) to stable enterprise
        deployments (Debian, Ubuntu, Fedora, openSUSE), lightweight musl systems
        (Alpine), and reproducible environments (NixOS)—Bitty runs natively
        everywhere.
      </p>
    </div>

    <!-- View Mode Switcher -->
    <div
      class="flex items-center gap-1.5 p-1 rounded-xl bg-[var(--bg-elevated)] border-2 border-[var(--ink-border)] font-mono-tech text-xs shadow-[2px_2px_0px_var(--toon-shadow)] self-start md:self-end"
      role="tablist"
      aria-label="Linux Distro View Mode"
    >
      <button
        type="button"
        id="distro-mode-quick"
        role="tab"
        aria-selected="true"
        aria-controls="distro-quick-deck"
        class="distro-mode-btn px-3 py-1.5 rounded-lg border-2 border-[var(--ink-border)] bg-[var(--accent)] text-[#0b0914] font-bold transition-all shadow-[1px_1px_0px_var(--toon-shadow)] active cursor-pointer"
      >
        <span data-i18n="distroViewQuick">⚡ Quick Command</span>
      </button>
      <button
        type="button"
        id="distro-mode-all"
        role="tab"
        aria-selected="false"
        aria-controls="distro-all-table"
        class="distro-mode-btn px-3 py-1.5 rounded-lg border-2 border-transparent text-[var(--fg-secondary)] hover:text-[var(--fg-primary)] font-bold transition-all cursor-pointer"
      >
        <span data-i18n="distroViewAll">📋 All Distros</span>
      </button>
    </div>
  </div>

  <!-- 2. Primary Quick-Select Deck (Buttons + One-Line Command Box) -->
  <div id="distro-quick-deck" class="distro-view-panel space-y-3">
    <!-- 12 Distro Selector Buttons (Pills / Arcade Buttons) -->
    <div
      class="distro-button-deck grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2 font-mono-tech text-xs"
      role="tablist"
      aria-label="Select Linux Distribution"
    >
      {distroList.map((distro, idx) => (
        <button
          type="button"
          role="tab"
          id={`distro-btn-${distro.id}`}
          aria-selected={idx === 0 ? "true" : "false"}
          data-distro-id={distro.id}
          tabindex={idx === 0 ? 0 : -1}
          class={`distro-picker-btn p-2 rounded-xl border-2 flex items-center gap-2 transition-all cursor-pointer text-left ${
            idx === 0
              ? "active border-[var(--ink-border)] bg-[var(--accent)] text-[#0b0914] shadow-[2px_2px_0px_var(--toon-shadow)] font-bold"
              : "border-[var(--card-border)] bg-[var(--bg-surface)] text-[var(--fg-secondary)] hover:border-[var(--ink-border)] hover:text-[var(--fg-primary)]"
          }`}
        >
          <span
            class="px-1.5 py-0.5 rounded text-[9px] font-bold text-[#0b0914] shrink-0"
            style={`background: ${distro.badgeColor};`}
          >
            {distro.badge}
          </span>
          <span class="truncate font-cyber-display text-xs font-bold">
            {distro.name}
          </span>
        </button>
      ))}
    </div>

    <!-- Active One-Line Command Box & Quick Actions Console -->
    <div
      id="distro-console-card"
      class="toon-card p-4 sm:p-5 space-y-3 bg-[var(--bg-elevated)]"
      role="tabpanel"
      aria-labelledby="distro-btn-arch"
    >
      <!-- Meta Top Bar: Distro info & Status -->
      <div class="flex flex-wrap items-center justify-between gap-2 border-b-2 border-[var(--card-border)] pb-2.5 font-mono-tech text-xs">
        <div class="flex items-center gap-2 min-w-0">
          <span
            id="console-distro-badge"
            class="px-2 py-0.5 rounded text-[10px] font-bold text-[#0b0914] shrink-0"
            style={`background: ${distroList[0].badgeColor};`}
          >
            {distroList[0].badge}
          </span>
          <span
            id="console-distro-name"
            class="font-cyber-display font-bold text-base text-[var(--fg-primary)] truncate"
          >
            {distroList[0].name}
          </span>
          <span
            id="console-distro-cat"
            class="text-[11px] text-[var(--fg-muted)] hidden sm:inline truncate"
          >
            ({distroList[0].categoryName})
          </span>
        </div>
        <div class="flex items-center gap-3 shrink-0">
          <div class="flex items-center gap-1.5">
            <span
              class="text-[10px] text-[var(--fg-muted)] uppercase tracking-wider font-bold"
              data-i18n="distroArchLabel"
            >
              ARCH:
            </span>
            <span
              id="console-distro-arch"
              class="text-[10px] px-1.5 py-0.5 rounded bg-[var(--bg-canvas)] border border-[var(--card-border)] text-[var(--fg-secondary)] font-bold"
            >
              {distroList[0].architectures.join(", ")}
            </span>
          </div>
          <span
            class="text-[10px] font-bold text-[var(--accent-mint)]"
            data-i18n="distroStatusReady"
          >
            ● READY
          </span>
        </div>
      </div>

      <!-- THE One-Line Command Readout -->
      <div class="distro-code-box p-3 rounded-xl bg-[var(--bg-code)] border-2 border-[var(--card-border)] flex items-center justify-between gap-3 overflow-hidden shadow-inner">
        <div class="font-mono-tech text-xs sm:text-sm text-[#f5f3ff] overflow-x-auto whitespace-nowrap select-all flex-1 py-0.5 no-scrollbar">
          <span class="select-none mr-2 font-bold text-[var(--accent-pop)]">
            ❯
          </span>
          <span id="console-distro-cmd" class="distro-cmd-text font-bold">
            {distroList[0].command}
          </span>
        </div>
        <button
          type="button"
          id="copy-console-cmd-btn"
          class="arcade-btn shrink-0 w-20 justify-center px-3 py-1.5 bg-[var(--bg-elevated)] font-mono-tech text-xs font-bold text-[var(--fg-primary)] flex items-center cursor-pointer"
          aria-label="Copy install command"
        >
          <span id="copy-console-label" data-i18n="distroCopyBtn">
            COPY
          </span>
        </button>
      </div>

      <!-- Quick Action Row: Alt Command + Direct Downloads -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 pt-0.5 font-mono-tech text-xs text-[var(--fg-muted)]">
        <!-- Left: Alt command -->
        <div
          id="console-alt-container"
          class="flex items-center gap-1.5 truncate min-w-0"
        >
          <span
            class="text-[var(--accent-yellow)] font-bold shrink-0"
            data-i18n="distroAltLabel"
          >
            ALT:
          </span>
          <code
            id="console-distro-alt"
            class="text-[var(--fg-secondary)] truncate"
          >
            {distroList[0].altCommand || "N/A"}
          </code>
        </div>

        <!-- Right: Direct download links -->
        <div
          id="console-downloads-wrap"
          class="flex items-center gap-2 shrink-0 self-start sm:self-auto"
        >
          <span
            class="text-[10px] font-bold shrink-0"
            data-i18n="distroDirectLabel"
          >
            Direct:
          </span>
          <div
            id="console-downloads-container"
            class="flex items-center gap-1.5 flex-wrap"
          >
            {distroList[0].downloads?.map((dl) => (
              <a
                href={dl.url}
                class="px-2 py-0.5 rounded bg-[var(--bg-canvas)] border border-[var(--card-border)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] text-[10px] font-bold transition-colors"
                title={dl.title}
              >
                <span>{dl.label}</span>
                <span class="text-[var(--accent)] ml-0.5">↓</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. All Distros Single-Line Table Mode (Hidden by default) -->
  <div id="distro-all-table" class="distro-view-panel space-y-2.5 hidden">
    <div class="toon-card p-3 sm:p-4 bg-[var(--bg-surface)] divide-y divide-[var(--card-border)]">
      {distroList.map((distro) => (
        <div class="distro-table-row py-2.5 first:pt-0 last:pb-0 flex flex-col md:flex-row md:items-center justify-between gap-2.5">
          <!-- Left: Badge + Distro Name -->
          <div class="flex items-center gap-2 w-full md:w-52 shrink-0">
            <span
              class="px-1.5 py-0.5 rounded text-[9px] font-mono-tech font-bold text-[#0b0914] shrink-0"
              style={`background: ${distro.badgeColor};`}
            >
              {distro.badge}
            </span>
            <span class="font-cyber-display font-bold text-xs sm:text-sm text-[var(--fg-primary)] truncate">
              {distro.name}
            </span>
          </div>

          <!-- Middle: One-line Command Box -->
          <div class="flex-1 distro-code-box px-3 py-1.5 rounded-lg bg-[var(--bg-code)] border border-[var(--card-border)] flex items-center justify-between gap-2 overflow-hidden">
            <div class="font-mono-tech text-xs text-[#f5f3ff] overflow-x-auto whitespace-nowrap select-all flex-1 py-0.5 no-scrollbar">
              <span class="select-none mr-1.5 font-bold text-[var(--accent-pop)]">
                ❯
              </span>
              <span class="distro-cmd-text font-bold">{distro.command}</span>
            </div>
            <button
              type="button"
              class="copy-table-cmd-btn shrink-0 px-2 py-0.5 rounded bg-[var(--bg-elevated)] border border-[var(--card-border)] hover:border-[var(--ink-border)] font-mono-tech text-[10px] font-bold text-[var(--fg-primary)] cursor-pointer transition-colors"
              aria-label={`Copy install command for ${distro.name}`}
            >
              <span data-i18n="distroCopyBtn">COPY</span>
            </button>
          </div>

          <!-- Right: Direct download button(s) -->
          <div class="flex items-center gap-1.5 shrink-0 justify-end">
            {distro.downloads && distro.downloads.length > 0 ? (
              distro.downloads.map((dl) => (
                <a
                  href={dl.url}
                  class="px-2 py-1 rounded bg-[var(--bg-elevated)] border border-[var(--card-border)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] font-mono-tech text-[10px] font-bold transition-colors"
                  title={dl.title}
                >
                  <span>{dl.label}</span>
                  <span class="text-[var(--accent)] ml-0.5">↓</span>
                </a>
              ))
            ) : (
              <span
                class="font-mono-tech text-[10px] text-[var(--accent-mint)] font-bold"
                data-i18n="distroStatusReady"
              >
                ● READY
              </span>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- JSON Data payload for client-side instant reactive switching -->
<script
  id="distro-data-payload"
  type="application/json"
  set:html={JSON.stringify(distroList)}
></script>
<script>
  (() => {
    // 1. Load payload
    const rawData = document.getElementById("distro-data-payload")?.textContent;
    if (!rawData) return;
    let distros: any[] = [];
    try {
      distros = JSON.parse(rawData);
    } catch {
      return;
    }
    const distroMap = new Map(distros.map((d) => [d.id, d]));

    // 2. Elements for Quick Select Deck
    const pickerBtns =
      document.querySelectorAll<HTMLButtonElement>(".distro-picker-btn");
    const pickerList = Array.from(pickerBtns);

    const badgeEl = document.getElementById("console-distro-badge");
    const nameEl = document.getElementById("console-distro-name");
    const catEl = document.getElementById("console-distro-cat");
    const archEl = document.getElementById("console-distro-arch");
    const cmdEl = document.getElementById("console-distro-cmd");
    const altContainer = document.getElementById("console-alt-container");
    const altEl = document.getElementById("console-distro-alt");
    const downloadsContainer = document.getElementById(
      "console-downloads-container",
    );
    const downloadsWrap = document.getElementById("console-downloads-wrap");

    const selectDistro = (distroId: string, activeBtn?: HTMLButtonElement) => {
      const data = distroMap.get(distroId);
      if (!data) return;

      // Update active button state
      pickerBtns.forEach((btn) => {
        btn.classList.remove("active");
        btn.setAttribute("aria-selected", "false");
        btn.tabIndex = -1;
        btn.style.background = "var(--bg-surface)";
        btn.style.color = "var(--fg-secondary)";
        btn.style.borderColor = "var(--card-border)";
        btn.style.boxShadow = "none";
      });

      const targetBtn =
        activeBtn ||
        document.querySelector<HTMLButtonElement>(
          `[data-distro-id="${distroId}"]`,
        );
      if (targetBtn) {
        targetBtn.classList.add("active");
        targetBtn.setAttribute("aria-selected", "true");
        targetBtn.tabIndex = 0;
        targetBtn.style.background = "var(--accent)";
        targetBtn.style.color = "#0b0914";
        targetBtn.style.borderColor = "var(--ink-border)";
        targetBtn.style.boxShadow = "2px 2px 0px var(--toon-shadow)";
      }

      // Update console card content
      if (badgeEl) {
        badgeEl.textContent = data.badge;
        badgeEl.style.background = data.badgeColor;
      }
      if (nameEl) nameEl.textContent = data.name;
      if (catEl) catEl.textContent = `(${data.categoryName})`;
      if (archEl) archEl.textContent = data.architectures.join(", ");
      if (cmdEl) cmdEl.textContent = data.command;

      if (altContainer && altEl) {
        if (data.altCommand) {
          altContainer.style.display = "flex";
          altEl.textContent = data.altCommand;
        } else {
          altContainer.style.display = "none";
        }
      }

      if (downloadsContainer && downloadsWrap) {
        if (data.downloads && data.downloads.length > 0) {
          downloadsWrap.style.display = "flex";
          downloadsContainer.innerHTML = data.downloads
            .map(
              (dl: any) => `
              <a
                href="${dl.url}"
                class="px-2 py-0.5 rounded bg-[var(--bg-canvas)] border border-[var(--card-border)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] text-[10px] font-bold transition-colors"
                title="${dl.title}"
              >
                <span>${dl.label}</span>
                <span class="text-[var(--accent)] ml-0.5">↓</span>
              </a>
            `,
            )
            .join("");
        } else {
          downloadsWrap.style.display = "none";
          downloadsContainer.innerHTML = "";
        }
      }
    };

    pickerBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-distro-id");
        if (id) selectDistro(id, btn);
      });

      btn.addEventListener("keydown", (e) => {
        const index = pickerList.indexOf(btn);
        if (index === -1) return;
        let nextIndex = -1;

        if (e.key === "ArrowRight") {
          nextIndex = (index + 1) % pickerList.length;
        } else if (e.key === "ArrowLeft") {
          nextIndex = (index - 1 + pickerList.length) % pickerList.length;
        } else if (e.key === "Home") {
          nextIndex = 0;
        } else if (e.key === "End") {
          nextIndex = pickerList.length - 1;
        }

        if (nextIndex !== -1) {
          e.preventDefault();
          const target = pickerList[nextIndex];
          if (target) {
            target.focus();
            const id = target.getAttribute("data-distro-id");
            if (id) selectDistro(id, target);
          }
        }
      });
    });

    // 3. Mode Toggle: Quick Select vs All Distros
    const modeQuickBtn = document.getElementById("distro-mode-quick");
    const modeAllBtn = document.getElementById("distro-mode-all");
    const quickDeck = document.getElementById("distro-quick-deck");
    const allTable = document.getElementById("distro-all-table");

    const setMode = (mode: "quick" | "all") => {
      if (mode === "quick") {
        modeQuickBtn?.classList.add("active");
        modeQuickBtn?.setAttribute("aria-selected", "true");
        modeQuickBtn?.style.setProperty("background", "var(--accent)");
        modeQuickBtn?.style.setProperty("color", "#0b0914");
        modeQuickBtn?.style.setProperty("border-color", "var(--ink-border)");
        modeQuickBtn?.style.setProperty(
          "box-shadow",
          "1px 1px 0px var(--toon-shadow)",
        );

        modeAllBtn?.classList.remove("active");
        modeAllBtn?.setAttribute("aria-selected", "false");
        modeAllBtn?.style.setProperty("background", "transparent");
        modeAllBtn?.style.setProperty("color", "var(--fg-secondary)");
        modeAllBtn?.style.setProperty("border-color", "transparent");
        modeAllBtn?.style.setProperty("box-shadow", "none");

        quickDeck?.classList.remove("hidden");
        allTable?.classList.add("hidden");
      } else {
        modeAllBtn?.classList.add("active");
        modeAllBtn?.setAttribute("aria-selected", "true");
        modeAllBtn?.style.setProperty("background", "var(--accent)");
        modeAllBtn?.style.setProperty("color", "#0b0914");
        modeAllBtn?.style.setProperty("border-color", "var(--ink-border)");
        modeAllBtn?.style.setProperty(
          "box-shadow",
          "1px 1px 0px var(--toon-shadow)",
        );

        modeQuickBtn?.classList.remove("active");
        modeQuickBtn?.setAttribute("aria-selected", "false");
        modeQuickBtn?.style.setProperty("background", "transparent");
        modeQuickBtn?.style.setProperty("color", "var(--fg-secondary)");
        modeQuickBtn?.style.setProperty("border-color", "transparent");
        modeQuickBtn?.style.setProperty("box-shadow", "none");

        quickDeck?.classList.add("hidden");
        allTable?.classList.remove("hidden");
      }
    };

    modeQuickBtn?.addEventListener("click", () => setMode("quick"));
    modeAllBtn?.addEventListener("click", () => setMode("all"));

    // 4. One-Click Copy Buttons
    const copyConsoleBtn = document.getElementById("copy-console-cmd-btn");
    const copyConsoleLabel = document.getElementById("copy-console-label");

    copyConsoleBtn?.addEventListener("click", async () => {
      const text = cmdEl?.textContent?.trim() || "";
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const isZh =
          document.documentElement.getAttribute("data-lang") === "zh-CN";
        if (copyConsoleLabel) {
          copyConsoleLabel.textContent = isZh ? "已复制!" : "COPIED!";
          copyConsoleBtn.style.color = "var(--accent-mint)";
          setTimeout(() => {
            const isZhNow =
              document.documentElement.getAttribute("data-lang") === "zh-CN";
            copyConsoleLabel.textContent = isZhNow ? "复制" : "COPY";
            copyConsoleBtn.style.color = "";
          }, 2000);
        }
      } catch {}
    });

    const copyTableBtns = document.querySelectorAll<HTMLButtonElement>(
      ".copy-table-cmd-btn",
    );
    copyTableBtns.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const row = btn.closest(".distro-code-box");
        const text =
          row?.querySelector(".distro-cmd-text")?.textContent?.trim() || "";
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          const isZh =
            document.documentElement.getAttribute("data-lang") === "zh-CN";
          const labelSpan = btn.querySelector("[data-i18n]") || btn;
          labelSpan.textContent = isZh ? "已复制!" : "COPIED!";
          btn.style.color = "var(--accent-mint)";
          setTimeout(() => {
            const isZhNow =
              document.documentElement.getAttribute("data-lang") === "zh-CN";
            labelSpan.textContent = isZhNow ? "复制" : "COPY";
            btn.style.color = "";
          }, 2000);
        } catch {}
      });
    });
  })();
</script>

<style>
  .linux-distros-section {
    padding-block: 2rem;
    scroll-margin-top: 5rem;
  }

  .distro-picker-btn {
    min-height: 2.5rem;
    box-sizing: border-box;
  }

  .distro-code-box {
    box-sizing: border-box;
  }

  .no-scrollbar {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>
