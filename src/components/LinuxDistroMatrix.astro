      "curl -fsSL https://cdn.bitty.run/bitty/install/install.sh | bash",
    description:
      "Official signed .deb packages with complete desktop integration, systemd user service hooks, and automatic Wayland session detection.",
    architectures: ["amd64 (x86_64)", "arm64 (aarch64)"],
    downloads: [
      {
        label: "bitty_amd64.deb",
        url: "https://cdn.bitty.run/bitty/releases/bitty_amd64.deb",
        title: "Download Debian/Ubuntu amd64 package",
      },
      {
        label: "bitty_arm64.deb",
        url: "https://cdn.bitty.run/bitty/releases/bitty_arm64.deb",
        title: "Download Debian/Ubuntu arm64 package",
      },
    ],
  },
  {
    id: "fedora-rhel",
    name: "Fedora & RHEL",
    family: "fedora",
    categoryName: "Fedora & Red Hat Family",
    badge: "DNF / RPM",
    badgeColor: "var(--accent-violet)",
