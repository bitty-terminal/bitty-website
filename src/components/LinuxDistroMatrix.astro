---
// src/components/LinuxDistroMatrix.astro
// Universal Linux Packaging & Distribution Matrix for Bitty Terminal.
// Cyber-Pop & Manga Bento style with full keyboard accessibility.

interface DistroDownload {
  label: string;
  url: string;
  title: string;
}

interface DistroEntry {
  id: string;
  name: string;
  family:
    | "arch"
    | "debian"
    | "fedora"
    | "suse"
    | "alpine"
    | "nix"
    | "source"
    | "universal";
  categoryName: string;
  badge: string;
  badgeColor: string;
  sticker: string;
  distros: string[];
  command: string;
  altCommand?: string;
  description: string;
  architectures: string[];
  downloads?: DistroDownload[];
}

const distroList: DistroEntry[] = [
  {
    id: "arch",
    name: "Arch Linux & CachyOS",
    family: "arch",
    categoryName: "Arch & Derivatives",
    badge: "AUR",
    badgeColor: "var(--accent-mint)",
    sticker: "★ PACMAN & AUR // BLEEDING EDGE",
    distros: ["Arch Linux", "CachyOS", "Manjaro", "EndeavourOS", "Garuda"],
    command: "paru -S bitty-bin",
    altCommand: "yay -S bitty-bin",
    description:
      "Automated AUR packaging with x86-64-v3/v4 hardware optimizations for instant startup and 0B idle Piccolo Lua memory.",
    architectures: ["x86_64 (v3/v4)", "aarch64"],
    downloads: [
      {
        label: "PKGBUILD",
        url: "https://aur.archlinux.org/packages/bitty-bin",
        title: "View AUR Package Build",
      },
      {
        label: ".pkg.tar.zst",
        url: "https://cdn.bitty.run/bitty/releases/bitty-linux-x86_64.pkg.tar.zst",
        title: "Download Prebuilt Pacman Package",
      },
    ],
  },
  {
    id: "debian-ubuntu",
    name: "Debian & Ubuntu",
    family: "debian",
    categoryName: "Debian & Ubuntu Family",
