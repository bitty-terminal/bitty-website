---
/**
 * Manual landing page: minimalist directory of the 6 manual sections.
 */
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import { getManualNavGroups } from "../lib/manualDocs.ts";
import "../styles/global.css";

type Locale = "en" | "zh-CN";
const { locale = "en" } = Astro.props as { locale?: Locale };
const isZh = locale === "zh-CN";
const groups = getManualNavGroups("", locale);
const docsPrefix = isZh ? "/zh-CN/docs" : "/docs";
const origin = Astro.site?.origin ?? "https://bitty.run";
const currentPath = `${docsPrefix}/`;
const alternatePath = isZh ? "/docs/" : "/zh-CN/docs/";
const title = isZh ? "Bitty 手册" : "Bitty Manual";
const description = isZh
  ? "安装、配置、插件与 Lua API 参考。"
  : "Installation, configuration, plugin, and Lua API reference.";
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={`${origin}${currentPath}`} />
    <link
      rel="alternate"
      hreflang={isZh ? "zh-CN" : "en"}
      href={`${origin}${currentPath}`}
    />
    <link
      rel="alternate"
      hreflang={isZh ? "en" : "zh-CN"}
      href={`${origin}${alternatePath}`}
    />
    <link rel="alternate" hreflang="x-default" href={`${origin}/docs/`} />
    <link rel="icon" type="image/x-icon" href="/icons/favicon.ico" />
    <title>{title} — Bitty</title>
    <script is:inline>
      try {
        const t = window.localStorage.getItem("bitty-theme");
        if (t === "dark" || t === "light") {
          document.documentElement.setAttribute("data-theme", t);
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {isZh ? "跳转到正文" : "Skip to content"}
    </a>
    <SiteHeader
      locale={locale}
      activeNav="docs"
      alternateHref={alternatePath}
    />
    <main id="main-content" class="manual-index" tabindex="-1">
      <header class="manual-index-header">
        <h1>{title}</h1>
        <p>{description}</p>
      </header>

      <div class="manual-index-grid">
        {groups.map((group, idx) => (
          <section
            class="manual-section-card"
            aria-labelledby={`section-${group.id}`}
          >
            <div class="section-card-head">
              <div class="section-title-group">
                <span class="section-index-num">0{idx + 1}</span>
                <h2 id={`section-${group.id}`}>{group.label}</h2>
              </div>
              <span class="section-count">{group.entries.length}</span>
            </div>
            <ul>
              {group.entries.map((entry) => (
                <li>
                  <a href={`${docsPrefix}/${entry.fullSlug}/`}>
                    <span class="entry-title">{entry.title}</span>
                    <span class="entry-slug">{entry.slug}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>

<style>
  .manual-index {
    width: min(var(--content-width), calc(100% - 2rem));
    margin-inline: auto;
    padding-block: 2rem 3.5rem;
  }

  .manual-index-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .manual-index-header h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .manual-index-header > p {
    margin: 0;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .manual-index-grid {
    columns: 1;
    column-gap: 1rem;
  }

  @media (min-width: 56rem) {
    .manual-index-grid {
      columns: 2;
    }
  }

  .manual-section-card {
    display: inline-block;
    width: 100%;
    margin-block-end: 1rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--card);
    break-inside: avoid;
  }

  .section-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
  }

  .section-title-group {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }

  .section-index-num {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .manual-section-card h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--fg-primary);
  }

  .section-count {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .manual-section-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .manual-section-card li + li {
    border-top: 1px solid var(--border-subtle);
  }

  .manual-section-card a {
    display: flex;
    min-block-size: 2.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-inline: 0.25rem;
    color: var(--fg-primary);
    text-decoration: none;
  }

  .manual-section-card a:hover {
    color: var(--accent);
  }

  .entry-title {
    font-size: 0.825rem;
  }

  .entry-slug {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  /* English body copy: match the optical size of CJK glyphs. */
  :global(html[lang="en"]) .manual-index-header p {
    font-size: 0.83rem;
  }

  :global(html[lang="en"]) .entry-title {
    font-size: 0.875rem;
  }
</style>
