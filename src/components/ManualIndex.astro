---
/**
 * Manual landing page: clean niri-style index of the manual sections.
 */
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import { getManualNavGroups } from "../lib/manualDocs.ts";
import "../styles/global.css";

type Locale = "en" | "zh-CN";
const { locale = "en" } = Astro.props as { locale?: Locale };
const isZh = locale === "zh-CN";
const groups = getManualNavGroups("", locale);
const docsPrefix = isZh ? "/zh-CN/docs" : "/docs";
const origin = Astro.site?.origin ?? "https://bitty.run";
const currentPath = `${docsPrefix}/`;
const alternatePath = isZh ? "/docs/" : "/zh-CN/docs/";
const title = isZh ? "Bitty 手册" : "Bitty Manual";
const description = isZh
  ? "安装、配置、插件与 Lua API 参考。"
  : "Installation, configuration, plugin, and Lua API reference.";
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={`${origin}${currentPath}`} />
    <link
      rel="alternate"
      hreflang={isZh ? "zh-CN" : "en"}
      href={`${origin}${currentPath}`}
    />
    <link
      rel="alternate"
      hreflang={isZh ? "en" : "zh-CN"}
      href={`${origin}${alternatePath}`}
    />
    <link rel="alternate" hreflang="x-default" href={`${origin}/docs/`} />
    <link rel="icon" type="image/x-icon" href="/icons/favicon.ico" />
    <title>{title} — Bitty</title>
    <script is:inline>
      try {
        const t = window.localStorage.getItem("bitty-theme");
        if (t === "dark" || t === "light") {
          document.documentElement.setAttribute("data-theme", t);
        }
      } catch {}
    </script>
  </head>
  <body class="site-body">
    <a class="skip-link" href="#main-content">
      {isZh ? "跳转到正文" : "Skip to content"}
    </a>
    <SiteHeader
      locale={locale}
      activeNav="docs"
      alternateHref={alternatePath}
    />
    <main id="main-content" class="manual-index" tabindex="-1">
      <header class="manual-index-header">
        <h1>{title}</h1>
        <p>{description}</p>
      </header>

      <div class="manual-sections">
        {groups.map((group) => (
          <section
            class="manual-section"
            aria-labelledby={`section-${group.id}`}
          >
            <h2 id={`section-${group.id}`}>{group.label}</h2>
            <ul>
              {group.entries.map((entry) => (
                <li>
                  <a href={`${docsPrefix}/${entry.fullSlug}/`}>
                    <span class="entry-title">{entry.title}</span>
                    <span class="entry-slug">{entry.slug}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>

<style>
  .site-body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--bg-canvas);
    color: var(--ink);
  }

  .manual-index {
    flex: 1 0 auto;
    width: min(48rem, calc(100% - 2rem));
    margin-inline: auto;
    padding-block: 2.75rem 4.5rem;
  }

  .manual-index-header {
    margin-bottom: 2.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .manual-index-header h1 {
    margin: 0 0 0.45rem;
    font-size: clamp(1.75rem, 3.5vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .manual-index-header > p {
    margin: 0;
    color: var(--fg-secondary);
    font-size: 0.96rem;
  }

  .manual-sections {
    display: grid;
    gap: 2rem;
  }

  .manual-section h2 {
    margin: 0 0 0.65rem;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .manual-section ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .manual-section li {
    border-bottom: 1px solid var(--line);
  }

  .manual-section a {
    display: flex;
    min-block-size: 2.4rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-inline: 0.25rem;
    color: var(--fg-primary);
    text-decoration: none;
  }

  .manual-section a:hover {
    color: var(--accent);
  }

  .entry-title {
    font-size: 0.92rem;
  }

  .entry-slug {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }
</style>
