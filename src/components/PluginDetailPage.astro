---
import BaseLayout from "../layouts/BaseLayout.astro";
import DocsBreadcrumbs from "./DocsBreadcrumbs.astro";
import DocsCodeEnhancer from "./DocsCodeEnhancer.astro";
import DocsToc from "./DocsToc.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteShell from "./SiteShell.astro";
import { localePath, type SiteLocale } from "../lib/i18n.ts";
import {
  getOfficialPluginBySlug,
  getPluginDetailHref,
} from "../lib/pluginDetails.ts";

type Props = {
  locale?: SiteLocale;
  slug: string;
};

const { locale = "en", slug } = Astro.props as Props;
const isZh = locale === "zh-CN";

const plugin = getOfficialPluginBySlug(slug);
if (!plugin) {
  throw new Error(`Official plugin not found for slug "${slug}"`);
}

const currentPath = getPluginDetailHref(locale, plugin.slug);
const alternatePath = getPluginDetailHref(
  isZh ? "en" : "zh-CN",
  plugin.slug,
);
const xDefaultPath = getPluginDetailHref("en", plugin.slug);
const pluginsHref = localePath(locale, "/plugins/");

const pageTitle = isZh
  ? `${plugin.name} — Bitty 官方插件`
  : `${plugin.name} — Bitty Official Plugin`;
const pageDescription =
  plugin.description || plugin.overview.summary || `${plugin.name} (${plugin.id})`;

const headings = [
  {
    depth: 2,
    slug: "overview",
    text: isZh ? "功能简介" : "Overview",
  },
  {
    depth: 2,
    slug: "install",
    text: isZh ? "安装与配置命令" : "Install & Configure",
  },
  {
    depth: 2,
    slug: "capabilities",
    text: isZh ? "能力授权" : "Capabilities",
  },
  {
    depth: 2,
    slug: "commands",
    text: isZh ? "命令与快捷键" : "Commands & Keybindings",
  },
  {
    depth: 2,
    slug: "configuration",
    text: isZh ? "配置项 ([settings])" : "Configuration ([settings])",
  },
] as const;

const installCommands = [
  `bitty plugin install ${plugin.id}`,
  `bitty plugin enable ${plugin.id}`,
  `bitty plugin config show ${plugin.id}`,
  `bitty plugin config scaffold ${plugin.id}`,
].join("\n");
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  currentPath={currentPath}
  alternatePath={alternatePath}
  xDefaultPath={xDefaultPath}
>
  <SiteHeader
    locale={locale}
    activeNav="plugins"
    alternateHref={alternatePath}
    currentPath={currentPath}
  />

  <SiteShell
    locale={locale}
    activeSection="plugins"
    currentPluginSlug={plugin.slug}
  >
    <main id="main-content" class="docs-main" tabindex="-1">
      <div class="docs-layout">
        <div class="docs-article">
          <DocsBreadcrumbs
            locale={locale}
            rootHref={pluginsHref}
            rootLabel={isZh ? "插件" : "Plugins"}
            sectionLabel={plugin.name}
          />

          <DocsToc headings={headings} locale={locale} />

        <article class="prose bitty-prose">
          <h1>{plugin.name}</h1>

          <p class="plugin-meta-line">
            <code>{plugin.id}</code>
            <span aria-hidden="true">·</span>
            <span>v{plugin.version}</span>
            <span aria-hidden="true">·</span>
            <span>{plugin.license}</span>
            <span aria-hidden="true">·</span>
            <span>bitty {plugin.compat.bitty}</span>
            <span aria-hidden="true">·</span>
            <span>plugin-api {plugin.compat.pluginApi}</span>
            <span aria-hidden="true">·</span>
            <a
              href={plugin.repository}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
            </a>
          </p>

          <h2 id="overview">{isZh ? "功能简介" : "Overview"}</h2>
          {plugin.description && <p>{plugin.description}</p>}
          {
            plugin.overview.summary &&
              plugin.overview.summary !== plugin.description && (
                <p>{plugin.overview.summary}</p>
              )
          }
          {
            plugin.overview.highlights.length > 0 && (
              <ul>
                {plugin.overview.highlights.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )
          }

          <h2 id="install">{isZh ? "安装与配置命令" : "Install & Configure"}</h2>
          <pre><code>{installCommands}</code></pre>
          <p>
            {
              isZh ? (
                <>
                  配置文件路径：<code>~/.config/bitty/plugins/{plugin.id}.lua</code>
                </>
              ) : (
                <>
                  Configuration file path:{" "}
                  <code>~/.config/bitty/plugins/{plugin.id}.lua</code>
                </>
              )
            }
          </p>

          <h2 id="capabilities">{isZh ? "能力授权" : "Capabilities"}</h2>
          {
            plugin.capabilities.length > 0 ? (
              <ul>
                {plugin.capabilities.map((cap) => (
                  <li>
                    <code>{cap}</code>
                  </li>
                ))}
              </ul>
            ) : (
              <p>
                {isZh
                  ? "该插件未声明额外能力授权。"
                  : "This plugin declares no additional capabilities."}
              </p>
            )
          }

          <h2 id="commands">
            {isZh ? "命令与快捷键" : "Commands & Keybindings"}
          </h2>
          {
            plugin.commands.length > 0 ? (
              <div class="table-scroll" tabindex="0">
                <table>
                  <thead>
                    <tr>
                      <th>{isZh ? "命令" : "Command"}</th>
                      <th>{isZh ? "说明" : "Description"}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {plugin.commands.map((cmd) => (
                      <tr>
                        <td>
                          <code>{cmd.id}</code>
                        </td>
                        <td>{cmd.description || cmd.title}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <p>
                {isZh
                  ? "该插件未声明可调用命令。"
                  : "This plugin declares no commands."}
              </p>
            )
          }

          {
            plugin.keybindings.length > 0 ? (
              <div class="table-scroll" tabindex="0">
                <table>
                  <thead>
                    <tr>
                      <th>{isZh ? "快捷键" : "Chord"}</th>
                      <th>{isZh ? "命令 / 动作" : "Command / Action"}</th>
                      <th>{isZh ? "上下文" : "Context"}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {plugin.keybindings.map((kb) => (
                      <tr>
                        <td>
                          <code>{kb.chord}</code>
                        </td>
                        <td>
                          <code>{kb.command}</code>
                        </td>
                        <td>
                          <code>{kb.context}</code>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <p>
                {isZh
                  ? "该插件默认不绑定全局快捷键；可在用户配置中自行绑定上述命令。"
                  : "This plugin installs no default keybindings; bind any command above in your user config."}
              </p>
            )
          }

          <h2 id="configuration">
            {isZh ? "配置项 ([settings])" : "Configuration ([settings])"}
          </h2>
          {
            plugin.settings.length > 0 ? (
              <div class="table-scroll" tabindex="0">
                <table>
                  <thead>
                    <tr>
                      <th>{isZh ? "配置键" : "Key"}</th>
                      <th>{isZh ? "类型" : "Type"}</th>
                      <th>{isZh ? "默认值" : "Default"}</th>
                      <th>{isZh ? "说明" : "Description"}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {plugin.settings.map((setting) => (
                      <tr>
                        <td>
                          <code>{setting.key}</code>
                        </td>
                        <td>
                          <code>{setting.type}</code>
                        </td>
                        <td>
                          <code>{setting.default}</code>
                        </td>
                        <td>{setting.description || "—"}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <p>
                {isZh
                  ? "该插件未声明 [settings] 配置项。"
                  : "This plugin declares no [settings] keys."}
              </p>
            )
          }
        </article>
      </div>
    </div>
  </main>
  </SiteShell>

  <DocsCodeEnhancer />
</BaseLayout>

<style>
  .plugin-meta-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    color: var(--fg-secondary);
    font-size: var(--text-sm);
  }
</style>
