---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteShell from "./SiteShell.astro";
import { getExtensionCatalog } from "../lib/extensionCatalog.ts";
import { localePath, type SiteLocale } from "../lib/i18n.ts";
import { getPluginDetailHref } from "../lib/pluginDetails.ts";

type Props = {
  locale?: SiteLocale;
};

const { locale = "en" } = Astro.props as Props;
const isZh = locale === "zh-CN";
const catalog = getExtensionCatalog(locale);

const currentPath = localePath(locale, "/plugins/");
const alternatePath = localePath(isZh ? "en" : "zh-CN", "/plugins/");
const manualPluginsHref = localePath(locale, "/docs/plugins/getting-started/");
const manualSandboxHref = localePath(
  locale,
  "/docs/plugins/capabilities-and-sandbox/",
);
const manualExtensionsHref = localePath(locale, "/docs/extensions/overview/");

const pageTitle = isZh
  ? "插件与原生扩展 — Bitty"
  : "Plugins & Native Extensions — Bitty";
const pageDescription = isZh
  ? "Bitty 双层扩展体系：L1 原生 Rust 扩展与 L2 Phodopus Lua 5.4 沙箱插件。"
  : "Bitty's two-tier plugin architecture: L1 native Rust extensions and L2 sandboxed Phodopus Lua 5.4 plugins.";
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  currentPath={currentPath}
  alternatePath={alternatePath}
>
  <SiteHeader
    locale={locale}
    activeNav="plugins"
    alternateHref={alternatePath}
    currentPath={currentPath}
  />

  <SiteShell locale={locale} activeSection="plugins">
    <main id="main-content" class="niri-main" tabindex="-1">
    <article class="niri-prose">
      <h1>{isZh ? "插件与原生扩展" : "Plugins & Native Extensions"}</h1>

      {
        isZh ? (
          <p>
            Bitty 采用双层扩展架构：<strong>L1 原生 Rust 扩展</strong>负责图形解码、进程监管、IPC、无障碍与 AI 等系统级能力；<strong>L2 沙箱 Lua 插件</strong>运行在燃料计量的无栈 Phodopus Lua 5.4 虚拟机中，通过{" "}
            <code>bitty-plugin.toml</code> 显式声明能力授权，零默认权限、零 VM 延迟激活。
          </p>
        ) : (
          <p>
            Bitty separates extensions into two tiers:{" "}
            <strong>L1 Native Rust Extensions</strong> handle system-level
            mechanics (graphics, process supervision, IPC, accessibility, AI),
            while <strong>L2 Sandboxed Lua Plugins</strong> run inside a
            fuel-metered stackless Phodopus Lua 5.4 VM with explicit{" "}
            <code>bitty-plugin.toml</code> capability grants and zero-VM lazy
            activation.
          </p>
        )
      }

      <ul>
        <li>
          <a href={manualPluginsHref}>
            {isZh ? "插件开发入门" : "Getting Started with Plugins"}
          </a>
        </li>
        <li>
          <a href={manualSandboxHref}>
            {isZh ? "能力清单与沙箱隔离" : "Capabilities & Sandboxing"}
          </a>
        </li>
        <li>
          <a href={manualExtensionsHref}>
            {isZh ? "扩展目录与安装状态" : "Extension Catalog & Install Status"}
          </a>
        </li>
        <li>
          <a
            href="https://github.com/bitty-terminal/bitty-plugin-sdk"
            target="_blank"
            rel="noopener noreferrer"
          >
            bitty-plugin-sdk (GitHub)
          </a>
        </li>
      </ul>

      <h2>{isZh ? "常用 CLI 命令" : "Quick CLI"}</h2>
      <pre><code>bitty plugin list
bitty plugin install bitty-terminal.bar
bitty plugin enable bitty-terminal.bar
bitty ext status</code></pre>

      <h2>
        {
          isZh
            ? `官方 Lua 插件 (${catalog.luaPlugins.length})`
            : `Official Lua Plugins (${catalog.luaPlugins.length})`
        }
      </h2>
      <div class="table-scroll" tabindex="0">
        <table>
          <thead>
            <tr>
              <th>{isZh ? "插件" : "Plugin"}</th>
              <th>{isZh ? "说明" : "Summary"}</th>
              <th>{isZh ? "链接" : "Links"}</th>
            </tr>
          </thead>
          <tbody>
            {
              catalog.luaPlugins.map((plugin) => {
                const detailHref = getPluginDetailHref(locale, plugin.slug);
                return (
                  <tr>
                    <td>
                      <a href={detailHref}>
                        <code>{plugin.id}</code>
                      </a>
                    </td>
                    <td>{plugin.summary}</td>
                    <td>
                      <a href={detailHref}>
                        {isZh ? "详情" : "Details"}
                      </a>{" "}
                      ·{" "}
                      <a href={plugin.manualHref}>
                        {isZh ? "手册" : "Manual"}
                      </a>{" "}
                      ·{" "}
                      <a
                        href={plugin.repoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        GitHub
                      </a>
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>

      <h2>
        {
          isZh
            ? `L1 原生 Rust 扩展 (${catalog.nativeExtensions.length})`
            : `L1 Native Rust Extensions (${catalog.nativeExtensions.length})`
        }
      </h2>
      <div class="table-scroll" tabindex="0">
        <table>
          <thead>
            <tr>
              <th>{isZh ? "扩展" : "Extension"}</th>
              <th>{isZh ? "状态" : "Status"}</th>
              <th>{isZh ? "说明" : "Summary"}</th>
              <th>{isZh ? "链接" : "Links"}</th>
            </tr>
          </thead>
          <tbody>
            {
              catalog.nativeExtensions.map((ext) => (
                <tr>
                  <td>
                    <code>{ext.name}</code>
                  </td>
                  <td>{ext.statusLabel}</td>
                  <td>{ext.summary}</td>
                  <td>
                    <a href={ext.href}>{isZh ? "文档" : "Docs"}</a> ·{" "}
                    <a
                      href={ext.repoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      GitHub
                    </a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </article>
  </main>
  </SiteShell>
</BaseLayout>
