---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import { getExtensionCatalog } from "../lib/extensionCatalog.ts";
import { getUiMessages, localePath, type SiteLocale } from "../lib/i18n.ts";

type Props = {
  locale?: SiteLocale;
};

const { locale = "en" } = Astro.props as Props;
const isZh = locale === "zh-CN";
const t = getUiMessages(locale);
const catalog = getExtensionCatalog(locale);

const currentPath = localePath(locale, "/plugins/");
const alternatePath = localePath(isZh ? "en" : "zh-CN", "/plugins/");
const manualPluginsHref = localePath(locale, "/docs/plugins/getting-started/");
const manualSandboxHref = localePath(
  locale,
  "/docs/plugins/capabilities-and-sandbox/",
);
const manualExtensionsHref = localePath(locale, "/docs/extensions/overview/");

const pageTitle = isZh
  ? "插件与原生扩展 — Bitty"
  : "Plugins & Native Extensions — Bitty";
const pageDescription = isZh
  ? "Bitty 双层扩展体系：L1 原生 Rust 扩展与 L2 Phodopus Lua 5.4 沙箱插件目录。"
  : "Bitty's two-tier extensibility: 11 L1 Native Rust Extensions and 13 L2 Phodopus Lua 5.4 sandboxed plugins.";
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  currentPath={currentPath}
  alternatePath={alternatePath}
>
  <SiteHeader
    locale={locale}
    activeNav="plugins"
    currentPath={currentPath}
    alternateHref={alternatePath}
  />

  <main id="main-content" class="minimal-main" tabindex="-1">
    <header class="minimal-header">
      <h1>{isZh ? "插件与原生扩展" : "Plugins & Native Extensions"}</h1>
      <p class="minimal-lead">
        {
          isZh
            ? "Bitty 采用双层安全扩展模型：L1 原生 Rust 扩展（bitty ext）负责图形解码、IPC、无障碍与进程监管等系统级能力；L2 Phodopus Lua 5.4 插件运行于无栈沙箱虚拟机中，通过 bitty-plugin.toml 显式声明能力并遵循 RC-1 帧预算。使用 bitty plugin install 即可安装并启用官方插件。"
            : "Bitty separates system mechanics from UI policy across two tiers: L1 Native Rust Extensions (bitty ext) provide signed system capabilities, while L2 Phodopus Lua 5.4 Plugins run in a stackless sandbox with explicit bitty-plugin.toml capability grants and RC-1 frame budgets. Install official plugins with bitty plugin install."
        }
      </p>
      <nav class="quick-links" aria-label={isZh ? "相关文档" : "Related docs"}>
        <a href={manualPluginsHref}>
          {isZh ? "插件快速开始" : "Plugin quickstart"}
        </a>
        <span aria-hidden="true">·</span>
        <a href={manualSandboxHref}>
          {isZh ? "能力与沙箱" : "Capabilities & sandbox"}
        </a>
        <span aria-hidden="true">·</span>
        <a href={manualExtensionsHref}>
          {isZh ? "原生扩展概览" : "Native extensions"}
        </a>
        <span aria-hidden="true">·</span>
        <a
          href="https://github.com/bitty-terminal/bitty-plugins"
          target="_blank"
          rel="noopener noreferrer"
        >
          bitty-plugins ↗
        </a>
      </nav>
    </header>

    <section class="minimal-section" aria-labelledby="quickstart-title">
      <h2 id="quickstart-title">{isZh ? "常用命令" : "Quickstart"}</h2>
      <pre class="cli-block"><code>{`bitty plugin list
bitty plugin install bitty-terminal.bar && bitty plugin enable bitty-terminal.bar
bitty ext status`}</code></pre>
    </section>

    <section class="minimal-section" aria-labelledby="lua-plugins-title">
      <h2 id="lua-plugins-title">
        {
          isZh
            ? `官方 Lua 插件 (${catalog.luaPlugins.length})`
            : `Official Lua Plugins (${catalog.luaPlugins.length})`
        }
      </h2>
      <div class="table-scroll" tabindex="0">
        <table class="catalog-table">
          <thead>
            <tr>
              <th>{isZh ? "插件" : "Plugin"}</th>
              <th>{isZh ? "说明" : "Summary"}</th>
              <th>{isZh ? "链接" : "Links"}</th>
            </tr>
          </thead>
          <tbody>
            {catalog.luaPlugins.map((plugin) => (
              <tr class="lua-plugin-row">
                <td class="col-name">
                  <span class="item-title">{plugin.title}</span>
                  <code class="item-id">{plugin.id}</code>
                </td>
                <td class="col-summary">{plugin.summary}</td>
                <td class="col-links">
                  <a href={plugin.manualHref}>{t.statusDocs}</a>
                  <span aria-hidden="true">·</span>
                  <a
                    href={plugin.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    GitHub ↗
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="minimal-section" aria-labelledby="native-ext-title">
      <h2 id="native-ext-title">
        {
          isZh
            ? `L1 原生 Rust 扩展 (${catalog.nativeExtensions.length})`
            : `L1 Native Rust Extensions (${catalog.nativeExtensions.length})`
        }
      </h2>
      <div class="table-scroll" tabindex="0">
        <table class="catalog-table">
          <thead>
            <tr>
              <th>{isZh ? "扩展" : "Extension"}</th>
              <th>{isZh ? "说明" : "Summary"}</th>
              <th>{isZh ? "链接" : "Links"}</th>
            </tr>
          </thead>
          <tbody>
            {catalog.nativeExtensions.map((ext) => (
              <tr class="native-ext-row">
                <td class="col-name">
                  <span class="item-title">{ext.title}</span>
                  <code class="item-id">{ext.name}</code>
                </td>
                <td class="col-summary">{ext.summary}</td>
                <td class="col-links">
                  <a href={ext.href}>{t.statusDocs}</a>
                  <span aria-hidden="true">·</span>
                  <a
                    href={ext.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    GitHub ↗
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} />
</BaseLayout>

<style>
  .minimal-main {
    flex: 1 0 auto;
    width: min(52rem, calc(100% - 2rem));
    margin-inline: auto;
    padding-block: 2.75rem 4.5rem;
  }

  .minimal-header {
    margin-bottom: 2.25rem;
  }

  .minimal-header h1 {
    margin: 0 0 0.85rem;
    font-size: clamp(1.75rem, 3.5vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .minimal-lead {
    margin: 0 0 1.1rem;
    color: var(--fg-secondary);
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .quick-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.7rem;
    font-size: 0.9rem;
  }

  .quick-links a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }

  .quick-links a:hover {
    text-decoration: underline;
  }

  .quick-links span[aria-hidden="true"] {
    color: var(--fg-muted);
  }

  .minimal-section + .minimal-section {
    margin-top: 2.5rem;
  }

  .minimal-section h2 {
    margin: 0 0 0.85rem;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .cli-block {
    margin: 0;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .catalog-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }

  .catalog-table th,
  .catalog-table td {
    padding: 0.65rem 0.75rem;
    text-align: start;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }

  .catalog-table th {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .col-name {
    min-inline-size: 11rem;
  }

  .item-title {
    display: block;
    font-weight: 600;
    color: var(--ink);
  }

  .item-id {
    display: inline-block;
    margin-top: 0.15rem;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .col-summary {
    color: var(--fg-secondary);
    line-height: 1.55;
  }

  .col-links {
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  .col-links a {
    color: var(--accent);
    text-decoration: none;
  }

  .col-links a:hover {
    text-decoration: underline;
  }

  .col-links span[aria-hidden="true"] {
    margin-inline: 0.3rem;
    color: var(--fg-muted);
  }
</style>
