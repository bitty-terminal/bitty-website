---
/**
 * 16:10 Terminal Showcase Stage (ShowcaseStage.astro).
 *
 * Demonstrates:
 * 1. Dwindle Tiling & Declarative Lua GUI Panels (type="rich")
 * 2. Composer Modal (Alt+E, 64 KiB bracketed paste buffer)
 * 3. Two-Tier Architecture (Piccolo Lua Sandbox + Upstream Rust Coprocesses)
 * 4. High-DPR Media Slot Mode (ready for embedding real videos/GIFs/screenshots)
 */
---

<div class="showcase-stage space-y-4">
  <!-- Reel Selector Bar & Status Readout -->
  <div class="reel-selector-bar">
    <div
      class="reel-tabs font-mono-tech"
      role="tablist"
      aria-label="Showcase Demonstration Reels"
    >
      <button
        type="button"
        role="tab"
        id="reel-tab-tiling"
        aria-selected="true"
        aria-controls="reel-panel-tiling"
        tabindex="0"
        data-reel="tiling"
        class="reel-btn active"
      >
        <span class="reel-num">01</span>
        <span>Dwindle Tiling &amp; GUI Panels</span>
      </button>

      <button
        type="button"
        role="tab"
        id="reel-tab-composer"
        aria-selected="false"
        aria-controls="reel-panel-composer"
        tabindex="-1"
        data-reel="composer"
        class="reel-btn"
      >
        <span class="reel-num">02</span>
        <span>Composer Modal (Alt+E)</span>
      </button>

      <button
        type="button"
        role="tab"
        id="reel-tab-architecture"
        aria-selected="false"
        aria-controls="reel-panel-architecture"
        tabindex="-1"
        data-reel="architecture"
        class="reel-btn"
      >
        <span class="reel-num">03</span>
        <span>Phodopus Sandbox &amp; Coprocesses</span>
      </button>

      <button
        type="button"
        role="tab"
        id="reel-tab-rawslot"
        aria-selected="false"
        aria-controls="reel-panel-rawslot"
        tabindex="-1"
        data-reel="rawslot"
        class="reel-btn reel-btn-slot"
        title="Slot preview for real GIF/Video in Astro"
      >
        <span class="reel-icon">◆</span>
        <span>Media Slot (GIF/Video)</span>
      </button>
    </div>

    <div class="telemetry-badge font-mono-tech">
      <span class="dpr-indicator">High-DPR 120 FPS</span>
      <span class="gpu-indicator">wgpu (Vulkan / Metal / DX12)</span>
    </div>
  </div>

  <!-- Main 16:10 Terminal Showcase Box -->
  <div
    class="blueprint-box terminal-window-frame"
    role="region"
    aria-label="Bitty Interactive Terminal Showcase"
  >
    <!-- Window Chrome Header -->
    <div class="terminal-chrome font-mono-tech">
      <div class="chrome-left">
        <span class="dot dot-close" aria-hidden="true"></span>
        <span class="dot dot-min" aria-hidden="true"></span>
        <span class="dot dot-max" aria-hidden="true"></span>
        <span id="stage-window-title" class="chrome-title">
          bitty — workspace 1:dev (dwindle)
        </span>
      </div>
      <div class="chrome-right">
        <span class="kbd-cap">alt+n</span>
        <span class="kbd-cap">alt+a</span>
        <span class="kbd-cap">alt+e</span>
      </div>
    </div>

    <!-- REEL 01: Dwindle Tiling & GUI Panels -->
    <div
      id="reel-panel-tiling"
      class="reel-content reel-active"
      role="tabpanel"
      aria-labelledby="reel-tab-tiling"
    >
      <div class="tiling-grid">
        <!-- Left Master Panel: PTY Session -->
        <div class="tiling-panel master-pty">
          <div class="panel-header font-mono-tech">
            <span class="tag-pty">PANEL #1 · PTY STREAM (t:1)</span>
            <span class="tag-status">focused · border_color_focused</span>
          </div>

          <div class="panel-body font-mono-tech">
            <div class="terminal-row">
              <span class="prompt-arrow">➜</span>
              <span class="cmd-text">bitty inspect key alt+h</span>
            </div>
            <div class="cmd-output">
              bound: <span class="val-mint">true</span> · action:{" "}
              <span class="val-accent">goto_split:left</span> · owner: core
            </div>

            <div class="terminal-row mt-3">
              <span class="prompt-arrow">➜</span>
              <span class="cmd-text">bitty plugin list</span>
            </div>
            <div class="cmd-output plugin-list">
              <div>
                bitty-terminal.bar <span class="badge-active">[Active]</span>{" "}
                1.1 MiB / 32 MiB
              </div>
              <div>
                bitty-terminal.composer{" "}
                <span class="badge-loaded">[Loaded]</span> 0.4 MiB / 32 MiB
              </div>
              <div>
                custom.git-graph <span class="badge-lazy">[Installed]</span> 0
                Bytes (Phodopus Idle)
              </div>
            </div>
          </div>

          <div class="panel-footer font-mono-tech">
            <span class="footer-note">
              Microkernel decoupled view container
            </span>
            <span class="footer-tick">0.42ms frame tick</span>
          </div>
        </div>

        <!-- Right Dwindle Stack: Panel #2 (GUI) + Panel #3 (PTY Split) -->
        <div class="dwindle-stack">
          <!-- Panel #2: Declarative Lua GUI View -->
          <div class="tiling-panel gui-panel">
            <div class="panel-header font-mono-tech">
              <span class="tag-gui">PANEL #2 · LUA GUI VIEW (type="rich")</span>
              <span class="tag-vm">Phodopus VM</span>
            </div>

            <div class="gui-body">
              <p class="gui-desc">
                Panels are not limited to PTYs. Mount declarative{" "}
                <code>bitty.ui</code> trees directly into the Hyprland tiling
                grid:
              </p>
              <div class="gui-card font-mono-tech">
                <div class="card-row">
                  <span class="card-k">Upstream Coprocess:</span>
                  <span class="card-v val-mint">bitty-net (TOFU pinned)</span>
                </div>
                <div class="card-row">
                  <span class="card-k">Confinement:</span>
                  <span class="card-v">Linux Landlock v3</span>
                </div>
              </div>
            </div>

            <div class="panel-footer font-mono-tech">
              <span>bitty.panel.create(&#123; type = "rich" &#125;)</span>
              <span>wgpu composite</span>
            </div>
          </div>

          <!-- Panel #3: Secondary Tiled Split -->
          <div class="tiling-panel sub-split font-mono-tech">
            <div class="panel-header">
              <span class="tag-split">PANEL #3 · DWINDLE SPLIT (t:2)</span>
              <span>gaps_in = 6</span>
            </div>
            <div class="split-body">
              <span class="prompt-arrow">➜</span> bitty ctl workspace focus ws:1
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- REEL 02: Composer Modal (Alt+E) -->
    <div
      id="reel-panel-composer"
      class="reel-content hidden"
      role="tabpanel"
      aria-labelledby="reel-tab-composer"
      hidden
    >
      <div class="composer-container media-slot-grid">
        <div class="composer-modal blueprint-box font-mono-tech">
          <div class="modal-header">
            <div class="modal-title-group">
              <span class="badge-overlay">OVERLAY</span>
              <span class="modal-name">bitty-terminal.composer</span>
            </div>
            <span class="modal-cap">64 KiB cap · Bracketed Paste</span>
          </div>

          <div class="modal-editor">
            <div>
              git commit -m "feat(sandbox): fuel-metered Phodopus (Piccolo Fork)
              ticks" \
            </div>
            <div class="pl-4">--trailer "Reviewed-by: core-team"</div>
          </div>

          <div class="modal-footer">
            <span>
              <span class="kbd-cap">Ctrl+Enter</span> Submit to PTY
            </span>
            <span>
              <span class="kbd-cap">Alt+E</span> Edit in nvim/vim
            </span>
            <span>
              <span class="kbd-cap">Esc</span> Keep draft &amp; close
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- REEL 03: Two-Tier Architecture Diagram -->
    <div
      id="reel-panel-architecture"
      class="reel-content hidden"
      role="tabpanel"
      aria-labelledby="reel-tab-architecture"
      hidden
    >
      <div class="arch-container media-slot-grid">
        <div class="arch-grid font-mono-tech">
          <!-- Downstream -->
          <div class="arch-card blueprint-box">
            <div class="arch-tier-tag val-violet">Downstream Layer</div>
            <div class="arch-tier-title">
              Phodopus Lua Sandbox (Piccolo Fork)
            </div>
            <p class="arch-tier-desc">
              Stackless, fuel-metered VM with module loader (
              <code>require</code>), pattern matching, and hard memory ceilings.
              0B when <code>Installed</code>, 32 MiB quota when{" "}
              <code>Active</code>.
            </p>
          </div>

          <!-- Core -->
          <div class="arch-card blueprint-box border-core">
            <div class="arch-tier-tag val-accent">Core Engine</div>
            <div class="arch-tier-title">
              Rust Microkernel &amp; Terminal Truth
            </div>
            <p class="arch-tier-desc">
              wgpu compositor, VT parser decoupled from state machine, headless
              runtime, and zero-allocation hot paths. Extensions never touch the
              parser.
            </p>
          </div>

          <!-- Upstream -->
          <div class="arch-card blueprint-box">
            <div class="arch-tier-tag val-mint">Upstream Coprocess</div>
            <div class="arch-tier-title">Native Extensions (Wire v1)</div>
            <p class="arch-tier-desc">
              Zero-daemon architecture. Ephemeral stdio Wire Protocol v1
              coprocesses with Landlock confinement. Heavy tasks run isolated.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- REEL 04: Media Slot Mode (GIF / Video) -->
    <div
      id="reel-panel-rawslot"
      class="reel-content hidden"
      role="tabpanel"
      aria-labelledby="reel-tab-rawslot"
      hidden
    >
      <div class="media-slot-container media-slot-grid">
        <div class="slot-placeholder blueprint-box font-mono-tech">
          <div class="slot-icon">📽️</div>
          <div class="slot-title">High-DPR Screenshot &amp; GIF Media Slot</div>
          <p class="slot-desc">
            Designed for embedding WebP/MP4 recording assets or real terminal
            screenshots showcasing Hyprland tiling and rich plugin panels.
          </p>
          <div class="slot-meta">
            <span>16:10 Aspect Ratio</span> · <span>Retina 2x / 3x Ready</span>{" "}
            · <span>Zero-CLS Container</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const tabs = document.querySelectorAll<HTMLButtonElement>(".reel-btn");
    const panels = document.querySelectorAll<HTMLDivElement>(".reel-content");
    const windowTitle = document.getElementById("stage-window-title");

    const titles: Record<string, string> = {
      tiling: "bitty — workspace 1:dev (dwindle)",
      composer: "bitty — modal composer (Alt+E)",
      architecture: "bitty — microkernel architecture topology",
      rawslot: "bitty — live media recording slot",
    };

    const tabList = Array.from(tabs);

    const activateTab = (tab: HTMLButtonElement, focus = true) => {
      const target = tab.getAttribute("data-reel");
      if (!target) return;

      tabs.forEach((t) => {
        t.classList.remove("active");
        t.setAttribute("aria-selected", "false");
        t.tabIndex = -1;
      });
      tab.classList.add("active");
      tab.setAttribute("aria-selected", "true");
      tab.tabIndex = 0;
      if (focus) tab.focus();

      panels.forEach((p) => {
        if (p.id === `reel-panel-${target}`) {
          p.classList.remove("hidden");
          p.classList.add("reel-active");
          p.removeAttribute("hidden");
        } else {
          p.classList.add("hidden");
          p.classList.remove("reel-active");
          p.setAttribute("hidden", "");
        }
      });

      if (windowTitle && titles[target]) {
        windowTitle.textContent = titles[target];
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activateTab(tab, false));

      tab.addEventListener("keydown", (e) => {
        let newIndex = index;
        if (e.key === "ArrowRight" || e.key === "ArrowDown") {
          e.preventDefault();
          newIndex = (index + 1) % tabList.length;
        } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
          e.preventDefault();
          newIndex = (index - 1 + tabList.length) % tabList.length;
        } else if (e.key === "Home") {
          e.preventDefault();
          newIndex = 0;
        } else if (e.key === "End") {
          e.preventDefault();
          newIndex = tabList.length - 1;
        } else {
          return;
        }
        const nextTab = tabList[newIndex];
        if (nextTab) activateTab(nextTab, true);
      });
    });
  })();
</script>

<style>
  .showcase-stage {
    margin-block: 2.5rem;
  }

  .reel-selector-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .reel-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .reel-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    font-size: 0.75rem;
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    color: var(--fg-secondary);
    border: 1px solid var(--border-subtle);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .reel-btn:hover {
    color: var(--fg-primary);
    border-color: var(--border-focus);
  }

  .reel-btn.active {
    background: var(--bg-elevated);
    color: var(--fg-primary);
    border-color: var(--border-focus);
    font-weight: 600;
  }

  .reel-btn-slot {
    border-style: dashed;
    color: var(--fg-muted);
  }

  .reel-num {
    font-size: 0.65rem;
    color: var(--accent);
    font-weight: 700;
  }

  .reel-icon {
    font-size: 0.6rem;
    color: var(--accent-warm);
  }

  .telemetry-badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.7rem;
    color: var(--fg-muted);
  }

  .dpr-indicator {
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
  }

  /* Terminal Frame */
  .terminal-window-frame {
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-canvas);
    box-shadow: var(--shadow-ambient);
  }

  .terminal-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1rem;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.75rem;
  }

  .chrome-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .chrome-title {
    margin-left: 0.5rem;
    color: var(--fg-secondary);
  }

  .dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
  }

  .dot-close {
    background: #f7768e;
    opacity: 0.85;
  }
  .dot-min {
    background: #e0af68;
    opacity: 0.85;
  }
  .dot-max {
    background: #73daca;
    opacity: 0.85;
  }

  .chrome-right {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .reel-content {
    min-height: 420px;
  }

  .reel-content.hidden {
    display: none;
  }

  /* Tiling Grid (Reel 1) */
  .tiling-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    padding: 0.85rem;
  }

  @media (min-width: 48rem) {
    .tiling-grid {
      grid-template-columns: 7fr 5fr;
    }
  }

  .tiling-panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem;
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
  }

  .master-pty {
    border: 1.5px solid var(--border-focus);
    min-height: 380px;
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.7rem;
    color: var(--fg-muted);
  }

  .tag-pty {
    color: var(--accent);
    font-weight: 600;
  }
  .tag-gui {
    color: var(--accent-violet);
    font-weight: 600;
  }
  .tag-split {
    color: var(--accent-warm);
    font-weight: 600;
  }
  .tag-vm {
    color: var(--fg-muted);
  }

  .panel-body {
    padding-top: 0.75rem;
    font-size: 0.78rem;
    line-height: 1.6;
    flex: 1;
  }

  .terminal-row {
    display: flex;
    gap: 0.5rem;
    color: var(--fg-primary);
  }

  .prompt-arrow {
    color: var(--accent-mint);
    font-weight: 700;
  }
  .cmd-text {
    color: var(--fg-primary);
  }

  .cmd-output {
    padding-left: 0.75rem;
    margin-top: 0.35rem;
    border-left: 1px solid var(--border-subtle);
    color: var(--fg-secondary);
    font-size: 0.72rem;
  }

  .plugin-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .badge-active {
    color: var(--accent-mint);
    font-weight: 600;
  }
  .badge-loaded {
    color: var(--accent);
    font-weight: 600;
  }
  .badge-lazy {
    color: var(--fg-muted);
  }

  .val-mint {
    color: var(--accent-mint);
  }
  .val-accent {
    color: var(--accent);
  }
  .val-violet {
    color: var(--accent-violet);
  }

  .panel-footer {
    display: flex;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.68rem;
    color: var(--fg-muted);
  }

  .footer-tick {
    color: var(--accent);
  }

  .dwindle-stack {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .gui-panel {
    flex: 1;
  }

  .gui-body {
    padding-top: 0.5rem;
  }

  .gui-desc {
    font-size: 0.75rem;
    color: var(--fg-secondary);
    line-height: 1.5;
    margin-bottom: 0.65rem;
  }

  .gui-desc code {
    font-family: var(--font-mono);
    color: var(--fg-primary);
  }

  .gui-card {
    padding: 0.65rem;
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    font-size: 0.7rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .card-row {
    display: flex;
    justify-content: space-between;
  }

  .card-k {
    color: var(--fg-secondary);
  }
  .card-v {
    color: var(--fg-primary);
  }

  .sub-split {
    padding: 0.75rem 1rem;
    font-size: 0.75rem;
  }

  .split-body {
    padding-top: 0.4rem;
    color: var(--fg-secondary);
  }

  /* Reel 2: Composer */
  .composer-container {
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .composer-modal {
    max-width: 34rem;
    width: 100%;
    padding: 1.25rem;
    border-radius: var(--radius);
    border: 1.5px solid var(--border-focus);
    background: var(--bg-surface);
    box-shadow: var(--shadow-ambient);
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.75rem;
  }

  .modal-title-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .badge-overlay {
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-size: 0.65rem;
    font-weight: 700;
    background: var(--accent);
    color: #090b10;
  }

  .modal-name {
    font-weight: 600;
    color: var(--fg-primary);
  }

  .modal-cap {
    font-size: 0.7rem;
    color: var(--fg-muted);
  }

  .modal-editor {
    margin-block: 0.85rem;
    padding: 0.85rem;
    border-radius: var(--radius-sm);
    background: var(--bg-canvas);
    border: 1px solid var(--border-subtle);
    font-size: 0.78rem;
    color: var(--fg-primary);
    line-height: 1.6;
  }

  .modal-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 0.5rem;
    font-size: 0.72rem;
    color: var(--fg-secondary);
  }

  /* Reel 3: Architecture */
  .arch-container {
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .arch-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    max-width: 48rem;
    width: 100%;
  }

  @media (min-width: 48rem) {
    .arch-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .arch-card {
    padding: 1.25rem;
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .border-core {
    border-color: var(--border-focus);
  }

  .arch-tier-tag {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
  }

  .arch-tier-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--fg-primary);
  }

  .arch-tier-desc {
    font-size: 0.74rem;
    color: var(--fg-secondary);
    line-height: 1.6;
  }

  /* Reel 4: Raw Slot */
  .media-slot-container {
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .slot-placeholder {
    max-width: 32rem;
    width: 100%;
