---
type Props = {
  locale?: "en" | "zh-CN";
};

const { locale = "en" } = Astro.props as Props;
const isZh = locale === "zh-CN";
---

<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <strong>bitty</strong>
      <span>
        {isZh ? "可编程终端工作区" : "Programmable terminal workspace"}
      </span>
    </div>
    <nav aria-label={isZh ? "页脚导航" : "Footer navigation"}>
      <a href={isZh ? "/zh-CN/docs/" : "/docs/"}>{isZh ? "手册" : "Manual"}</a>
      <a
        href="https://github.com/bitty-terminal/bitty"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
      <a
        href="https://cdn.bitty.run/manual/bitty-manual/manifest.json"
        target="_blank"
        rel="noopener noreferrer"
      >
        R2
      </a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding: 1.5rem 1rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .footer-inner {
    width: min(72rem, 100%);
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .footer-inner > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: baseline;
  }
  .footer-inner strong {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.1rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
