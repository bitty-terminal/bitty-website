---
import { getUiMessages, type SiteLocale } from "../lib/i18n.ts";

type Props = {
  locale?: SiteLocale;
};

const { locale = "en" } = Astro.props as Props;
const isZh = locale === "zh-CN";
const t = getUiMessages(locale);
const homeHref = isZh ? "/zh-CN/" : "/";
const docsHref = isZh ? "/zh-CN/docs/" : "/docs/";
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href={homeHref} class="footer-logo">
        bitty
      </a>
      <span class="footer-sep" aria-hidden="true">
        ·
      </span>
      <span class="footer-tagline">{t.footerTagline}</span>
    </div>
    <nav aria-label={t.footerAria}>
      <a href={`${homeHref}#install`}>{t.footerInstall}</a>
      <a href={docsHref}>{t.footerManual}</a>
      <a
        href="https://plugins.bitty.run"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.footerPlugins}
      </a>
      <a
        href="https://github.com/bitty-terminal/bitty"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
      <a
        href="https://cdn.bitty.run/manual/bitty-manual/manifest.json"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.footerManifest}
      </a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    margin-inline: 0;
    border-top: 1px solid var(--line);
    background: var(--bg-surface);
    padding: 1.5rem 1rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
  }
  .footer-inner {
    width: min(var(--content-width), calc(100% - 2rem));
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }
  .footer-brand {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .footer-logo {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .footer-logo:hover {
    color: var(--accent);
  }
  .footer-sep {
    color: var(--line);
  }
  .footer-tagline {
    color: var(--fg-muted);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.15rem;
  }
  nav a {
    color: var(--fg-secondary);
    text-decoration: none;
    transition: color 0.14s ease;
  }
  nav a:hover {
    color: var(--accent);
  }
</style>
