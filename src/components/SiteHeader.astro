---
/**
 * Site header — Cyber-Pop × Cel-Shaded Toon navigation bar.
 *
 * Left: Official Bitty Favicon/Logo lockup + version pill.
 * Center: Site Search.
 * Right: Docs link, i18n language toggle, Light/Dark Arcade Toggle and GitHub.
 */
import SiteSearch from "./SiteSearch.astro";
import BittyLogo from "./BittyLogo.astro";
import { getVersions } from "../lib/versions.ts";

type Props = {
  version?: string;
  showSearch?: boolean;
  activeNav?: "hero" | "docs";
};

const {
  version = "latest",
  showSearch = true,
  activeNav,
} = Astro.props as Props;
const versions = getVersions();
const displayVersion = version === "latest" ? versions.latest : version;
const GITHUB_REPO_URL = "https://github.com/bitty-terminal/bitty";
---

<header class="sticky top-0 z-40 backdrop-blur-xl border-b-2 border-[var(--card-border)] bg-[var(--bg-glass)]">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3">
    <!-- Left: Official Bitty Logo / Favicon + Brand Lockup -->
    <div class="flex items-center gap-3">
      <a
        href="/"
        class="flex items-center gap-2.5 group focus:outline-none"
        aria-label="Bitty Home"
      >
        <div
          class="w-10 h-10 rounded-xl flex items-center justify-center border-2 border-[var(--ink-border)] bg-[var(--bg-elevated)] shadow-[2px_2px_0px_var(--toon-shadow)] group-hover:rotate-6 transition-transform overflow-hidden p-0.5"
          title="Bitty Official Logo"
        >
          <BittyLogo />
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="font-cyber-display font-bold text-xl tracking-tight text-[var(--fg-primary)]">
              BITTY
            </span>
            <span class="text-[10px] font-mono-tech font-bold px-1.5 py-0.5 rounded bg-[var(--accent-pop)] text-white">
              {displayVersion}
            </span>
          </div>
          <div class="text-[10px] font-mono-tech text-[var(--accent)] tracking-widest hidden sm:block">
            ビッティ // CYBER-TERM
          </div>
        </div>
      </a>
    </div>

    <!-- Center: Search -->
    {showSearch && (
      <div class="flex-1 max-w-md mx-2 min-w-0">
        <SiteSearch version={version} />
      </div>
    )}

    <!-- Right Controls: Docs, i18n Language, Light/Dark Arcade Toggle and GitHub -->
    <div class="flex items-center gap-2 font-mono-tech text-xs shrink-0">
      <!-- Docs Link -->
      <a
        href="/docs/latest/"
        class={`arcade-btn px-2.5 sm:px-3 py-1.5 flex items-center gap-1 font-bold ${
          activeNav === "docs"
            ? "bg-[var(--accent)] text-[#0b0914] shadow-[1px_1px_0px_var(--toon-shadow)]"
            : "bg-[var(--bg-surface)] text-[var(--fg-primary)] hover:text-[var(--accent)]"
        }`}
        aria-label="Documentation"
      >
        <span>📖</span>
        <span class="hidden sm:inline">Docs</span>
      </a>

      <!-- i18n Language Toggle Button -->
      <button
        type="button"
        id="lang-toggle-btn"
        class="arcade-btn px-2.5 py-1.5 bg-[var(--bg-surface)] text-[var(--fg-primary)] hover:text-[var(--accent)] flex items-center gap-1 font-bold cursor-pointer select-none"
        aria-label="Switch language between English and Chinese"
        title="Switch language (EN / 中文)"
      >
        <span class="text-xs">🌐</span>
        <span id="lang-current-label">EN</span>
      </button>

      <!-- Arcade Light / Dark Switcher -->
      <button
        type="button"
        id="theme-toggle-btn"
        class="arcade-btn px-2.5 sm:px-3 py-1.5 bg-[var(--bg-surface)] text-[var(--fg-primary)] flex items-center gap-1.5 cursor-pointer font-bold select-none"
        aria-label="Toggle Light / Dark Mode"
        title="Toggle Light / Dark Mode"
      >
        <span
          id="theme-toggle-dot"
          class="w-2.5 h-2.5 rounded-full bg-[var(--accent)]"
        ></span>
        <span id="theme-toggle-label">☀️ Light</span>
      </button>

      <!-- GitHub Link -->
      <a
        href={GITHUB_REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="arcade-btn px-2.5 sm:px-3 py-1.5 bg-[var(--bg-surface)] text-[var(--fg-primary)] flex items-center gap-1.5 font-bold"
        title="GitHub Repository"
      >
        <svg
          class="w-3.5 h-3.5 fill-current"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
        </svg>
        <span class="hidden md:inline">GitHub</span>
      </a>
    </div>
  </div>
</header>

<script>
  (() => {
    // 1. Theme toggle logic
    const toggleBtn = document.getElementById("theme-toggle-btn");
    const toggleLabel = document.getElementById("theme-toggle-label");
    const toggleDot = document.getElementById("theme-toggle-dot");

    function applyTheme(theme: string) {
      document.documentElement.setAttribute("data-theme", theme);
      try {
        localStorage.setItem("bitty-theme", theme);
      } catch {}

      const isDark =
        theme === "akiba-cyber" || theme === "dark" || theme === "bitty-dark";
      if (toggleLabel) {
        toggleLabel.textContent = isDark ? "🌙 Dark" : "☀️ Light";
      }
      if (toggleDot) {
        toggleDot.style.background = isDark ? "#00f0ff" : "#ff2a6d";
      }
    }

    let initialTheme =
      document.documentElement.getAttribute("data-theme") || "shibuya-pop";
    if (
      initialTheme !== "akiba-cyber" &&
      initialTheme !== "dark" &&
      initialTheme !== "shibuya-pop" &&
      initialTheme !== "light"
    ) {
      initialTheme = "shibuya-pop";
    }

    applyTheme(initialTheme);

    toggleBtn?.addEventListener("click", () => {
      const current =
        document.documentElement.getAttribute("data-theme") || initialTheme;
      const next = current === "akiba-cyber" ? "shibuya-pop" : "akiba-cyber";
      applyTheme(next);
    });

    // 2. i18n language toggle logic
    const langBtn = document.getElementById("lang-toggle-btn");
    const langLabel = document.getElementById("lang-current-label");
    const pathname = window.location.pathname;
    const isZhDoc = pathname.includes("/zh-CN/") || pathname.endsWith("/zh-CN");
    const savedLang = (() => {
      try {
        return localStorage.getItem("bitty_lang");
      } catch {
        return null;
      }
    })();
    const currentDocLang =
      document.documentElement.getAttribute("data-lang") ||
      savedLang ||
      (isZhDoc ? "zh-CN" : "en");
    if (langLabel) {
      langLabel.textContent =
        currentDocLang === "zh-CN" || isZhDoc ? "中" : "EN";
    }

    langBtn?.addEventListener("click", () => {
      const cur = window.location.pathname;
      if (cur.includes("/docs/")) {
        if (cur.includes("/zh-CN/")) {
          // Switch zh-CN -> en
          try {
            localStorage.setItem("bitty_lang", "en");
          } catch {}
          window.location.href = cur.replace("/zh-CN/", "/");
        } else {
          // Switch en -> zh-CN
          try {
            localStorage.setItem("bitty_lang", "zh-CN");
          } catch {}
          const match = cur.match(/^\/docs\/([^/]+)\/(.*)$/);
          if (match) {
            window.location.href = `/docs/${match[1]}/zh-CN/${match[2]}`;
          } else {
            window.location.href =
              "/docs/latest/zh-CN/getting-started/quickstart/";
          }
        }
      } else {
        // Toggle language on the homepage in-place
        const curLang =
          document.documentElement.getAttribute("data-lang") || "en";
        const nextLang = curLang === "zh-CN" ? "en" : "zh-CN";
        window.dispatchEvent(
          new CustomEvent("bitty-lang-toggle", {
            detail: { nextLang },
          }),
        );
      }
    });

    // Listen for language update events
    window.addEventListener("bitty-lang-updated", ((
      e: CustomEvent<{ lang: string }>,
    ) => {
      if (langLabel && e.detail?.lang) {
        langLabel.textContent = e.detail.lang === "zh-CN" ? "中" : "EN";
      }
    }) as EventListener);
  })();
</script>

<style>
  .arcade-btn svg {
    fill: currentColor;
    color: inherit;
  }
</style>
