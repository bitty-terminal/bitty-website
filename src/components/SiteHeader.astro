---
/**
 * Site header — ghostty-style three-zone navigation bar.
 *
 * Left: the brand lockup (window-mark logo plus the Bitty word). Center:
 * the docs search box. Right: Docs, GitHub, and Download links. Link targets
 * are pinned canonical routes or external product URLs; no canonical prose is
 * copied here. The word beside the logo names the brand, so the image itself
 * is decorative.
 *
 * The Download link points at the GitHub releases page until the dedicated
 * download page lands (website#83).
 */
import BittyLogo from "./BittyLogo.astro";
import SiteSearch from "./SiteSearch.astro";

type Props = {
  /**
   * Raw version route segment of the rendering page (`latest`, `stable`, or
   * `x.y.z`). The search box resolves result links against it; pages without
   * a version context (home) use the `latest` default.
   */
  version?: string;
};

const { version = "latest" } = Astro.props as Props;

const GITHUB_REPO_URL = "https://github.com/bitty-terminal/bitty";
const GITHUB_RELEASES_URL = `${GITHUB_REPO_URL}/releases`;
---

<header class="site-header">
  <nav aria-label="Primary">
    <a class="brand" href="/" aria-label="Bitty home">
      <BittyLogo />
      <span class="brand-word">Bitty</span>
    </a>
    <div class="header-search">
      <SiteSearch version={version} />
    </div>
    <ul class="header-links">
      <li>
        <a class="header-link" href="/docs/latest/">
          Docs
        </a>
      </li>
      <li>
        <a class="header-github" href={GITHUB_REPO_URL}>
          GitHub
        </a>
      </li>
      <li>
        <a class="header-download" href={GITHUB_RELEASES_URL}>
          Download
        </a>
      </li>
    </ul>
  </nav>
</header>
