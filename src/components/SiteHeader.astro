---
/**
 * Site header.
 *
 * Minimal niri-docs style top bar: sidebar toggle + `bitty` brand on the left,
 * centered static manual search, and EN/中文 switcher, theme toggle, and GitHub
 * link on the right.
 */
import SiteSearch from "./SiteSearch.astro";
import BittyLogo from "./BittyLogo.astro";
import {
  getUiMessages,
  localePath,
  localizePath,
  type SiteLocale,
} from "../lib/i18n.ts";

type Props = {
  locale?: SiteLocale;
  showSearch?: boolean;
  activeNav?: "hero" | "docs" | "plugins" | "ai";
  alternateHref?: string;
  currentPath?: string;
};

const {
  locale = "en",
  showSearch = true,
  alternateHref,
  currentPath,
} = Astro.props as Props;
const isZh = locale === "zh-CN";
const t = getUiMessages(locale);
const GITHUB_REPO_URL = "https://github.com/bitty-terminal/bitty";
const homeHref = localePath(locale, "/");
const targetLocale: SiteLocale = isZh ? "en" : "zh-CN";
const languageHref =
  alternateHref ??
  localizePath(currentPath ?? Astro.url.pathname, targetLocale);
---

<header class="site-header-wrap">
  <div class="site-header">
    <nav aria-label={t.navAriaLabel}>
      <div class="header-left">
        <button
          type="button"
          id="sidebar-toggle-btn"
          class="header-icon-btn sidebar-toggle-btn"
          aria-expanded="false"
          aria-controls="site-sidebar"
          aria-label={t.sidebarToggle}
          title={t.sidebarToggle}
        >
          <svg
            class="header-svg-icon"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M2.5 4h11M2.5 8h11M2.5 12h11" />
          </svg>
        </button>

        <a href={homeHref} class="brand" aria-label={t.homeAriaLabel}>
          <BittyLogo />
          <span class="brand-name">bitty</span>
        </a>
      </div>

      {showSearch && (
        <div class="header-search">
          <SiteSearch locale={locale} />
        </div>
      )}

      <ul class="header-links">
        <li>
          <a
            href={languageHref}
            id="lang-toggle-btn"
            class="locale-switch-pill"
            aria-label={t.switchLocaleLabel}
            title={t.switchLocaleTitle}
          >
            <span class:list={{ "loc-active": !isZh }}>EN</span>
            <span class="loc-sep" aria-hidden="true">
              /
            </span>
            <span class:list={{ "loc-active": isZh }}>中文</span>
          </a>
        </li>
        <li>
          <button
            type="button"
            id="theme-toggle-btn"
            class="header-icon-btn theme-toggle"
            aria-label={t.toggleThemeLabel}
            title={t.toggleThemeTitle}
          >
            <svg
              class="header-svg-icon icon-sun"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="8" cy="8" r="3"></circle>
              <path d="M8 1.5v1.75M8 12.75v1.75M1.5 8h1.75M12.75 8h1.75M3.4 3.4l1.25 1.25M11.35 11.35l1.25 1.25M12.6 3.4l-1.25 1.25M4.65 11.35L3.4 12.6"></path>
            </svg>
            <svg
              class="header-svg-icon icon-moon"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M13.2 9.8A5.6 5.6 0 0 1 6.2 2.8a5.6 5.6 0 1 0 7 7z"></path>
            </svg>
          </button>
        </li>
        <li>
          <a
            href={GITHUB_REPO_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="header-github"
            title={t.githubTitle}
            aria-label={t.githubAriaLabel}
          >
            <svg
              class="github-mark"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
            </svg>
            <span class="nav-label">GitHub</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const btn = document.getElementById("theme-toggle-btn");

    const effectiveTheme = () => {
      const explicit = root.getAttribute("data-theme");
      return explicit === "dark" ? "dark" : "light";
    };

    const syncButtonState = () => {
      if (!btn) return;
      const current = effectiveTheme();
      btn.setAttribute("data-active-theme", current);
      btn.setAttribute("aria-pressed", String(current === "dark"));
    };

    try {
      const stored = window.localStorage.getItem("bitty-theme");
      if (stored === "dark" || stored === "light") {
        root.setAttribute("data-theme", stored);
      } else if (!root.hasAttribute("data-theme")) {
        root.setAttribute("data-theme", "light");
      }
    } catch {
      if (!root.hasAttribute("data-theme")) {
        root.setAttribute("data-theme", "light");
      }
    }

    syncButtonState();

    btn?.addEventListener("click", () => {
      const next = effectiveTheme() === "dark" ? "light" : "dark";
      root.classList.add("theme-switching");
      root.setAttribute("data-theme", next);
      void root.offsetHeight;
      root.classList.remove("theme-switching");
      try {
        window.localStorage.setItem("bitty-theme", next);
      } catch {
        // Ignore storage errors
      }
      syncButtonState();
    });

    const toggleBtn = document.getElementById("sidebar-toggle-btn");
    const closeBtn = document.getElementById("sidebar-close-btn");
    const sidebar = document.getElementById("site-sidebar");
    const backdrop = document.getElementById("site-sidebar-backdrop");
    const desktopMq = window.matchMedia("(min-width: 64rem)");

    try {
      if (window.localStorage.getItem("bitty-docs-left") === "collapsed") {
        root.setAttribute("data-left-collapsed", "true");
      }
    } catch {}

    const syncSidebarState = () => {
      if (!toggleBtn || !sidebar) return;
      if (desktopMq.matches) {
        const collapsed = root.getAttribute("data-left-collapsed") === "true";
        toggleBtn.setAttribute("aria-expanded", String(!collapsed));
        backdrop?.setAttribute("hidden", "");
      } else {
        const isOpen = !sidebar.hasAttribute("hidden");
        toggleBtn.setAttribute("aria-expanded", String(isOpen));
      }
    };

    const setSidebarOpen = (open) => {
      if (!sidebar || !toggleBtn) return;
      if (open) {
        sidebar.removeAttribute("hidden");
        backdrop?.removeAttribute("hidden");
        toggleBtn.setAttribute("aria-expanded", "true");
        closeBtn?.focus();
      } else {
        sidebar.setAttribute("hidden", "");
        backdrop?.setAttribute("hidden", "");
        toggleBtn.setAttribute("aria-expanded", "false");
      }
    };

    syncSidebarState();
    desktopMq.addEventListener("change", syncSidebarState);

    toggleBtn?.addEventListener("click", () => {
      if (desktopMq.matches) {
        const next = root.getAttribute("data-left-collapsed") !== "true";
        if (next) root.setAttribute("data-left-collapsed", "true");
        else root.removeAttribute("data-left-collapsed");
        const layout = document.querySelector(".docs-layout");
        if (layout) {
          if (next) layout.setAttribute("data-left-collapsed", "true");
          else layout.removeAttribute("data-left-collapsed");
        }
        try {
          window.localStorage.setItem(
            "bitty-docs-left",
            next ? "collapsed" : "open",
          );
        } catch {}
        syncSidebarState();
        return;
      }
      const isOpen = toggleBtn.getAttribute("aria-expanded") === "true";
      setSidebarOpen(!isOpen);
    });

    closeBtn?.addEventListener("click", () => {
      setSidebarOpen(false);
      toggleBtn?.focus();
    });

    backdrop?.addEventListener("click", () => {
      setSidebarOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (
        !desktopMq.matches &&
        event.key === "Escape" &&
        toggleBtn?.getAttribute("aria-expanded") === "true"
      ) {
        setSidebarOpen(false);
        toggleBtn.focus();
      }
    });
  })();
</script>

<style>
  .header-left {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .sidebar-toggle-btn {
    padding-inline: 0.5rem;
  }

  .brand-name {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .header-svg-icon {
    width: 0.88rem;
    height: 0.88rem;
    flex-shrink: 0;
  }

  .github-mark {
    width: 0.88rem;
    height: 0.88rem;
    flex-shrink: 0;
  }

  .theme-toggle {
    padding-inline: 0.5rem;
  }

  .theme-toggle .icon-sun {
    display: none;
  }

  .theme-toggle .icon-moon {
    display: block;
  }

  :global([data-theme="dark"]) .theme-toggle .icon-sun {
    display: block;
  }

  :global([data-theme="dark"]) .theme-toggle .icon-moon {
    display: none;
  }

  @media (width < 36rem) {
    .nav-label {
      position: absolute;
      overflow: hidden;
      clip-path: inset(50%);
      inline-size: 1px;
      block-size: 1px;
      white-space: nowrap;
    }
  }

  @media (width < 24rem) {
    .brand-name {
      display: none;
    }
  }
</style>
