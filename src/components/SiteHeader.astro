---
/**
 * Site header — presentation-only navigation into pinned canonical routes.
 * Link targets are versioned docs routes; no canonical prose is copied here.
 * The wordmark carries the mascot raster; the word beside it names the brand,
 * so the image itself is decorative.
 */
import BittyLogo from "./BittyLogo.astro";
import SiteSearch from "./SiteSearch.astro";

type Props = {
  /**
   * Raw version route segment of the rendering page (`latest`, `stable`, or
   * `x.y.z`). The search box resolves result links against it; pages without
   * a version context (home) use the `latest` default.
   */
  version?: string;
};

const { version = "latest" } = Astro.props as Props;
---

<header class="site-header">
  <nav aria-label="Primary">
    <a class="brand" href="/" aria-label="Bitty home">
      <BittyLogo />
      <span class="brand-word">Bitty</span>
    </a>
    <ul>
      <li>
        <a href="/#usage">Usage</a>
      </li>
      <li>
        <a href="/#configuration">Configuration</a>
      </li>
      <li>
        <a href="/#architecture">Architecture</a>
      </li>
      <li>
        <a href="/docs/latest/">All docs</a>
      </li>
    </ul>
    <SiteSearch version={version} />
  </nav>
</header>
