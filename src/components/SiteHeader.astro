---
/**
 * Site header.
 *
 * Uses the global three-zone header rules from `src/styles/global.css`
 * (`site-header` + `brand` + `header-search` + `header-links`). The previous
 * markup carried Tailwind utility classes, but this repository does not
 * install Tailwind, so those classes were inert and the search box collapsed
 * to a few pixels on narrow viewports.
 */
import SiteSearch from "./SiteSearch.astro";
import BittyLogo from "./BittyLogo.astro";

type Props = {
  locale?: "en" | "zh-CN";
  showSearch?: boolean;
  activeNav?: "hero" | "docs";
};

const { locale = "en", showSearch = true, activeNav } = Astro.props as Props;
const isZh = locale === "zh-CN";
const GITHUB_REPO_URL = "https://github.com/bitty-terminal/bitty";
const docsHref = isZh ? "/zh-CN/docs/" : "/docs/";
const languageHref = isZh ? "/" : "/zh-CN/";
---

<header class="site-header">
  <nav aria-label={isZh ? "站点导航" : "Site navigation"}>
    <a
      href={isZh ? "/zh-CN/" : "/"}
      class="brand"
      aria-label={isZh ? "Bitty 首页" : "Bitty home"}
    >
      <BittyLogo />
      <span>BITTY</span>
    </a>

    {showSearch && (
      <div class="header-search">
        <SiteSearch locale={locale} />
      </div>
    )}

    <ul class="header-links">
      <li>
        <a
          href={docsHref}
          class:list={["header-link", { "is-active": activeNav === "docs" }]}
        >
          <span aria-hidden="true">📖</span>
          <span class="nav-label">{isZh ? "手册" : "Docs"}</span>
        </a>
      </li>
      <li>
        <a
          href={languageHref}
          id="lang-toggle-btn"
          class="header-link"
          aria-label={
            isZh ? "切换到 EN（英文）" : "Switch to 中文 (Simplified Chinese)"
          }
          title={isZh ? "Read in English" : "阅读简体中文"}
        >
          <span aria-hidden="true">🌐</span>
          <span>{isZh ? "EN" : "中文"}</span>
        </a>
      </li>
      <li>
        <a
          href={GITHUB_REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="header-github"
          title="GitHub Repository"
          aria-label="Bitty on GitHub"
        >
          <svg
            class="github-mark"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
          </svg>
          <span class="nav-label">GitHub</span>
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .header-link,
  .header-github {
    gap: 0.35rem;
  }
  .header-link.is-active {
    color: var(--accent);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .github-mark {
    width: 0.9rem;
    height: 0.9rem;
  }
  @media (width < 23rem) {
    .brand > span:last-child {
      display: none;
    }
  }
  @media (width < 48rem) {
    .nav-label {
      position: absolute;
      overflow: hidden;
      clip-path: inset(50%);
      inline-size: 1px;
      block-size: 1px;
      white-space: nowrap;
    }
  }
</style>
