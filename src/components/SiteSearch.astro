---
/**
 * Site search box (CTX-0040): keyword search over docs articles.
 *
 * Zero-JS default is preserved: the form renders fully static (labelled
 * input, live-region status, empty result list, noscript fallback), and the
 * only inline script is a tiny one-shot loader plus `/` shortcut focus.
 */
type Props = {
  locale?: "en" | "zh-CN";
};

const { locale = "en" } = Astro.props as Props;
const isZh = locale === "zh-CN";
---

<form
  class="site-search"
  role="search"
  aria-label={isZh ? "搜索手册" : "Search manual"}
  data-site-search
  data-locale={locale}
>
  <label class="site-search-label" for="site-search-input">
    {isZh ? "搜索手册" : "Search manual"}
  </label>
  <div class="site-search-field">
    <svg
      class="site-search-icon"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <circle cx="7" cy="7" r="4.5"></circle>
      <path d="M10.4 10.4L13.8 13.8" stroke-linecap="round"></path>
    </svg>
    <input
      id="site-search-input"
      class="site-search-input"
      name="q"
      type="search"
      role="combobox"
      aria-autocomplete="list"
      aria-controls="site-search-results"
      aria-expanded="false"
      autocomplete="off"
      spellcheck="false"
      placeholder={isZh ? "搜索手册…" : "Search manual…"}
      data-search-input
      data-i18n-placeholder="searchPlaceholder"
    />
    <kbd class="site-search-kbd" aria-hidden="true">
      /
    </kbd>
  </div>
  <p
    id="site-search-status"
    class="site-search-status"
    role="status"
    aria-live="polite"
    data-search-status
  ></p>
  <ul
    id="site-search-results"
    class="site-search-results"
    role="listbox"
    aria-label={isZh ? "搜索结果" : "Search results"}
    hidden
    data-search-results
  ></ul>
  <noscript>
    <p class="site-search-fallback">
      <a href={locale === "zh-CN" ? "/zh-CN/docs/" : "/docs/"}>
        {isZh ? "浏览全部手册" : "Browse all documentation"}
      </a>
    </p>
  </noscript>
</form>

<script>
  const root = document.querySelector("[data-site-search]");
  if (root instanceof HTMLElement) {
    let loaded = false;
    const trigger = (): void => {
      if (loaded) return;
      loaded = true;
      root.removeEventListener("focusin", trigger);
      root.removeEventListener("input", trigger);
      void import("../lib/siteSearchBox.ts").then((module) => {
        module.initSiteSearch(root);
      });
    };
    root.addEventListener("focusin", trigger);
    root.addEventListener("input", trigger);

    window.addEventListener("keydown", (event) => {
      if (
        event.key === "/" &&
        !event.metaKey &&
        !event.ctrlKey &&
        !event.altKey
      ) {
        const active = document.activeElement;
        if (
          active instanceof HTMLInputElement ||
          active instanceof HTMLTextAreaElement ||
          (active instanceof HTMLElement && active.isContentEditable)
        ) {
          return;
        }
        const input = root.querySelector<HTMLInputElement>(
          "[data-search-input]",
        );
        if (input) {
          event.preventDefault();
          trigger();
          input.focus();
        }
      }
    });
  }
</script>

<style>
  .site-search {
    position: relative;
    inline-size: min(100%, 19rem);
  }

  .site-search-label {
    position: absolute;
    overflow: hidden;
    clip-path: inset(50%);
    inline-size: 1px;
    block-size: 1px;
    white-space: nowrap;
  }

  .site-search-field {
    position: relative;
    display: flex;
    align-items: center;
  }

  .site-search-icon {
    position: absolute;
    inset-inline-start: 0.7rem;
    width: 0.9rem;
    height: 0.9rem;
    color: var(--fg-muted);
    pointer-events: none;
  }

  .site-search-input {
    inline-size: 100%;
    min-block-size: var(--touch-target);
    padding-inline: 2.1rem 2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 0.84375rem;
    box-shadow: var(--shadow-xs);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .site-search-input::placeholder {
    color: var(--fg-muted);
  }

  .site-search-input:hover {
    border-color: var(--border-strong);
  }

  .site-search-input:focus {
    outline: none;
    border-color: var(--focus);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }

  .site-search-kbd {
    position: absolute;
    inset-inline-end: 0.55rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 1.25rem;
    height: 1.25rem;
    padding-inline: 0.3rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--bg-elevated);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1;
    pointer-events: none;
  }

  .site-search-input:focus + .site-search-kbd {
    opacity: 0;
  }

  .site-search-status {
    margin: 0.2rem 0 0;
    min-block-size: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }

  .site-search-status:empty {
    display: none;
  }

  .site-search-results {
    position: absolute;
    inset-inline: 0;
    inset-block-start: calc(100% + 0.35rem);
    z-index: 50;
    max-block-size: min(70vh, 26rem);
    margin: 0;
    padding: 0.35rem;
    overflow-block: auto;
    overscroll-behavior: contain;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: var(--shadow-lg);
  }

  .site-search-results[hidden] {
    display: none;
  }

  .site-search-results :global(li[role="option"] a) {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-xs);
    color: var(--ink);
    text-decoration: none;
    transition: background-color 0.12s ease;
  }

  .site-search-results :global(li[role="option"][aria-selected="true"] a),
  .site-search-results :global(li[role="option"] a:hover) {
    background: var(--bg-elevated);
  }

  .site-search-results :global(.site-search-title) {
    display: block;
    font-size: 0.84375rem;
    font-weight: 600;
    color: var(--fg-primary);
  }

  .site-search-results :global(.site-search-meta) {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--fg-muted);
  }

  .site-search-fallback {
    margin: 0.25rem 0 0;
    font-size: var(--text-xs);
  }
</style>
