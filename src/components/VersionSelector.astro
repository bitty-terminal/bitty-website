---
/**
 * Documentation version selector (RS-1 .. RS-5): presentation-only navigation.
 *
 * Data source: `src/content/versions.json` (RS-1 — single enumeration). Renders
 * one real link per hosted version in declared order, marks the current version
 * with `aria-current="page"`, and rewrites only the version segment of the
 * current route (RS-3), falling back to the target version's index when the
 * route cannot be rewritten. Copies no specification prose (LD-6).
 *
 * Why links and not a `<select>`: the rewrite rule lives in exactly one place,
 * `rewriteVersionInRoute()` in `../lib/versions.ts`. An earlier revision also
 * shipped a native `<select>` whose client script re-implemented the same
 * version-rewrite regex in TypeScript, so the routing rule had two
 * implementations that had to be kept in sync by hand — and the single-version
 * case rendered a one-option dropdown above a link to the same page, stating
 * the same thing twice. A link list needs no client script, works without
 * JavaScript, degrades correctly on keyboard navigation, and scales on its own
 * as versions are added to `versions.json`.
 */
import { getVersions, rewriteVersionInRoute } from "../lib/versions.ts";

const versions = getVersions();

type Props = {
  currentRoute: string; // e.g. /docs/0.1.0/specifications/foo/
  currentVersion: string; // e.g. 0.1.0
};

const { currentRoute, currentVersion } = Astro.props as Props;

function targetFor(toVersion: string): string {
  try {
    return rewriteVersionInRoute(currentRoute, toVersion);
  } catch {
    return `/docs/${toVersion}/`;
  }
}

const entries = versions.versions.map((entry) => ({
  label: entry.label,
  suffix: entry.prerelease ? " (prerelease)" : "",
  href: targetFor(entry.version),
  isCurrent: entry.version === currentVersion,
}));
---

<nav class="version-selector" aria-labelledby="version-selector-label">
  <span class="version-selector-label" id="version-selector-label">
    Version
  </span>
  <ul>
    {
      entries.map((entry) => (
        <li>
          <a
            class="version-link"
            href={entry.href}
            aria-current={entry.isCurrent ? "page" : undefined}
          >
            {entry.label}
            {entry.suffix}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .version-selector {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    margin-block: 0.5rem 0;
    padding-block: 0.5rem;
    border-block: 1px solid var(--line);
  }

  .version-selector-label {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .version-selector ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .version-selector ul a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch-target);
  }

  .version-link[aria-current="page"] {
    color: var(--ink);
    font-weight: 700;
  }
</style>
