{
  "name": "Bitty Manual",
  "version": "0.1.0",
  "default_locale": "en",
  "locales": ["en", "zh-CN"],
  "distribution": {
    "package": "bitty-manual",
    "cdn_base": "https://cdn.bitty.run/manual",
    "canonical_prefix": "manual/bitty-manual",
    "per_locale_bundle": "<locale>.tar.gz",
    "versioned_prefix": "v<version>",
    "legacy_compat": [
      "manual/manifest.json",
      "manual/<locale>/<section>/<file>.md",
      "manual/bitty-manual-latest.tar.gz",
      "manual/latest/..."
    ],
    "legacy_sunset": "dual-published until bitty doc and website cut over to canonical keys; removal is tracked follow-up work"
  },
