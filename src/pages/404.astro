---
/** Not-found page.
 *
 * It stays inside the normal shell so stale links have a clear path back to
 * the manual or the home page.
 */
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta
      name="description"
      content="This page does not exist. Search the Bitty documentation or start from the documentation map."
    />
    <link rel="icon" type="image/x-icon" href="/icons/favicon.ico" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/favicon-32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/icons/favicon-16.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/apple-touch-icon.png"
    />
    <title>Page not found | Bitty</title>
    <script is:inline>
      try {
        const t = window.localStorage.getItem("bitty-theme");
        if (t === "dark" || t === "light") {
          document.documentElement.setAttribute("data-theme", t);
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <SiteHeader alternateHref="/zh-CN/" />
    <main id="main-content" class="not-found" tabindex="-1">
      <article class="prose not-found-card">
        <p class="not-found-kicker">HTTP 404 // ROUTE NOT FOUND</p>
        <h1>Page not found</h1>
        <p>This address does not serve a page.</p>
        <p>
          Start from the <a href="/docs/">documentation map</a> or the{" "}
          <a href="/">Bitty home page</a>.
        </p>
        <p lang="zh-CN">
          此地址没有对应页面。请从<a href="/zh-CN/docs/">中文手册</a>或
          <a href="/zh-CN/">首页</a>开始。
        </p>
      </article>
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .not-found {
    width: min(46rem, calc(100% - 2rem));
    margin-inline: auto;
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }
  .not-found-card {
    padding: 2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    box-shadow: var(--shadow);
  }
  .not-found-kicker {
    margin: 0 0 0.5rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .not-found :global(a) {
    color: var(--accent);
  }
</style>
