---
/** Not-found page (website#131).
 *
 * The site moves documentation routes behind redirect families, so any link
 * older than the last rename lands here. It renders inside the normal shell -
 * the same header, search and footer - because a reader who arrives from a
 * stale URL needs a way forward, not a blank body.
 *
 * Served by `assets.not_found_handling: "404-page"` in `wrangler.jsonc`, which
 * is why the markup must stand on its own: it is the only recovery path for a
 * URL outside the redirect families.
 */
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta
      name="description"
      content="This page does not exist. Search the Bitty documentation or start from the documentation map."
    />
    <link rel="icon" type="image/x-icon" href="/icons/favicon.ico" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/favicon-32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/icons/favicon-16.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/apple-touch-icon.png"
    />
    <title>Page not found | Bitty</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main-content" class="docs-main" tabindex="-1">
      <article class="prose">
        <h1>Page not found</h1>
        <p>
          This address does not serve a page. Documentation routes change as the
          corpora converge, so an older link can land here.
        </p>
        <p>
          Start from the
          <a href="/docs/latest/">documentation map</a> or the
          <a href="/">Bitty home page</a>.
        </p>
      </article>
    </main>
    <SiteFooter />
  </body>
</html>
