---
import { getCollection, render } from "astro:content";
import "../../../styles/global.css";
import BackgroundCanvas from "../../../components/BackgroundCanvas.astro";
import DocsSidebar from "../../../components/DocsSidebar.astro";
import DocsBreadcrumbs from "../../../components/DocsBreadcrumbs.astro";
import DocsToc from "../../../components/DocsToc.astro";
import DocsPager from "../../../components/DocsPager.astro";
import DocsCodeEnhancer from "../../../components/DocsCodeEnhancer.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import VersionSelector from "../../../components/VersionSelector.astro";
import { getVersions, isValidVersionSegment } from "../../../lib/versions.ts";
import {
  getAllManualDocEntries,
  loadManualManifest,
  readManualRawMarkdown,
  type ManualDocEntry,
} from "../../../lib/manualDocs.ts";

export async function getStaticPaths() {
  const versions = getVersions();
  const manifest = loadManualManifest();
  const entries = getAllManualDocEntries(manifest);

  const versionSegments = [
    "latest",
    "stable",
    ...versions.versions.map((v) => v.version),
  ];

  const paths: Array<{
    params: { version: string; slug: string | undefined };
    props: {
      item: ManualDocEntry;
      version: string;
      canonicalSlug: string;
      locale: string;
      isIndex: boolean;
      allSlugs: string[];
    };
  }> = [];

  const allSlugs = entries.map((e) => e.fullSlug);

  for (const version of versionSegments) {
    // 1. Root /docs/${version}/ -> quickstart
    const firstItem = entries[0];
    paths.push({
      params: { version, slug: undefined },
      props: {
        item: firstItem,
        version,
        canonicalSlug: firstItem.fullSlug,
        locale: "en",
        isIndex: true,
        allSlugs,
      },
    });

    // 2. English docs
    for (const item of entries) {
      paths.push({
        params: { version, slug: item.fullSlug },
        props: {
          item,
          version,
          canonicalSlug: item.fullSlug,
          locale: "en",
          isIndex: false,
          allSlugs,
        },
      });
    }

    // 3. Chinese docs (zh-CN)
    for (const item of entries) {
      paths.push({
        params: { version, slug: `zh-CN/${item.fullSlug}` },
        props: {
          item,
          version,
          canonicalSlug: item.fullSlug,
          locale: "zh-CN",
          isIndex: false,
          allSlugs,
        },
      });
    }
  }

  return paths;
}

const { item, version, canonicalSlug, locale, allSlugs } = Astro.props as {
  item: ManualDocEntry;
  version: string;
  canonicalSlug: string;
  locale: string;
  isIndex: boolean;
  allSlugs: string[];
};

if (!isValidVersionSegment(version)) {
  throw new Response("Not Found", { status: 404 });
}

// Find matching entry from astro collection
const allDocs = await getCollection("docs");
const normId = `${locale.toLowerCase()}/${item.path.replace(/\.md$/, "")}`;
const entry =
  allDocs.find(
    (d) =>
      d.id === normId || d.id === `${locale}/${item.path.replace(/\.md$/, "")}`,
  ) ?? allDocs.find((d) => d.id === `en/${item.path.replace(/\.md$/, "")}`);

if (!entry) {
  throw new Error(`Manual entry not found for id "${normId}"`);
}

const { Content, headings } = await render(entry);
const rawMarkdown = readManualRawMarkdown(item.path, locale);
const versions = getVersions();
const currentRoute = `/docs/${version}/${canonicalSlug}/`;

// Target identities for VersionSelector
const targetIdentities = new Map<string, Set<string>>();
for (const v of versions.versions) {
  targetIdentities.set(v.version, new Set(allSlugs.map((s) => `/docs/${s}/`)));
}
---

<!doctype html>
<html lang={locale === "zh-CN" ? "zh-CN" : "en"} data-theme="bitty-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{item.title} — Bitty Manual ({version})</title>
    <meta
      name="description"
      content={`Bitty terminal official documentation: ${item.title} (${item.sectionTitle}).`}
    />
    <link rel="icon" type="image/x-icon" href="/icons/favicon.ico" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/favicon-32.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/apple-touch-icon.png"
    />
    <link
      rel="canonical"
      href={`https://bitty.run/docs/latest/${canonicalSlug}/`}
    />

    <script is:inline>
      (() => {
        const VALID_THEMES = [
          "bitty-dark",
          "tokyo-night",
          "catppuccin-mocha",
          "gruvbox-dark",
          "paper-light",
        ];
        let theme = "bitty-dark";
        try {
          const params = new URLSearchParams(window.location.search);
          const urlTheme = params.get("theme");
          if (urlTheme && VALID_THEMES.includes(urlTheme)) {
            theme = urlTheme;
          } else {
            let savedTheme = null;
            try {
              savedTheme = localStorage.getItem("bitty-theme");
            } catch {}
            if (savedTheme && VALID_THEMES.includes(savedTheme)) {
              theme = savedTheme;
            }
          }
        } catch {}
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    <BackgroundCanvas />
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <SiteHeader version={version} />
    <VersionSelector
      currentRoute={currentRoute}
      currentVersion={version}
      targetIdentities={targetIdentities}
    />

    <main id="main-content" class="docs-main" tabindex="-1">
      <div class="docs-layout">
        <DocsSidebar version={version} currentSlug={canonicalSlug} />
        <div class="docs-article">
          <header class="docs-header">
            <DocsBreadcrumbs
              version={version}
              slug={canonicalSlug}
              locale={locale}
              rawMarkdown={rawMarkdown}
            />
            <p class="eyebrow">
              {item.sectionTitle} · Bitty Manual ({version})
            </p>
          </header>
          <DocsToc headings={headings} />
          <article class="prose bitty-prose">
            <Content />
          </article>
          <DocsPager version={version} currentSlug={canonicalSlug} />
        </div>
      </div>
    </main>

    <SiteFooter />
    <DocsCodeEnhancer />
  </body>
</html>
