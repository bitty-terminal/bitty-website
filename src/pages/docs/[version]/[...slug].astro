---
import { getCollection, render } from "astro:content";
import "../../../styles/global.css";
import { sep } from "node:path";
import { assertValidRevisionPin } from "../../../lib/docsValidation.ts";
import { getVersions, isValidVersionSegment } from "../../../lib/versions.ts";
import {
  sourcePathToRouteIdentity,
  validateRouteCollisions,
} from "../../../lib/docsRoutes.ts";
import {
  buildLegacyAliases,
  loadMergedRedirects,
} from "../../../lib/redirects.ts";
import VersionSelector from "../../../components/VersionSelector.astro";

// Canonical slugs come from the single authoritative route mapper
// (`src/lib/docsRoutes.ts`, RM-6), resolved per entry from its source file
// path — never from the Astro glob id. Examples:
//   docs/README.md                -> "" (revision index)
//   docs/decisions/index.md       -> "decisions"
//   docs/decisions/README.md      -> "decisions/readme" (explicit slug)
//   docs/decisions/adrs/README.md -> "decisions/adrs/readme"
//   docs/projects/bitty/...       -> "projects/bitty/..." (partition kept)
//
// NOTE: import.meta.url points at the compiled chunk in dist/.prerender at
// build time, not at this source file, so the mirror is located by path
// invariant (<root>/src/content/docs) rather than relative to this module.
export async function getStaticPaths() {
  function sourcePathFromFilePath(filePath: string, id: string): string {
    const posix = filePath.split(sep).join("/");
    const marker = "src/content/docs/";
    const index = posix.lastIndexOf(marker);
    if (index === -1) {
      throw new Error(
        `Docs entry "${id}" is outside src/content/docs: ${filePath}`,
      );
    }
    return posix.slice(index + marker.length);
  }

  function slugFromSourceFile(
    filePath: string | undefined,
    id: string,
  ): string {
    if (filePath === undefined || filePath.length === 0) {
      throw new Error(`Docs entry "${id}" has no filePath`);
    }
    const sourcePath = sourcePathFromFilePath(filePath, id);
    const identity = sourcePathToRouteIdentity(sourcePath);
    const withoutDocs = identity.routeWithoutVersion.slice("/docs/".length);
    return withoutDocs.endsWith("/") ? withoutDocs.slice(0, -1) : withoutDocs;
  }

  assertValidRevisionPin();
  const versions = getVersions();
  const docs = await getCollection("docs");

  // Only eligible entries (website_publish:true after validation per LD-3)
  const eligible = docs.filter((e) => e.data.website_publish === true);

  // RM-4: two distinct eligible sources sharing one public route fail the
  // build here as well as in sync/check (same mapper, same rule).
  const eligibleSources = eligible.map((e) => {
    if (e.filePath === undefined || e.filePath.length === 0) {
      throw new Error(`Docs entry "${e.id}" has no filePath`);
    }
    return sourcePathFromFilePath(e.filePath, e.id);
  });
  validateRouteCollisions(eligibleSources);

  const canonical = new Map<string, (typeof eligible)[number]>();
  for (const entry of eligible) {
    const slug = slugFromSourceFile(entry.filePath, entry.id);
    const duplicate = canonical.get(slug);
    if (duplicate !== undefined) {
      throw new Error(
        `Duplicate docs route slug "${slug}": ${duplicate.id} and ${entry.id}`,
      );
    }
    canonical.set(slug, entry);
  }

  // RD-3: legacy aliases from the merged website + docs-owned redirect manifest.
  // Every alias 301s to the canonical route of the same version (see below).
  const aliases = buildLegacyAliases(
    [...canonical.keys()],
    await loadMergedRedirects(),
  );

  const versionSegments = [
    "latest",
    "stable",
    ...versions.versions.map((v) => v.version),
  ];

  const paths: Array<{
    params: { version: string; slug: string | undefined };
    props: {
      entry: (typeof eligible)[number];
      version: string;
      canonicalSlug: string;
      isLegacy: boolean;
    };
  }> = [];

  for (const version of versionSegments) {
    for (const [slug, entry] of canonical) {
      paths.push({
        params: { version, slug: slug === "" ? undefined : slug },
        props: { entry, version, canonicalSlug: slug, isLegacy: false },
      });
    }
    for (const [alias, canonicalSlug] of aliases) {
      const entry = canonical.get(canonicalSlug);
      if (entry === undefined) continue;
      paths.push({
        params: { version, slug: alias },
        props: { entry, version, canonicalSlug, isLegacy: true },
      });
    }
  }

  return paths;
}

const { entry, version, canonicalSlug, isLegacy } = Astro.props as {
  entry: Awaited<ReturnType<typeof getCollection>>[number];
  version: string;
  canonicalSlug: string;
  isLegacy: boolean;
};

if (!isValidVersionSegment(version)) {
  throw new Response("Not Found", { status: 404 });
}

// RD-3: an old published route resolves to the canonical route of the same
// version with a 301; the edge `dist/_redirects` table mirrors this mapping.
if (isLegacy) {
  return Astro.redirect(
    canonicalSlug === ""
      ? `/docs/${version}/`
      : `/docs/${version}/${canonicalSlug}/`,
    301,
  );
}

const { Content } = await render(entry);
const versions = getVersions();
const versionLabels = new Map(
  versions.versions.map((v) => [v.version, v.label]),
);

const slugParam = Astro.params.slug ?? "";
const currentRoute = `/docs/${version}/${slugParam}${slugParam ? "/" : ""}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{entry.data.title} — Bitty {version}</title>
    <meta name="description" content={entry.data.description} />
    {
      version !== versions.latest && (
        <link
          rel="canonical"
          href={currentRoute.replace(`/docs/${version}/`, `/docs/latest/`)}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <VersionSelector currentRoute={currentRoute} currentVersion={version} />
    <main id="main-content">
      <p class="eyebrow">
        {entry.data.category} · {versionLabels.get(version) ?? version}
      </p>
      <h1>{entry.data.title}</h1>
      <p class="route-meta">
        {entry.data.category} · {entry.data.document_type} · {entry.data.status}
      </p>
      <article class="prose">
        <Content />
      </article>
    </main>
  </body>
</html>
