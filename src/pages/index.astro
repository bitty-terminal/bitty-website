    <script>
      (() => {
        // 1. Mascot tips and mood cycling
        const mascotMoods = [
          {
            face: "^ω^",
            text: '"Oha~! Press [Alt+E] to pop open the Composer modal, or click my face to cycle terminal tips!"',
          },
          {
            face: "⌐■_■",
            text: '"Piccolo Sandbox active! Unauthenticated env reads return desensitized nil—zero token leaks!"',
          },
          {
            face: "★ω★",
            text: "\"Did you know? A Bitty Panel can mount a declarative Lua GUI (type='rich') instead of a PTY!\"",
          },
          {
            face: "－ω－",
            text: '"Zzz... Plugins in Installed state spawn 0 Lua VMs and consume 0 bytes of memory until triggered!"',
          },
        ];
        let mascotIdx = 0;
        function cycleMascot() {
          mascotIdx = (mascotIdx + 1) % mascotMoods.length;
          const current = mascotMoods[mascotIdx];
          const face = document.getElementById("mascot-face");
          const speech = document.getElementById("mascot-speech");
          if (face && current) face.textContent = current.face;
          if (speech && current) speech.textContent = current.text;
        }
        document
          .getElementById("mascot-poke-btn")
          ?.addEventListener("click", cycleMascot);
        document
          .getElementById("mascot-next-tip-btn")
          ?.addEventListener("click", cycleMascot);

        // 2. OS Tabs switching logic
        const dlTabs = document.querySelectorAll<HTMLButtonElement>(".dl-tab");
        const dlCommandText = document.getElementById("dl-command-text");
        const copyBtn = document.getElementById("copy-dl-btn");
        const copyLabel = document.getElementById("copy-dl-label");

        const installCommands: Record<string, string> = {
          unix: "curl -fsSL https://cdn.bitty.run/bitty/install/install.sh | bash",
          win: "irm https://cdn.bitty.run/bitty/install/install.ps1 | iex",
          pkg: "paru -S bitty-bin # or apt / dnf / zypper / nix / flatpak (see matrix)",
          cargo:
            "cargo +1.98.1 install --git https://github.com/bitty-terminal/bitty.git bitty-terminal --locked",
        };

        const installHints: Record<string, string> = {
          unix: "Linux & macOS: Automated bootstrap fetching verified .tar.zst / binary",
          win: "Windows: PowerShell one-liner installing portable binary (user-local)",
          pkg: "Distros: Arch (AUR), Debian/Ubuntu (.deb), Fedora (.rpm), openSUSE, Alpine, NixOS, Flatpak",
          cargo:
            "Build from source: compile with pinned toolchain (+1.98.1) via Cargo",
        };

        const dlTabList = Array.from(dlTabs);
        const activateDlTab = (tab: HTMLButtonElement, focus = true) => {
          const key = tab.getAttribute("data-dl-tab");
          if (!key) return;

          dlTabs.forEach((t) => {
            t.classList.remove("active");
            t.setAttribute("aria-selected", "false");
            t.tabIndex = -1;
            t.style.background = "var(--bg-canvas)";
            t.style.color = "var(--fg-secondary)";
            t.style.borderColor = "var(--card-border)";
          });
          tab.classList.add("active");
          tab.setAttribute("aria-selected", "true");
          tab.tabIndex = 0;
          tab.style.background = "var(--accent)";
          tab.style.color = "#0b0914";
          tab.style.borderColor = "var(--ink-border)";

          if (focus) tab.focus();

          if (dlCommandText && installCommands[key]) {
            dlCommandText.textContent = installCommands[key];
          }
          const hint = document.getElementById("dl-hint-text");
          if (hint && installHints[key]) {
            hint.textContent = installHints[key];
          }
        };

        dlTabs.forEach((tab) => {
          tab.addEventListener("click", () => activateDlTab(tab, false));
          tab.addEventListener("keydown", (e) => {
            const index = dlTabList.indexOf(tab);
            if (index === -1) return;
            let nextIndex = -1;

            if (e.key === "ArrowRight") {
              nextIndex = (index + 1) % dlTabList.length;
            } else if (e.key === "ArrowLeft") {
              nextIndex = (index - 1 + dlTabList.length) % dlTabList.length;
            } else if (e.key === "Home") {
              nextIndex = 0;
            } else if (e.key === "End") {
              nextIndex = dlTabList.length - 1;
            }

            if (nextIndex !== -1) {
              e.preventDefault();
              const nextTab = dlTabList[nextIndex];
              if (nextTab) activateDlTab(nextTab, true);
            }
          });
        });

        // 3. One-click copy
        copyBtn?.addEventListener("click", async () => {
          const text = dlCommandText?.textContent?.trim() || "";
          try {
            await navigator.clipboard.writeText(text);
            if (copyLabel) {
              copyLabel.textContent = "COPIED!";
              setTimeout(() => {
                copyLabel.textContent = "COPY";
              }, 2000);
            }
          } catch {}
        });
      })();
    </script>
