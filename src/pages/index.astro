---
/**
 * Bitty website home page — Cyber-Pop & Cel-Shaded Toon Design.
 *
 * 1. Cyber-Cartoon Headline + Sticker Badges + Interactive Bittie Mascot Card.
 * 2. Multi-platform Arcade Cartridge Install Deck (#download) with Unix sh, pwsh, Packages, Cargo.
 * 3. 16:10 Interactive Showcase Stage (<ShowcaseStage />) with Dwindle Tiling, Lua GUI Panels,
 *    Composer modal, and media slot placeholders.
 * 4. Three Manga Bento Cards (STAGE 01, 02, 03) linking into canonical docs.
 * 5. Canonical bitty-manual Documentation Groups: build-time validated links to R2 docs.
 */
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ShowcaseStage from "../components/ShowcaseStage.astro";
import LinuxDistroMatrix from "../components/LinuxDistroMatrix.astro";
import BackgroundCanvas from "../components/BackgroundCanvas.astro";
import { getManualNavGroups } from "../lib/manualDocs.ts";
import {
  CHECKSUMS_URL,
  INSTALL_SH_URL,
  INSTALL_PS1_URL,
  releaseUrl,
} from "../lib/release";
import "../styles/global.css";

const manualGroups = getManualNavGroups("", "latest");
const gettingStartedDocs =
  manualGroups.find((g) => g.id === "getting-started")?.entries ?? [];
const configurationDocs =
  manualGroups.find((g) => g.id === "configuration")?.entries ?? [];
const pluginDocs = manualGroups.find((g) => g.id === "plugins")?.entries ?? [];
const apiDocs = manualGroups.find((g) => g.id === "api")?.entries ?? [];

const docTitleMap: Record<string, string> = {
  "getting-started/quickstart": "docTitleQuickstart",
  "getting-started/cli": "docTitleCli",
  "configuration/overview": "docTitleConfigOverview",
  "configuration/workspaces-panels": "docTitleWorkspaces",
  "configuration/actions-catalog": "docTitleActions",
  "plugins/getting-started": "docTitlePluginStart",
  "plugins/bar-modules": "docTitleBarModules",
  "plugins/composer": "docTitleComposer",
  "plugins/plugin-settings": "docTitlePluginConfig",
  "plugins/capabilities-and-sandbox": "docTitleCapabilities",
  "plugins/upstream-components": "docTitleNativeComponents",
  "api/overview": "docTitleApiOverview",
  "api/ui": "docTitleApiUi",
  "api/commands-keymaps": "docTitleApiCommands",
  "api/panel-workspace": "docTitleApiPanel",
  "api/services-notify": "docTitleApiServices",
  "api/system": "docTitleApiSystem",
};
---

<!doctype html>
<html lang="en" data-theme="shibuya-pop" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Bitty — Cyber-Pop high-performance programmable GPU terminal platform pairing a pure-Rust microkernel with sandboxed Phodopus (Piccolo Fork) and Hyprland-style tiling."
    />
    <link rel="canonical" href="https://bitty.run/" />
    <link rel="icon" type="image/x-icon" href="/icons/favicon.ico" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/favicon-32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/icons/favicon-16.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/apple-touch-icon.png"
    />
    <title>Bitty (ビッティ) — Cyber-Pop GPU Terminal Emulator</title>

    <script is:inline>
      (() => {
        let theme = "shibuya-pop";
        try {
          const params = new URLSearchParams(window.location.search);
          const urlTheme = params.get("theme");
          if (urlTheme === "akiba-cyber" || urlTheme === "dark") {
            theme = "akiba-cyber";
          } else if (urlTheme === "shibuya-pop" || urlTheme === "light") {
            theme = "shibuya-pop";
          } else {
            let savedTheme = null;
            try {
              savedTheme = localStorage.getItem("bitty-theme");
            } catch {}
            if (savedTheme === "akiba-cyber" || savedTheme === "dark") {
              theme = "akiba-cyber";
            } else if (savedTheme === "shibuya-pop" || savedTheme === "light") {
              theme = "shibuya-pop";
            }
          }
        } catch {}
        document.documentElement.setAttribute("data-theme", theme);

        try {
          const savedLang = localStorage.getItem("bitty_lang");
          if (savedLang === "zh-CN" || savedLang === "en") {
            document.documentElement.setAttribute("data-lang", savedLang);
          } else if (
            navigator.language &&
            navigator.language.startsWith("zh")
          ) {
            document.documentElement.setAttribute("data-lang", "zh-CN");
          } else {
            document.documentElement.setAttribute("data-lang", "en");
          }
        } catch {}
      })();
    </script>
  </head>
  <body class="bg-manga-halftone min-h-screen flex flex-col justify-between relative selection:bg-[var(--accent-pop)] selection:text-white">
    <BackgroundCanvas />
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>
    <SiteHeader version="latest" activeNav="hero" />

    <main id="main-content" class="home-main" tabindex="-1">
      <div class="content-container space-y-16">
        <!-- 1. HERO TOP SPLIT: Pitch & Headline Left | Arcade Download Deck Right -->
        <section class="hero-section" aria-labelledby="hero-title">
          <div class="hero-grid">
            <!-- Left 7 Cols: Headline, Leed, CTAs -->
            <div class="hero-content space-y-5">
              <!-- Sticker Badges -->
              <div class="flex flex-wrap items-center gap-2.5 font-mono-tech">
                <span class="sticker-badge" style="color: var(--accent);">
                  <span data-i18n="heroBadge1">
                    ★ GPU-ACCELERATED · RUST MICROKERNEL
                  </span>
                </span>
                <span
                  class="sticker-badge"
                  style="color: var(--accent-yellow); border-color: var(--accent-yellow);"
                >
                  <span data-i18n="heroBadge2">
                    PHODOPUS (PICCOLO FORK) · 0B IDLE SANDBOX
                  </span>
                </span>
              </div>

              <!-- Cyber-Pop Headline -->
              <h1
                id="hero-title"
                class="font-cyber-display font-bold hero-pop-title text-[var(--fg-primary)]"
                data-i18n="heroTitle"
              >
                SMALL CORE. HIGHLY PROGRAMMABLE TERMINAL PLATFORM.
              </h1>

              <p
                class="hero-lede text-[var(--fg-secondary)] leading-relaxed"
                data-i18n="heroLede"
              >
                Bitty is built on a timeless tenet: &ldquo;Small core. Stable
                API. Everything composable. Extensions own the
                experience.&rdquo; A pure Rust microkernel preserves terminal
                truth and blazing GPU throughput, while sandboxed Phodopus
                (Piccolo Fork) and native coprocesses shape your ideal
                workspace—with zero background daemons.
              </p>

              <!-- Primary Action Buttons -->
              <div class="flex flex-wrap items-center gap-3.5 pt-1 font-cyber-display font-bold text-sm">
                <a
                  href="#download"
                  class="arcade-btn px-5 py-2.5 flex items-center gap-2"
                  style="background: var(--accent); color: #0b0914;"
                >
                  <span data-i18n="getBittyBtn">Get Bitty ⚡</span>
                </a>
                <a
                  href="/docs/latest/"
                  class="arcade-btn px-5 py-2.5 bg-[var(--bg-surface)] text-[var(--fg-primary)] flex items-center gap-2"
                >
                  <span data-i18n="exploreDocsBtn">Explore Docs →</span>
                </a>
              </div>
            </div>

            <!-- Right 5 Cols: Arcade Cartridge Install & Download Deck -->
            <div id="download" class="download-box-col">
              <div class="toon-card-cyan overflow-hidden shadow-2xl">
                <!-- Top Caution Header -->
                <div class="h-2 hazard-stripe"></div>
                <div class="px-4 py-2 border-b-2 border-[var(--card-border)] bg-[var(--bg-elevated)] flex items-center justify-between font-cyber-display text-xs font-bold">
                  <div class="flex items-center gap-2">
                    <span
                      class="px-2 py-0.5 rounded bg-[var(--accent-yellow)] text-[#0b0914] text-[10px]"
                      data-i18n="installDeckBadge"
                    >
                      QUICK INSTALL
                    </span>
                    <a
                      href={CHECKSUMS_URL}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hover:underline text-[var(--fg-secondary)] hover:text-[var(--accent)] text-[10px] font-mono-tech"
                      data-i18n="installDeckChecksum"
                    >
                      SHA-256 CHECKSUMS ↗
                    </a>
                  </div>
                  <span class="font-mono-tech text-[10px] text-[var(--accent)]">
                    R2 CDN
                  </span>
                </div>

                <!-- OS Tabs & Command Readout -->
                <div class="p-4 space-y-3 bg-[var(--bg-surface)]">
                  <div
                    class="grid grid-cols-4 gap-1.5 font-mono-tech text-xs font-bold"
                    role="tablist"
                    aria-label="Operating System Install Commands"
                  >
                    <button
                      type="button"
                      role="tab"
                      id="dl-tab-unix"
                      aria-selected="true"
                      aria-controls="dl-panel"
                      tabindex="0"
                      data-dl-tab="unix"
                      class="dl-tab py-1.5 px-2 rounded-lg border-2 border-[var(--ink-border)] transition-all active"
                      style="background: var(--accent); color: #0b0914;"
                    >
                      Unix .sh
                    </button>
                    <button
                      type="button"
                      role="tab"
                      id="dl-tab-win"
                      aria-selected="false"
                      aria-controls="dl-panel"
                      tabindex="-1"
                      data-dl-tab="win"
                      class="dl-tab py-1.5 px-2 rounded-lg border-2 border-[var(--card-border)] bg-[var(--bg-canvas)] text-[var(--fg-secondary)] hover:text-[var(--fg-primary)]"
                    >
                      Win .ps1
                    </button>
                    <button
                      type="button"
                      role="tab"
                      id="dl-tab-pkg"
                      aria-selected="false"
                      aria-controls="dl-panel"
                      tabindex="-1"
                      data-dl-tab="pkg"
                      class="dl-tab py-1.5 px-2 rounded-lg border-2 border-[var(--card-border)] bg-[var(--bg-canvas)] text-[var(--fg-secondary)] hover:text-[var(--fg-primary)]"
                    >
                      <span data-i18n="tabPackages">Packages</span>
                    </button>
                    <button
                      type="button"
                      role="tab"
                      id="dl-tab-cargo"
                      aria-selected="false"
                      aria-controls="dl-panel"
                      tabindex="-1"
                      data-dl-tab="cargo"
                      class="dl-tab py-1.5 px-2 rounded-lg border-2 border-[var(--card-border)] bg-[var(--bg-canvas)] text-[var(--fg-secondary)] hover:text-[var(--fg-primary)]"
                    >
                      Cargo
                    </button>
                  </div>

                  <!-- Command Readout Box (Strictly Fixed Height - Zero CLS) -->
                  <div
                    id="dl-panel"
                    class="dl-panel-box p-3 rounded-xl bg-[var(--bg-code)] border-2 border-[var(--card-border)] flex items-center justify-between gap-2 overflow-hidden"
                    role="tabpanel"
                    aria-labelledby="dl-tab-unix"
                  >
                    <div class="font-mono-tech text-xs text-[#f5f3ff] overflow-x-auto whitespace-nowrap py-0.5 flex-1 select-all min-w-0 no-scrollbar">
                      <span
                        class="select-none mr-2 font-bold"
                        style="color: var(--accent-pop);"
                      >
                        ❯
                      </span>
                      <span id="dl-command-text">
                        {`curl -fsSL ${INSTALL_SH_URL} | bash`}
                      </span>
                    </div>
                    <button
                      type="button"
                      id="copy-dl-btn"
                      class="arcade-btn shrink-0 w-16 justify-center px-3 py-1.5 bg-[var(--bg-elevated)] font-mono-tech text-xs font-bold text-[var(--fg-primary)] flex items-center"
                      aria-label="Copy install command"
                    >
                      <span id="copy-dl-label" data-i18n="copyBtnLabel">
                        COPY
                      </span>
                    </button>
                  </div>

                  <!-- Platform Hint / Target Summary (Fixed Single Line) -->
                  <div class="h-6 flex items-center justify-between font-mono-tech text-[11px] text-[var(--fg-muted)] px-1 gap-2">
                    <span id="dl-hint-text" class="truncate min-w-0 flex-1">
                      Linux &amp; macOS: Automated bootstrap fetching verified
                      .tar.zst / binary
                    </span>
                    <span
                      id="dl-status-ready"
                      class="text-[10px] text-[var(--accent-mint)] shrink-0 font-bold hidden sm:inline"
                      data-i18n="statusReady"
                    >
                      ● READY
                    </span>
                  </div>

                  <!-- Direct R2 Artifacts Matrix (Expanded R2 Ecosystem) -->
                  <div class="pt-3 border-t-dashed space-y-2 font-mono-tech text-[11px]">
                    <div class="flex items-center justify-between">
                      <span
                        class="text-[var(--fg-muted)] font-bold uppercase tracking-wider text-[10px]"
                        data-i18n="directBinariesTitle"
                      >
                        ★ Direct R2 Binaries &amp; Packages:
                      </span>
                      <a
                        href={CHECKSUMS_URL}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[10px] text-[var(--accent)] hover:underline"
                        title="Download release SHA256 checksums"
                      >
                        SHA256SUMS ↗
                      </a>
                    </div>

                    <!-- Platform Binary Grid -->
                    <div class="grid grid-cols-3 gap-2">
                      <!-- Linux -->
                      <div class="p-2 rounded-lg bg-[var(--bg-canvas)] border border-[var(--card-border)] flex flex-col justify-between gap-1.5">
                        <div class="flex items-center justify-between">
                          <span class="font-bold text-[var(--fg-primary)] text-[10px]">
                            🐧 Linux
                          </span>
                          <a
                            href="#linux-distros"
                            class="text-[9px] text-[var(--accent)] hover:underline font-bold"
                            title="Jump to full Linux Distros Matrix"
                            data-i18n="directMatrixLink"
                          >
                            Matrix ↓
                          </a>
                        </div>
                        <div class="flex flex-wrap gap-1">
                          <a
                            href={releaseUrl(
                              "bitty-{v}-x86_64-unknown-linux-gnu.tar.zst",
                            )}
                            class="px-1.5 py-0.5 rounded bg-[var(--bg-elevated)] border border-[var(--border-subtle)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] text-[10px]"
                            title="x86_64 tar.zst"
                          >
                            .tar.zst
                          </a>
                          <a
                            href={releaseUrl(
                              "bitty-x86_64-unknown-linux-gnu.AppImage",
                            )}
                            class="px-1.5 py-0.5 rounded bg-[var(--bg-elevated)] border border-[var(--border-subtle)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] text-[10px]"
                            title="x86_64 AppImage"
                          >
                            AppImage
                          </a>
                          <a
                            href={releaseUrl(
                              "bitty-x86_64-unknown-linux-gnu.deb",
                            )}
                            class="px-1.5 py-0.5 rounded bg-[var(--bg-elevated)] border border-[var(--border-subtle)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] text-[10px]"
                            title="Debian & Ubuntu amd64 .deb"
                          >
                            .deb
                          </a>
                          <a
                            href={releaseUrl(
                              "bitty-x86_64-unknown-linux-gnu.rpm",
                            )}
                            class="px-1.5 py-0.5 rounded bg-[var(--bg-elevated)] border border-[var(--border-subtle)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] text-[10px]"
                            title="Fedora & openSUSE x86_64 .rpm"
                          >
                            .rpm
                          </a>
                          <a
                            href={releaseUrl(
                              "bitty-x86_64-unknown-linux-musl.apk",
                            )}
                            class="px-1.5 py-0.5 rounded bg-[var(--bg-elevated)] border border-[var(--border-subtle)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] text-[10px]"
                            title="Alpine Linux .apk"
                          >
                            .apk
                          </a>
                          <a
                            href={releaseUrl(
                              "bitty-{v}-aarch64-unknown-linux-gnu.tar.zst",
                            )}
                            class="px-1.5 py-0.5 rounded bg-[var(--bg-elevated)] border border-[var(--border-subtle)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] text-[10px]"
                            title="aarch64 tar.zst"
                          >
                            arm64
                          </a>
                        </div>
                      </div>

                      <!-- macOS -->
                      <div class="p-2 rounded-lg bg-[var(--bg-canvas)] border border-[var(--card-border)] flex flex-col justify-between gap-1.5">
                        <span class="font-bold text-[var(--fg-primary)] text-[10px]">
                          🍏 macOS
                        </span>
                        <div class="flex flex-wrap gap-1">
                          <a
                            href={releaseUrl("bitty-aarch64-apple-darwin")}
                            class="px-1.5 py-0.5 rounded bg-[var(--bg-elevated)] border border-[var(--border-subtle)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] text-[10px]"
                            title="Apple Silicon binary"
                          >
                            Apple Silicon binary
                          </a>
                          <a
                            href={releaseUrl("Bitty-{v}-universal.dmg")}
                            class="px-1.5 py-0.5 rounded bg-[var(--bg-elevated)] border border-[var(--border-subtle)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] text-[10px]"
                            title="Universal DMG"
                          >
                            Universal .dmg
                          </a>
                        </div>
                      </div>

                      <!-- Windows -->
                      <div class="p-2 rounded-lg bg-[var(--bg-canvas)] border border-[var(--card-border)] flex flex-col justify-between gap-1.5">
                        <span class="font-bold text-[var(--fg-primary)] text-[10px]">
                          🪟 Windows
                        </span>
                        <div class="flex flex-wrap gap-1">
                          <a
                            href={releaseUrl("bitty-{v}-windows-x86_64.zip")}
                            class="px-1.5 py-0.5 rounded bg-[var(--bg-elevated)] border border-[var(--border-subtle)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] text-[10px]"
                            title="Windows x64 Portable ZIP"
                          >
                            .zip{" "}
                            <span data-i18n="directPkgPortable">
                              (Portable)
                            </span>
                          </a>
                          <a
                            href={releaseUrl(
                              "bitty-{v}-windows-x86_64-setup.exe",
                            )}
                            class="px-1.5 py-0.5 rounded bg-[var(--bg-elevated)] border border-[var(--border-subtle)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] text-[10px]"
                            title="Windows x64 Setup Installer"
                          >
                            .exe
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- 2. 16:10 INTERACTIVE SHOWCASE STAGE (Media Slot Support) -->
        <section
          class="stage-section"
          aria-label="Terminal Feature Demonstration"
        >
          <ShowcaseStage />
        </section>

        <!-- 3. UNIVERSAL LINUX PACKAGING & DISTRIBUTION MATRIX -->
        <LinuxDistroMatrix />

        <!-- 4. THREE CYBER-MANGA BENTO CARDS -->
        <section
          class="pillars-section space-y-6"
          aria-labelledby="pillars-title"
        >
          <div class="section-header">
            <h2
              id="pillars-title"
              class="font-cyber-display font-bold text-2xl sm:text-3xl text-[var(--fg-primary)] mb-2"
              data-i18n="pillarsTitle"
            >
              Engineered for Composability &amp; Isolation
            </h2>
            <p
              class="text-sm text-[var(--fg-secondary)]"
              data-i18n="pillarsSubtitle"
            >
              Zero monolithic bloat. Bitty separates terminal mechanics from
              extension policy.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Card 01 -->
            <article class="toon-card p-5 flex flex-col justify-between space-y-4">
              <div class="space-y-3">
                <div class="flex items-center justify-between font-mono-tech text-xs">
                  <span
                    class="px-2 py-0.5 rounded font-bold bg-[var(--accent)] text-[#0b0914]"
                    data-i18n="bentoStage1Tag"
                  >
                    STAGE 01
                  </span>
                  <span class="text-[var(--fg-muted)]" data-i18n="bento1Badge">
                    TERMINAL TRUTH &amp; TILING
                  </span>
                </div>
                <h3
                  class="font-cyber-display font-bold text-xl text-[var(--fg-primary)]"
                  data-i18n="bento1Title"
                >
                  Hyprland Tiling × Terminal Truth
                </h3>
                <p
                  class="text-xs sm:text-sm text-[var(--fg-secondary)] leading-relaxed"
                  data-i18n="bento1Desc"
                >
                  Strict separation between Terminal (canonical PTY state), View
                  (presentation), and Layout (compositor). Dwindle &amp; BSP
                  binary trees with sub-pixel borders that never block hot
                  paths.
                </p>
              </div>
              <a
                href="/docs/latest/configuration/workspaces-panels/"
                class="arcade-btn w-full py-2 px-3 bg-[var(--bg-elevated)] font-cyber-display font-bold text-xs flex items-center justify-between text-[var(--fg-primary)]"
              >
                <span data-i18n="bento1BtnLabel">Read Workspaces Spec</span>
                <span style="color: var(--accent);" data-i18n="bentoOpenDoc">
                  OPEN DOC →
                </span>
              </a>
            </article>

            <!-- Card 02 -->
            <article class="toon-card p-5 flex flex-col justify-between space-y-4">
              <div class="space-y-3">
                <div class="flex items-center justify-between font-mono-tech text-xs">
                  <span
                    class="px-2 py-0.5 rounded font-bold bg-[var(--accent-pop)] text-white"
                    data-i18n="bentoStage2Tag"
                  >
                    STAGE 02
                  </span>
                  <span class="text-[var(--fg-muted)]" data-i18n="bento2Badge">
                    PHODOPUS &amp; WIRE V1
                  </span>
                </div>
                <h3
                  class="font-cyber-display font-bold text-xl text-[var(--fg-primary)]"
                  data-i18n="bento2Title"
                >
                  Phodopus (Piccolo Fork) × Native Coprocesses
                </h3>
                <p
                  class="text-xs sm:text-sm text-[var(--fg-secondary)] leading-relaxed"
                  data-i18n="bento2Desc"
                >
                  Independent sandbox-first runtime forked from Piccolo —
                  complete with require module chains, pattern matching, fuel
                  metering, and 32 MiB hard quotas at 0-byte idle memory; heavy
                  workloads isolate safely over stdio Wire v1.
                </p>
              </div>
              <a
                href="/docs/latest/plugins/upstream-components/"
                class="arcade-btn w-full py-2 px-3 bg-[var(--bg-elevated)] font-cyber-display font-bold text-xs flex items-center justify-between text-[var(--fg-primary)]"
              >
                <span data-i18n="bento2BtnLabel">Read Architecture Spec</span>
                <span
                  style="color: var(--accent-pop);"
                  data-i18n="bentoOpenDoc"
                >
                  OPEN DOC →
                </span>
              </a>
            </article>

            <!-- Card 03 -->
            <article class="toon-card p-5 flex flex-col justify-between space-y-4">
              <div class="space-y-3">
                <div class="flex items-center justify-between font-mono-tech text-xs">
                  <span
                    class="px-2 py-0.5 rounded font-bold bg-[var(--accent-yellow)] text-[#0b0914]"
                    data-i18n="bentoStage3Tag"
                  >
                    STAGE 03
                  </span>
                  <span class="text-[var(--fg-muted)]" data-i18n="bento3Badge">
                    CONFIGPLAN &amp; RESILIENCE
                  </span>
                </div>
                <h3
                  class="font-cyber-display font-bold text-xl text-[var(--fg-primary)]"
