---
/**
 * Bitty website home page — Cyber-Pop & Cel-Shaded Toon Design.
 *
 * 1. Cyber-Cartoon Headline + Sticker Badges + Interactive Bittie Mascot Card.
 * 2. Multi-platform Arcade Cartridge Install Deck (#download) with Unix sh, pwsh, Packages, Cargo.
 * 3. 16:10 Interactive Showcase Stage (<ShowcaseStage />) with Dwindle Tiling, Lua GUI Panels,
 *    Composer modal, and media slot placeholders.
 * 4. Three Manga Bento Cards (STAGE 01, 02, 03) linking into canonical docs.
 * 5. Canonical bitty-manual Documentation Groups: build-time validated links to R2 docs.
 */
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ShowcaseStage from "../components/ShowcaseStage.astro";
import LinuxDistroMatrix from "../components/LinuxDistroMatrix.astro";
import BackgroundCanvas from "../components/BackgroundCanvas.astro";
import { getManualNavGroups } from "../lib/manualDocs.ts";
import "../styles/global.css";

const manualGroups = getManualNavGroups("", "latest");
const gettingStartedDocs =
  manualGroups.find((g) => g.id === "getting-started")?.entries ?? [];
const configurationDocs =
  manualGroups.find((g) => g.id === "configuration")?.entries ?? [];
const pluginDocs = manualGroups.find((g) => g.id === "plugins")?.entries ?? [];
const apiDocs = manualGroups.find((g) => g.id === "api")?.entries ?? [];
---

<!doctype html>
<html lang="en" data-theme="shibuya-pop" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Bitty — Cyber-Pop high-performance programmable GPU terminal emulator pairing a Rust microkernel with a sandboxed Piccolo Lua engine and Hyprland-style tiling."
    />
    <link rel="canonical" href="https://bitty.run/" />
    <link rel="icon" type="image/x-icon" href="/icons/favicon.ico" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/favicon-32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/icons/favicon-16.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/apple-touch-icon.png"
    />
    <title>Bitty (ビッティ) — Cyber-Pop GPU Terminal Emulator</title>

    <script is:inline>
      (() => {
        let theme = "shibuya-pop";
        try {
          const params = new URLSearchParams(window.location.search);
          const urlTheme = params.get("theme");
          if (urlTheme === "akiba-cyber" || urlTheme === "dark") {
            theme = "akiba-cyber";
          } else if (urlTheme === "shibuya-pop" || urlTheme === "light") {
            theme = "shibuya-pop";
          } else {
            let savedTheme = null;
            try {
              savedTheme = localStorage.getItem("bitty-theme");
            } catch {}
            if (savedTheme === "akiba-cyber" || savedTheme === "dark") {
              theme = "akiba-cyber";
            } else if (savedTheme === "shibuya-pop" || savedTheme === "light") {
              theme = "shibuya-pop";
            }
          }
        } catch {}
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body class="bg-manga-halftone min-h-screen flex flex-col justify-between relative selection:bg-[var(--accent-pop)] selection:text-white">
    <BackgroundCanvas />
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>
    <SiteHeader version="latest" activeNav="hero" />

    <main id="main-content" class="home-main" tabindex="-1">
      <div class="content-container space-y-16">
        <!-- 1. HERO TOP SPLIT: Pitch & Mascot Left | Arcade Download Deck Right -->
        <section class="hero-section" aria-labelledby="hero-title">
          <div class="hero-grid">
            <!-- Left 7 Cols: Headline, Leed, Mascot, CTAs -->
            <div class="hero-content space-y-5">
              <!-- Sticker Badges -->
              <div class="flex flex-wrap items-center gap-2.5 font-mono-tech">
                <span class="sticker-badge" style="color: var(--accent);">
                  <span>★</span>
                  <span>超高速 GPU 端末 // MICROKERNEL</span>
                </span>
                <span
                  class="sticker-badge"
                  style="color: var(--accent-yellow); border-color: var(--accent-yellow);"
                >
                  <span>PICCOLO LUA VM · 0B IDLE</span>
                </span>
              </div>

              <!-- Cyber-Pop Headline -->
              <h1
                id="hero-title"
                class="font-cyber-display font-bold hero-pop-title text-[var(--fg-primary)]"
              >
                TILE SHELLS &amp; RICH LUA GUIS AT ARCADE SPEED.
              </h1>

              <p class="hero-lede text-[var(--fg-secondary)] leading-relaxed">
                <strong>Bitty</strong> brings Hyprland-style dwindle tiling into
                a pure-Rust microkernel terminal. Every panel hosts either a raw
                PTY stream or a sandboxed Piccolo Lua GUI—backed by zero-daemon
                native coprocesses.
              </p>

              <!-- Interactive Bittie Mascot Card -->
              <div class="toon-card p-3.5 sm:p-4 flex items-center gap-4 bg-[var(--bg-elevated)] max-w-xl">
                <button
                  type="button"
                  id="mascot-poke-btn"
                  class="mascot-bob shrink-0 w-16 h-16 rounded-2xl border-2 border-[var(--ink-border)] bg-[var(--bg-canvas)] flex flex-col items-center justify-center shadow-[3px_3px_0px_var(--toon-shadow)] cursor-pointer group"
                  title="Poke Bittie! (bitty --mascot)"
                >
                  <div
                    id="mascot-face"
                    class="font-mono-tech font-bold text-base"
                    style="color: var(--accent);"
                  >
                    ^ω^
                  </div>
                  <div class="text-[9px] font-mono-tech text-[var(--accent-pop)] font-bold mt-0.5">
                    BITTIE
                  </div>
                </button>
                <div class="space-y-1 min-w-0 flex-1">
                  <div class="flex items-center justify-between gap-2">
                    <span
                      class="font-cyber-display font-bold text-xs uppercase tracking-wider"
                      style="color: var(--accent-yellow);"
                    >
                      Bittie Navigator // bitty --mascot
                    </span>
                    <button
                      type="button"
                      id="mascot-next-tip-btn"
                      class="font-mono-tech text-[10px] px-2 py-0.5 rounded bg-[var(--bg-surface)] border border-[var(--card-border)] hover:border-[var(--ink-border)] text-[var(--fg-secondary)] cursor-pointer"
                    >
                      Poke Mascot ↻
                    </button>
                  </div>
                  <p
                    id="mascot-speech"
                    class="font-mono-tech text-xs text-[var(--fg-primary)] leading-snug"
                  >
                    "Oha~! Press [Alt+E] to pop open the Composer modal, or
                    click my face to cycle terminal tips!"
                  </p>
                </div>
              </div>

              <!-- Primary Action Buttons -->
              <div class="flex flex-wrap items-center gap-3.5 pt-1 font-cyber-display font-bold text-sm">
                <a
                  href="#download"
                  class="arcade-btn px-5 py-2.5 flex items-center gap-2"
                  style="background: var(--accent); color: #0b0914;"
                >
                  <span>Get Bitty 0.0.23 ⚡</span>
                </a>
                <a
                  href="/docs/latest/"
                  class="arcade-btn px-5 py-2.5 bg-[var(--bg-surface)] text-[var(--fg-primary)] flex items-center gap-2"
                >
                  <span>Explore R2 Docs</span>
                  <span style="color: var(--accent-pop);">→</span>
                </a>
              </div>
            </div>

            <!-- Right 5 Cols: Arcade Cartridge Install & Download Deck -->
            <div id="download" class="download-box-col">
              <div class="toon-card-cyan overflow-hidden shadow-2xl">
                <!-- Top Caution Header -->
                <div class="h-2 hazard-stripe"></div>
                <div class="px-4 py-2 border-b-2 border-[var(--card-border)] bg-[var(--bg-elevated)] flex items-center justify-between font-cyber-display text-xs font-bold">
                  <div class="flex items-center gap-2">
                    <span class="px-2 py-0.5 rounded bg-[var(--accent-yellow)] text-[#0b0914] text-[10px]">
                      INSTALL DECK
                    </span>
                    <span>導入カートリッジ // SHA-256</span>
                  </div>
                  <span class="font-mono-tech text-[10px] text-[var(--accent)]">
                    v0.0.23 · R2 CDN
                  </span>
                </div>

                <!-- OS Tabs & Command Readout -->
                <div class="p-4 space-y-3 bg-[var(--bg-surface)]">
                  <div
                    class="grid grid-cols-4 gap-1.5 font-mono-tech text-xs font-bold"
                    role="tablist"
                    aria-label="Operating System Install Commands"
                  >
                    <button
                      type="button"
                      role="tab"
                      id="dl-tab-unix"
                      aria-selected="true"
                      aria-controls="dl-panel"
                      tabindex="0"
                      data-dl-tab="unix"
                      class="dl-tab py-1.5 px-2 rounded-lg border-2 border-[var(--ink-border)] transition-all active"
                      style="background: var(--accent); color: #0b0914;"
                    >
                      Unix .sh
                    </button>
                    <button
                      type="button"
                      role="tab"
                      id="dl-tab-win"
                      aria-selected="false"
                      aria-controls="dl-panel"
                      tabindex="-1"
                      data-dl-tab="win"
                      class="dl-tab py-1.5 px-2 rounded-lg border-2 border-[var(--card-border)] bg-[var(--bg-canvas)] text-[var(--fg-secondary)] hover:text-[var(--fg-primary)]"
                    >
                      Win .ps1
                    </button>
                    <button
                      type="button"
                      role="tab"
                      id="dl-tab-pkg"
                      aria-selected="false"
                      aria-controls="dl-panel"
                      tabindex="-1"
                      data-dl-tab="pkg"
                      class="dl-tab py-1.5 px-2 rounded-lg border-2 border-[var(--card-border)] bg-[var(--bg-canvas)] text-[var(--fg-secondary)] hover:text-[var(--fg-primary)]"
                    >
                      Packages
                    </button>
                    <button
                      type="button"
                      role="tab"
                      id="dl-tab-cargo"
                      aria-selected="false"
                      aria-controls="dl-panel"
                      tabindex="-1"
                      data-dl-tab="cargo"
                      class="dl-tab py-1.5 px-2 rounded-lg border-2 border-[var(--card-border)] bg-[var(--bg-canvas)] text-[var(--fg-secondary)] hover:text-[var(--fg-primary)]"
                    >
                      Cargo
                    </button>
                  </div>

                  <!-- Command Readout Box (Strictly Fixed Height - Zero CLS) -->
                  <div
                    id="dl-panel"
                    class="dl-panel-box p-3 rounded-xl bg-[var(--bg-code)] border-2 border-[var(--card-border)] flex items-center justify-between gap-2 overflow-hidden"
                    role="tabpanel"
                    aria-labelledby="dl-tab-unix"
                  >
                    <div
                      class="font-mono-tech text-xs text-[#f5f3ff] overflow-x-auto whitespace-nowrap py-0.5 flex-1 select-all"
                      style="scrollbar-width: thin;"
                    >
                      <span
                        class="select-none mr-2 font-bold"
                        style="color: var(--accent-pop);"
                      >
                        ❯
                      </span>
                      <span id="dl-command-text">
                        curl -fsSL
                        https://cdn.bitty.run/bitty/install/install.sh | bash
                      </span>
                    </div>
                    <button
                      type="button"
                      id="copy-dl-btn"
                      class="arcade-btn shrink-0 px-3 py-1.5 bg-[var(--bg-elevated)] font-mono-tech text-xs font-bold text-[var(--fg-primary)] flex items-center gap-1"
                      aria-label="Copy install command"
                    >
                      <span id="copy-dl-label">COPY</span>
                    </button>
                  </div>

                  <!-- Platform Hint / Target Summary (Fixed Single Line) -->
                  <div class="h-5 flex items-center justify-between font-mono-tech text-[11px] text-[var(--fg-muted)] px-1">
                    <span id="dl-hint-text" class="truncate">
                      Linux &amp; macOS: Automated bootstrap fetching verified
                      .tar.zst / binary
                    </span>
                    <span class="text-[10px] text-[var(--accent-mint)] shrink-0 font-bold hidden sm:inline">
                      ● READY
                    </span>
                  </div>

                  <!-- Direct R2 Artifacts Matrix (Expanded R2 Ecosystem) -->
                  <div class="pt-3 border-t-dashed space-y-2 font-mono-tech text-[11px]">
                    <div class="flex items-center justify-between">
                      <span class="text-[var(--fg-muted)] font-bold uppercase tracking-wider text-[10px]">
                        ★ Direct R2 Binaries &amp; Packages:
                      </span>
                      <a
                        href="https://cdn.bitty.run/bitty/releases/SHA256SUMS.txt"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[10px] text-[var(--accent)] hover:underline"
                        title="Download release SHA256 checksums"
                      >
                        SHA256SUMS ↗
                      </a>
                    </div>

                    <!-- Platform Binary Grid -->
                    <div class="grid grid-cols-3 gap-2">
                      <!-- Linux -->
                      <div class="p-2 rounded-lg bg-[var(--bg-canvas)] border border-[var(--card-border)] flex flex-col justify-between gap-1.5">
                        <div class="flex items-center justify-between">
                          <span class="font-bold text-[var(--fg-primary)] text-[10px]">
                            🐧 Linux
                          </span>
                          <a
                            href="#linux-distros"
                            class="text-[9px] text-[var(--accent)] hover:underline font-bold"
                            title="Jump to full Linux Distros Matrix"
                          >
                            Matrix ↓
                          </a>
                        </div>
                        <div class="flex flex-wrap gap-1">
                          <a
                            href="https://cdn.bitty.run/bitty/releases/bitty-linux-x86_64.tar.zst"
                            class="px-1.5 py-0.5 rounded bg-[var(--bg-elevated)] border border-[var(--border-subtle)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] text-[10px]"
                            title="x86_64 tar.zst"
                          >
                            .tar.zst
                          </a>
                          <a
                            href="https://cdn.bitty.run/bitty/releases/bitty-linux-x86_64.AppImage"
                            class="px-1.5 py-0.5 rounded bg-[var(--bg-elevated)] border border-[var(--border-subtle)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] text-[10px]"
                            title="x86_64 AppImage"
                          >
                            AppImage
                          </a>
                          <a
                            href="https://cdn.bitty.run/bitty/releases/bitty_amd64.deb"
                            class="px-1.5 py-0.5 rounded bg-[var(--bg-elevated)] border border-[var(--border-subtle)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] text-[10px]"
                            title="Debian & Ubuntu amd64 .deb"
                          >
                            .deb
                          </a>
                          <a
                            href="https://cdn.bitty.run/bitty/releases/bitty-x86_64.rpm"
                            class="px-1.5 py-0.5 rounded bg-[var(--bg-elevated)] border border-[var(--border-subtle)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] text-[10px]"
                            title="Fedora & openSUSE x86_64 .rpm"
                          >
                            .rpm
                          </a>
                          <a
                            href="https://cdn.bitty.run/bitty/releases/bitty.apk"
                            class="px-1.5 py-0.5 rounded bg-[var(--bg-elevated)] border border-[var(--border-subtle)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] text-[10px]"
                            title="Alpine Linux .apk"
                          >
                            .apk
                          </a>
                          <a
                            href="https://cdn.bitty.run/bitty/releases/bitty-linux-aarch64.tar.zst"
                            class="px-1.5 py-0.5 rounded bg-[var(--bg-elevated)] border border-[var(--border-subtle)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] text-[10px]"
                            title="aarch64 tar.zst"
                          >
                            arm64
                          </a>
                        </div>
                      </div>

                      <!-- macOS -->
                      <div class="p-2 rounded-lg bg-[var(--bg-canvas)] border border-[var(--card-border)] flex flex-col justify-between gap-1.5">
                        <span class="font-bold text-[var(--fg-primary)] text-[10px]">
                          🍏 macOS
                        </span>
                        <div class="flex flex-wrap gap-1">
                          <a
                            href="https://cdn.bitty.run/bitty/releases/bitty-macos-arm64.dmg"
                            class="px-1.5 py-0.5 rounded bg-[var(--bg-elevated)] border border-[var(--border-subtle)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] text-[10px]"
                            title="Apple Silicon DMG"
                          >
                            Apple Silicon .dmg
                          </a>
                          <a
                            href="https://cdn.bitty.run/bitty/releases/bitty-macos-universal.dmg"
                            class="px-1.5 py-0.5 rounded bg-[var(--bg-elevated)] border border-[var(--border-subtle)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] text-[10px]"
                            title="Universal DMG"
                          >
                            Universal .dmg
                          </a>
                        </div>
                      </div>

                      <!-- Windows -->
                      <div class="p-2 rounded-lg bg-[var(--bg-canvas)] border border-[var(--card-border)] flex flex-col justify-between gap-1.5">
                        <span class="font-bold text-[var(--fg-primary)] text-[10px]">
                          🪟 Windows
                        </span>
                        <div class="flex flex-wrap gap-1">
                          <a
                            href="https://cdn.bitty.run/bitty/releases/bitty-windows-x64.zip"
                            class="px-1.5 py-0.5 rounded bg-[var(--bg-elevated)] border border-[var(--border-subtle)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] text-[10px]"
                            title="Windows x64 Portable ZIP"
                          >
                            .zip (Portable)
                          </a>
                          <a
                            href="https://cdn.bitty.run/bitty/releases/bitty-windows-x64.msi"
                            class="px-1.5 py-0.5 rounded bg-[var(--bg-elevated)] border border-[var(--border-subtle)] hover:border-[var(--ink-border)] text-[var(--fg-primary)] hover:text-[var(--accent)] text-[10px]"
                            title="Windows x64 MSI Installer"
                          >
                            .msi
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- 2. 16:10 INTERACTIVE SHOWCASE STAGE (Media Slot Support) -->
        <section
          class="stage-section"
          aria-label="Terminal Feature Demonstration"
        >
          <ShowcaseStage />
        </section>

        <!-- 3. UNIVERSAL LINUX PACKAGING & DISTRIBUTION MATRIX -->
        <LinuxDistroMatrix />

        <!-- 4. THREE CYBER-MANGA BENTO CARDS -->
        <section
          class="pillars-section space-y-6"
          aria-labelledby="pillars-title"
        >
          <div class="section-header">
            <h2
              id="pillars-title"
              class="font-cyber-display font-bold text-2xl sm:text-3xl text-[var(--fg-primary)] mb-2"
            >
              Engineered for Composability &amp; Isolation
            </h2>
            <p class="text-sm text-[var(--fg-secondary)]">
              Zero monolithic bloat. Bitty separates terminal mechanics from
              extension policy.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Card 01 -->
            <article class="toon-card p-5 flex flex-col justify-between space-y-4">
              <div class="space-y-3">
                <div class="flex items-center justify-between font-mono-tech text-xs">
                  <span class="px-2 py-0.5 rounded font-bold bg-[var(--accent)] text-[#0b0914]">
                    STAGE 01
                  </span>
                  <span class="text-[var(--fg-muted)]">画面分割 // TILING</span>
                </div>
                <h3 class="font-cyber-display font-bold text-xl text-[var(--fg-primary)]">
                  Hyprland Tiling × GUI Panels
                </h3>
                <p class="text-xs sm:text-sm text-[var(--fg-secondary)] leading-relaxed">
                  Dwindle &amp; BSP binary trees, floating scratchpads, and
                  declarative{" "}
                  <code class="font-mono-tech text-[var(--accent)]">
                    bitty.ui
                  </code>{" "}
                  panels that live side-by-side with PTY shells.
                </p>
              </div>
              <a
                href="/docs/latest/configuration/workspaces-panels/"
                class="arcade-btn w-full py-2 px-3 bg-[var(--bg-elevated)] font-cyber-display font-bold text-xs flex items-center justify-between text-[var(--fg-primary)]"
              >
                <span>Read Workspaces Spec</span>
                <span style="color: var(--accent);">OPEN DOC →</span>
              </a>
            </article>

            <!-- Card 02 -->
            <article class="toon-card p-5 flex flex-col justify-between space-y-4">
              <div class="space-y-3">
                <div class="flex items-center justify-between font-mono-tech text-xs">
                  <span class="px-2 py-0.5 rounded font-bold bg-[var(--accent-pop)] text-white">
                    STAGE 02
                  </span>
                  <span class="text-[var(--fg-muted)]">
                    二重拡張 // EXTENSIONS
                  </span>
                </div>
                <h3 class="font-cyber-display font-bold text-xl text-[var(--fg-primary)]">
                  Piccolo Lua × Rust Coprocesses
                </h3>
                <p class="text-xs sm:text-sm text-[var(--fg-secondary)] leading-relaxed">
                  Zero-byte idle VMs in a stackless, fuel-metered Piccolo Lua
                  sandbox, paired with TOFU-pinned upstream Rust binaries over{" "}
                  <code class="font-mono-tech text-[var(--accent)]">
                    stdio Wire v1
                  </code>
                  .
                </p>
              </div>
              <a
                href="/docs/latest/plugins/upstream-components/"
                class="arcade-btn w-full py-2 px-3 bg-[var(--bg-elevated)] font-cyber-display font-bold text-xs flex items-center justify-between text-[var(--fg-primary)]"
              >
                <span>Read Architecture Spec</span>
                <span style="color: var(--accent-pop);">OPEN DOC →</span>
              </a>
            </article>

            <!-- Card 03 -->
            <article class="toon-card p-5 flex flex-col justify-between space-y-4">
              <div class="space-y-3">
                <div class="flex items-center justify-between font-mono-tech text-xs">
                  <span class="px-2 py-0.5 rounded font-bold bg-[var(--accent-yellow)] text-[#0b0914]">
                    STAGE 03
                  </span>
                  <span class="text-[var(--fg-muted)]">
                    即時反映 // LIVE LUA
                  </span>
                </div>
                <h3 class="font-cyber-display font-bold text-xl text-[var(--fg-primary)]">
                  Live Config &amp; Safe Recovery
                </h3>
                <p class="text-xs sm:text-sm text-[var(--fg-secondary)] leading-relaxed">
                  Instant{" "}
                  <code class="font-mono-tech text-[var(--accent)]">
                    init.lua
                  </code>{" "}
                  reconciliation without dropping PTYs, atomic rollback on
                  invalid fields, and{" "}
                  <code class="font-mono-tech text-[var(--accent-mint)]">
                    bitty --safe
                  </code>{" "}
                  emergency mode.
                </p>
              </div>
              <a
                href="/docs/latest/configuration/overview/"
                class="arcade-btn w-full py-2 px-3 bg-[var(--bg-elevated)] font-cyber-display font-bold text-xs flex items-center justify-between text-[var(--fg-primary)]"
              >
                <span>Read Config Reference</span>
                <span style="color: var(--accent-yellow);">OPEN DOC →</span>
              </a>
            </article>
          </div>
        </section>

        <!-- 4. CANONICAL DOCUMENTATION INDEX (bitty-manual) -->
        <section
          class="docs-sources-section space-y-6"
          aria-labelledby="docs-index-title"
        >
          <div class="section-header">
            <h2
              id="docs-index-title"
