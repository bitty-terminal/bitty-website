---
/**
 * Bitty website home page — Blueprint & High-Precision Terminal Native Design.
 *
 * 1. Editorial Systems Headline + Dual CTAs + Microkernel Badge.
 * 2. Multi-platform OS install box (#download) with Unix sh, pwsh, Packages, Cargo.
 * 3. 16:10 Interactive Showcase Stage (<ShowcaseStage />) featuring Hyprland-style
 *    dwindle tiling, declarative Lua GUI panels, Composer modal, architecture topology,
 *    and media slot placeholders for videos/GIFs/screenshots.
 * 4. Architectural Pillars: Microkernel, Two-Tier Ext, GUI Panels, Security.
 * 5. Canonical Documentation Directory: build-time validated links to published docs.
 */
import { getCollection } from "astro:content";
import { sep } from "node:path";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ShowcaseStage from "../components/ShowcaseStage.astro";
import { sourcePathToRouteIdentity } from "../lib/docsRoutes.ts";
import { publicationMetadataFromEntry } from "../lib/docsEntries.ts";
import { isPublished } from "../lib/publicationPolicy.ts";
import "../styles/global.css";

type HomeDoc = {
  title: string;
  description: string;
  status: string;
  href: string;
};

// Canonical source paths surfaced on the home page (build-time validated).
const USAGE_SOURCES = [
  "docs/projects/bitty/user-guide/README.md",
  "docs/projects/bitty/how-to/README.md",
  "docs/projects/bitty/tutorials/README.md",
  "docs/projects/bitty/troubleshooting/README.md",
  "docs/projects/bitty/examples/README.md",
];

const CONFIGURATION_SOURCES = [
  "docs/projects/bitty/configuration/lua-and-xdg.md",
  "docs/projects/bitty/configuration/themes.md",
];

const ARCHITECTURE_SOURCES = [
  "docs/projects/bitty/architecture/overview.md",
  "docs/projects/bitty/architecture/core-boundaries.md",
  "docs/projects/bitty/interfaces/rich-content.md",
];

const ALSO_SOURCES = [
  "docs/projects/bitty/product/vision.md",
  "docs/roadmap/README.md",
];

function sourcePathFromFilePath(filePath: string, id: string): string {
  const posix = filePath.split(sep).join("/");
  const marker = "src/content/docs/";
  const index = posix.lastIndexOf(marker);
  if (index === -1) {
    throw new Error(`Docs entry "${id}" is outside src/content/docs`);
  }
  return posix.slice(index + marker.length);
}

async function resolveHomeDocs(sources: string[]): Promise<HomeDoc[]> {
  const docs = await getCollection("docs");
  return sources.map((sourcePath) => {
    const matches = docs.filter((entry) => {
      if (entry.filePath === undefined || entry.filePath.length === 0) {
        throw new Error(`Docs entry "${entry.id}" has no filePath`);
      }
      return sourcePathFromFilePath(entry.filePath, entry.id) === sourcePath;
    });
    if (matches.length !== 1) {
      throw new Error(
        `Home page expects exactly one docs entry for "${sourcePath}", found ${matches.length}`,
      );
    }
    const entry = matches[0] as (typeof matches)[number];
    if (!isPublished(publicationMetadataFromEntry(entry))) {
      throw new Error(
        `Home page entry "${sourcePath}" is not published by the publication policy (website#97)`,
      );
    }
    return {
      title: entry.data.title,
      description: entry.data.description,
      status: entry.data.status,
      href: sourcePathToRouteIdentity(sourcePath).versionedRoute("latest"),
    };
  });
}

const usageDocs = await resolveHomeDocs(USAGE_SOURCES);
const configurationDocs = await resolveHomeDocs(CONFIGURATION_SOURCES);
const architectureDocs = await resolveHomeDocs(ARCHITECTURE_SOURCES);
const alsoDocs = await resolveHomeDocs(ALSO_SOURCES);
---

<!doctype html>
<html lang="en" data-theme="tokyo-night">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Bitty — High-performance, programmable GPU-accelerated terminal emulator pairing a lightweight Rust microkernel with an isolated Lua sandbox and Hyprland-style tiling."
    />
    <link rel="canonical" href="https://bitty.run/" />
    <link rel="icon" type="image/x-icon" href="/icons/favicon.ico" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/favicon-32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/icons/favicon-16.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/apple-touch-icon.png"
    />
    <title>Bitty — Programmable GPU Terminal Emulator</title>

    <script is:inline>
      (() => {
        const VALID_THEMES = [
          "tokyo-night",
          "catppuccin-mocha",
          "gruvbox-dark",
          "paper-light",
        ];
        let theme = "tokyo-night";
        try {
          const params = new URLSearchParams(window.location.search);
          const urlTheme = params.get("theme");
          if (urlTheme && VALID_THEMES.includes(urlTheme)) {
            theme = urlTheme;
          } else {
            let savedTheme = null;
            try {
              savedTheme = localStorage.getItem("bitty-theme");
            } catch {
              // Blocked storage
            }
            if (savedTheme && VALID_THEMES.includes(savedTheme)) {
              theme = savedTheme;
            }
          }
        } catch {
          // Fall back to default
        }
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>
    <SiteHeader version="latest" />

    <main id="main-content" class="home-main" tabindex="-1">
      <div class="content-container">
        <!-- 1. HERO HEADER + DOWNLOAD BOX -->
        <section class="hero-section" aria-labelledby="hero-title">
          <div class="hero-grid">
            <!-- Left: Headline & Subtitle -->
            <div class="hero-content space-y-5">
              <div class="badge-row font-mono-tech">
                <span class="badge-microkernel">MICROKERNEL</span>
                <span class="badge-meta">
                  Rust Core · Piccolo Lua Sandbox · Hyprland-Style Tiling
                </span>
              </div>

              <h1 id="hero-title" class="hero-title font-display">
                A tiling compositor inside your GPU terminal.
              </h1>

              <p class="hero-lede">
                Bitty decouples window containers from raw PTY streams. Tile
                shells alongside declarative Lua GUI panels in a fuel-metered
                Piccolo sandbox, backed by zero-daemon Rust stdio coprocesses.
              </p>

              <!-- Dual CTAs -->
              <div class="hero-actions font-mono-tech">
                <a href="#download" class="cta-primary">
                  <span>Install Bitty 0.0.23</span>
                  <span class="cta-arrow" aria-hidden="true">
                    ↘
                  </span>
                </a>
                <a href="/docs/latest/" class="cta-secondary">
                  <span>Read Documentation</span>
                  <span class="cta-arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </div>
            </div>

            <!-- Right: Interactive One-Liner Box -->
            <div id="download" class="download-box-col">
              <div class="blueprint-box download-card shadow-2xl">
                <!-- OS Selector Tabs -->
                <div
                  class="download-tabs font-mono-tech"
                  role="tablist"
                  aria-label="Operating System Install Commands"
                >
                  <button
                    type="button"
                    role="tab"
                    id="dl-tab-unix"
                    aria-selected="true"
                    tabindex="0"
                    data-dl-tab="unix"
                    class="dl-tab active"
                  >
                    sh (Unix)
                  </button>
                  <button
                    type="button"
                    role="tab"
                    id="dl-tab-win"
                    aria-selected="false"
                    tabindex="-1"
                    data-dl-tab="win"
                    class="dl-tab"
                  >
                    pwsh (Win)
                  </button>
                  <button
                    type="button"
                    role="tab"
                    id="dl-tab-pkg"
                    aria-selected="false"
                    tabindex="-1"
                    data-dl-tab="pkg"
                    class="dl-tab"
                  >
                    Packages
                  </button>
                  <button
                    type="button"
                    role="tab"
                    id="dl-tab-cargo"
                    aria-selected="false"
                    tabindex="-1"
                    data-dl-tab="cargo"
                    class="dl-tab"
                  >
                    Cargo
                  </button>
                </div>

                <!-- Command display & Copy button -->
                <div class="download-body">
                  <div class="command-line font-mono-tech">
                    <span class="prompt-sym select-none">$</span>
                    <span id="dl-command-text">
                      curl -fsSL https://cdn.bitty.run/bitty/install/install.sh
                      | bash
                    </span>
                    <button
                      type="button"
                      id="copy-dl-btn"
                      class="copy-btn font-mono-tech"
                      aria-label="Copy install command"
                    >
                      <span id="copy-dl-label">Copy</span>
                    </button>
                  </div>

                  <!-- Direct Artifact Downloads from Cloudflare R2 -->
                  <div class="artifact-row font-mono-tech">
                    <span class="artifact-label">Direct R2 artifacts:</span>
                    <div class="artifact-links">
                      <a
                        href="https://cdn.bitty.run/bitty/releases/bitty-linux-x86_64.tar.zst"
                        class="artifact-link"
                      >
                        Linux (.tar.zst)
                      </a>
                      <span class="sep">·</span>
                      <a
                        href="https://cdn.bitty.run/bitty/releases/bitty-macos-universal.dmg"
                        class="artifact-link"
                      >
                        macOS (.dmg)
                      </a>
                      <span class="sep">·</span>
                      <a
                        href="https://cdn.bitty.run/bitty/releases/bitty-windows-x64.zip"
                        class="artifact-link"
                      >
                        Win64 (.zip)
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- 2. 16:10 INTERACTIVE SHOWCASE STAGE (Media Slot Support) -->
        <section
          class="stage-section"
          aria-label="Terminal Feature Demonstration"
        >
          <ShowcaseStage />
        </section>

        <!-- 3. ARCHITECTURAL PILLARS -->
        <section class="pillars-section" aria-labelledby="pillars-title">
          <div class="section-header">
            <h2 id="pillars-title" class="section-title font-display">
              Engineered for Composability &amp; Isolation
            </h2>
            <p class="section-subtitle">
              Zero monolithic bloat. Bitty separates terminal mechanics from
              extension policy.
            </p>
          </div>

          <div class="pillars-grid">
            <!-- Pillar 1 -->
            <div class="blueprint-box pillar-card">
              <div class="pillar-tag font-mono-tech">
                01 // MICROKERNEL ENGINE
              </div>
              <h3 class="pillar-heading font-display">
                Decoupled View &amp; Terminal
              </h3>
              <p class="pillar-text">
                Terminal owns the PTY, VT state machine, grid, and scrollback.
                View owns presentation, hit testing, and selection. Multiple
                views can observe a single PTY session without stream
                corruption.
              </p>
            </div>

            <!-- Pillar 2 -->
            <div class="blueprint-box pillar-card">
              <div class="pillar-tag font-mono-tech">
                02 // TWO-TIER EXTENSIONS
              </div>
              <h3 class="pillar-heading font-display">
                Rust Upstream + Lua Downstream
              </h3>
              <p class="pillar-text">
                Heavy lifting (network, audio, storage) lives in native
                zero-daemon coprocesses behind TOFU-pinned stdio wire protocol
                boundaries. User customization runs in sandboxed Lua.
              </p>
            </div>

            <!-- Pillar 3 -->
            <div class="blueprint-box pillar-card">
              <div class="pillar-tag font-mono-tech">
                03 // TILING COMPOSITOR
              </div>
              <h3 class="pillar-heading font-display">Panels Beyond PTYs</h3>
              <p class="pillar-text">
                Hyprland-inspired dwindle and master layouts. A panel is not
                merely a command shell: mount rich, declarative Lua GUI scene
                trees alongside terminals in the same accelerated viewport.
              </p>
            </div>

            <!-- Pillar 4 -->
            <div class="blueprint-box pillar-card">
              <div class="pillar-tag font-mono-tech">
                04 // CAPABILITY SANDBOX
              </div>
              <h3 class="pillar-heading font-display">
                Deny-by-Default Confinement
              </h3>
              <p class="pillar-text">
                Each plugin VM is metered by instruction fuel with a 32 MiB
                memory ceiling. Invocations of system tools run under Linux
                Landlock execution confinement with an append-only audit ledger.
              </p>
            </div>
          </div>
        </section>

        <!-- 4. CANONICAL DOCUMENTATION INDEX -->
        <section
          class="docs-sources-section"
          aria-labelledby="docs-index-title"
        >
          <div class="section-header">
            <h2 id="docs-index-title" class="section-title font-display">
              Published Documentation
            </h2>
            <p class="section-subtitle">
              Canonical technical corpora synchronized and verified across four
              independent repositories.
            </p>
          </div>

          <div class="docs-groups-grid">
            <!-- Usage & Tour -->
            <div class="blueprint-box doc-group-card">
              <h3 class="doc-group-title font-mono-tech">
                USER GUIDE &amp; TOUR
              </h3>
              <ul class="doc-list font-mono-tech">
                {usageDocs.map((doc) => (
                  <li class="doc-item">
                    <a href={doc.href} class="doc-link">
                      <span class="doc-name">{doc.title}</span>
                      <span class="doc-status">{doc.status}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Configuration -->
            <div class="blueprint-box doc-group-card">
              <h3 class="doc-group-title font-mono-tech">
                CONFIGURATION &amp; THEMES
              </h3>
              <ul class="doc-list font-mono-tech">
                {configurationDocs.map((doc) => (
                  <li class="doc-item">
                    <a href={doc.href} class="doc-link">
                      <span class="doc-name">{doc.title}</span>
                      <span class="doc-status">{doc.status}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Architecture -->
            <div class="blueprint-box doc-group-card">
              <h3 class="doc-group-title font-mono-tech">CORE ARCHITECTURE</h3>
              <ul class="doc-list font-mono-tech">
                {architectureDocs.map((doc) => (
                  <li class="doc-item">
                    <a href={doc.href} class="doc-link">
                      <span class="doc-name">{doc.title}</span>
                      <span class="doc-status">{doc.status}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Vision & Roadmap -->
            <div class="blueprint-box doc-group-card">
              <h3 class="doc-group-title font-mono-tech">
                VISION &amp; ROADMAP
              </h3>
              <ul class="doc-list font-mono-tech">
                {alsoDocs.map((doc) => (
                  <li class="doc-item">
                    <a href={doc.href} class="doc-link">
                      <span class="doc-name">{doc.title}</span>
                      <span class="doc-status">{doc.status}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      </div>
    </main>

    <SiteFooter />

    <script>
      (() => {
        // OS Tabs switching logic
        const dlTabs = document.querySelectorAll<HTMLButtonElement>(".dl-tab");
        const dlCommandText = document.getElementById("dl-command-text");
        const copyBtn = document.getElementById("copy-dl-btn");
        const copyLabel = document.getElementById("copy-dl-label");

        const installCommands: Record<string, string> = {
          unix: "curl -fsSL https://cdn.bitty.run/bitty/install/install.sh | bash",
          win: "irm https://cdn.bitty.run/bitty/install/install.ps1 | iex",
          pkg: "paru -S bitty-bin # or brew install bitty / scoop install bitty",
          cargo:
            "cargo +1.98.1 install --git https://github.com/bitty-terminal/bitty.git bitty-terminal --locked",
        };

        const dlTabList = Array.from(dlTabs);
        const activateDlTab = (tab: HTMLButtonElement, focus = true) => {
          const key = tab.getAttribute("data-dl-tab");
          if (!key) return;

          dlTabs.forEach((t) => {
            t.classList.remove("active");
            t.setAttribute("aria-selected", "false");
            t.tabIndex = -1;
          });
          tab.classList.add("active");
          tab.setAttribute("aria-selected", "true");
          tab.tabIndex = 0;
          if (focus) tab.focus();

          if (dlCommandText && installCommands[key]) {
            dlCommandText.textContent = installCommands[key];
          }
        };

        dlTabs.forEach((tab, index) => {
          tab.addEventListener("click", () => activateDlTab(tab, false));

          tab.addEventListener("keydown", (e) => {
            let newIndex = index;
            if (e.key === "ArrowRight" || e.key === "ArrowDown") {
              e.preventDefault();
              newIndex = (index + 1) % dlTabList.length;
            } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
              e.preventDefault();
              newIndex = (index - 1 + dlTabList.length) % dlTabList.length;
            } else if (e.key === "Home") {
              e.preventDefault();
              newIndex = 0;
            } else if (e.key === "End") {
              e.preventDefault();
              newIndex = dlTabList.length - 1;
            } else {
              return;
            }
            const nextTab = dlTabList[newIndex];
            if (nextTab) activateDlTab(nextTab, true);
          });
        });

        // Copy button behavior
        copyBtn?.addEventListener("click", async () => {
          if (!dlCommandText) return;
          try {
            await navigator.clipboard.writeText(
              dlCommandText.textContent || "",
            );
            if (copyLabel) {
              copyLabel.textContent = "Copied ✓";
              setTimeout(() => {
                copyLabel.textContent = "Copy";
              }, 2000);
            }
          } catch {}
        });
      })();
    </script>
  </body>
</html>

<style>
  .home-main {
    min-height: 100vh;
    padding-bottom: 5rem;
  }

  .content-container {
    max-width: var(--docs-content-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* 1. Hero Section */
  .hero-section {
    padding-top: 3.5rem;
    padding-bottom: 2rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: end;
  }

  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: 7fr 5fr;
    }
  }

  .badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.75rem;
    color: var(--fg-secondary);
  }

