---
/**
 * Bitty website v1 home page.
 *
 * Presentation only: section framing is website-owned copy, while every
 * linked title, description, and status badge is rendered verbatim from the
 * pinned canonical frontmatter at build time. If a pinned entry below is
 * missing or no longer eligible for publication, the build fails closed
 * instead of rendering a stale link. Text only: no screenshots, no video,
 * no raster assets.
 */
import { getCollection } from "astro:content";
import { sep } from "node:path";
import ArchitectureDiagram from "../components/ArchitectureDiagram.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import TerminalIllustration from "../components/TerminalIllustration.astro";
import { sourcePathToRouteIdentity } from "../lib/docsRoutes.ts";
import "../styles/global.css";

type HomeDoc = {
  title: string;
  description: string;
  status: string;
  href: string;
};

// Canonical source paths (relative to src/content/docs) surfaced on the
// home page. Single pinned bitty-docs revision; no mirror edits.
const USAGE_SOURCES = [
  "docs/projects/bitty/user-guide/README.md",
  "docs/projects/bitty/how-to/README.md",
  "docs/projects/bitty/tutorials/README.md",
  "docs/projects/bitty/troubleshooting/README.md",
  "docs/projects/bitty/examples/README.md",
];

const CONFIGURATION_SOURCES = [
  "docs/projects/bitty/configuration/lua-and-xdg.md",
  "docs/projects/bitty/configuration/themes.md",
];

const ARCHITECTURE_SOURCES = [
  "docs/projects/bitty/architecture/overview.md",
  "docs/projects/bitty/architecture/core-boundaries.md",
  "docs/projects/bitty/extensibility/plugin-system.md",
];

const ALSO_SOURCES = [
  "docs/projects/bitty/product/vision.md",
  "docs/security/overview.md",
];

function sourcePathFromFilePath(filePath: string, id: string): string {
  const posix = filePath.split(sep).join("/");
  const marker = "src/content/docs/";
  const index = posix.lastIndexOf(marker);
  if (index === -1) {
    throw new Error(`Docs entry "${id}" is outside src/content/docs`);
  }
  return posix.slice(index + marker.length);
}

async function resolveHomeDocs(sources: string[]): Promise<HomeDoc[]> {
  const docs = await getCollection("docs");
  return sources.map((sourcePath) => {
    const matches = docs.filter((entry) => {
      if (entry.filePath === undefined || entry.filePath.length === 0) {
        throw new Error(`Docs entry "${entry.id}" has no filePath`);
      }
      return sourcePathFromFilePath(entry.filePath, entry.id) === sourcePath;
    });
    if (matches.length !== 1) {
      throw new Error(
        `Home page expects exactly one docs entry for "${sourcePath}", found ${matches.length}`,
      );
    }
    const entry = matches[0] as (typeof matches)[number];
    if (entry.data.website_publish !== true) {
      throw new Error(
        `Home page entry "${sourcePath}" is not eligible for publication`,
      );
    }
    return {
      title: entry.data.title,
      description: entry.data.description,
      status: entry.data.status,
      href: sourcePathToRouteIdentity(sourcePath).versionedRoute("latest"),
    };
  });
}

const usageDocs = await resolveHomeDocs(USAGE_SOURCES);
const configurationDocs = await resolveHomeDocs(CONFIGURATION_SOURCES);
const architectureDocs = await resolveHomeDocs(ARCHITECTURE_SOURCES);
const alsoDocs = await resolveHomeDocs(ALSO_SOURCES);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Bitty is a small terminal project with a warm heart. Read the published usage, configuration, and architecture notes."
    />
    <link rel="canonical" href="https://bitty.run/" />
    <link rel="icon" type="image/x-icon" href="/icons/favicon.ico" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/favicon-32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/icons/favicon-16.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/apple-touch-icon.png"
    />
    <title>Bitty | Small terminal, serious workspace</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content" class="home-shell" tabindex="-1">
      <section class="home-hero" aria-labelledby="home-title">
        <div class="home-hero-copy">
          <p class="eyebrow">Pre-implementation. No public release.</p>
          <h1 id="home-title">
            A small terminal for a workspace that grows with you.
          </h1>
          <p class="home-lede">
            Bitty is being designed as a fast, extensible terminal. This site
            gathers the published design notes for using Bitty, configuring it,
            and understanding how its parts fit together.
          </p>
          <ul class="home-hero-actions">
            <li><a class="button" href="#usage">Read usage docs</a></li>
            <li>
              <a class="button button--ghost" href="/docs/latest/">
                Browse all docs
              </a>
            </li>
          </ul>
          <p class="home-status">
            Bitty is pre-implementation: nothing below is installable yet. Each
            link carries its document status so draft contracts are never
            mistaken for stable behavior.
          </p>
        </div>
      </section>

      <section class="home-stage" aria-labelledby="stage-title">
        <div>
          <h2 id="stage-title">Choose a starting point</h2>
          <ul class="home-section-index">
            <li>
              <a href="#usage">
                <span>Usage</span>
                <small>Learn one supported task at a time.</small>
              </a>
            </li>
            <li>
              <a href="#configuration">
                <span>Configuration</span>
                <small>Shape Bitty with Lua and XDG layers.</small>
              </a>
            </li>
            <li>
              <a href="#architecture">
                <span>Architecture</span>
                <small
                  >See how the core, plugins, and config fit together.</small
                >
              </a>
            </li>
          </ul>
        </div>
        <TerminalIllustration />
      </section>

      <section
        class="home-documentation"
        id="usage"
        aria-labelledby="documentation-title"
      >
        <div class="home-documentation-intro">
          <h2 id="documentation-title">Published documentation</h2>
          <p>
            Read the canonical pages in context. Every description and status
            below is rendered from the pinned documentation source.
          </p>
        </div>
        <dl class="doc-ledger">
          <div class="doc-ledger-item" id="usage-docs">
            <dt class="doc-group-name">Usage</dt>
            <dd>
              <ul class="doc-links">
                {
                  usageDocs.map((doc) => (
                    <li>
                      <a class="doc-link" href={doc.href}>
                        <span class="doc-link-title">{doc.title}</span>
                        <span class="doc-link-description">
                          {doc.description}
                        </span>
                        <span class="doc-status" data-status={doc.status}>
                          {doc.status}
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </dd>
          </div>
          <div class="doc-ledger-item" id="configuration">
            <dt class="doc-group-name">Configuration</dt>
            <dd>
              <ul class="doc-links">
                {
                  configurationDocs.map((doc) => (
                    <li>
                      <a class="doc-link" href={doc.href}>
                        <span class="doc-link-title">{doc.title}</span>
                        <span class="doc-link-description">
                          {doc.description}
                        </span>
                        <span class="doc-status" data-status={doc.status}>
                          {doc.status}
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </dd>
          </div>
          <div class="doc-ledger-item" id="architecture">
            <dt class="doc-group-name">Architecture</dt>
            <dd>
              <ul class="doc-links">
                {
                  architectureDocs.map((doc) => (
                    <li>
                      <a class="doc-link" href={doc.href}>
                        <span class="doc-link-title">{doc.title}</span>
                        <span class="doc-link-description">
                          {doc.description}
                        </span>
                        <span class="doc-status" data-status={doc.status}>
                          {doc.status}
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </dd>
          </div>
        </dl>
      </section>

      <figure class="home-diagram" aria-labelledby="diagram-title">
        <h2 id="diagram-title">How Bitty fits together</h2>
        <div class="diagram-scroll">
          <ArchitectureDiagram />
        </div>
        <figcaption>
          Illustration only. The normative boundaries live in the
          <a href={architectureDocs[0]?.href ?? "/docs/latest/"}>
            Architecture Overview
          </a>
          and its companion contracts.
        </figcaption>
      </figure>

      <section class="home-also" aria-labelledby="also-title">
        <h2 id="also-title">Also worth reading</h2>
        <ul>
          {
            alsoDocs.map((doc) => (
              <li>
                <a href={doc.href}>{doc.title}</a>: {doc.description}
              </li>
            ))
          }
        </ul>
      </section>
    </main>
    <SiteFooter />
  </body>
</html>
