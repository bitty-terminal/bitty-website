    line-height: 1.08;
    letter-spacing: -0.035em;
    color: var(--fg-primary);
  }

  .hero-lede {
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.65;
    color: var(--fg-secondary);
