    <script>
      import {
        translations,
        type SupportedLang,
        type Translations,
      } from "../lib/translations";
      import { INSTALL_SH_URL, INSTALL_PS1_URL } from "../lib/release";

      (() => {
        // 1. Language state and reactive update
        let currentLang: SupportedLang = "en";

        const installCommands: Record<string, string> = {
          unix: `curl -fsSL ${INSTALL_SH_URL} | bash`,
          win: `irm ${INSTALL_PS1_URL} | iex`,
          pkg: "paru -S bitty-bin # or apt / dnf / zypper / nix / flatpak (see matrix)",
          cargo:
            "cargo +1.98.1 install --git https://github.com/bitty-terminal/bitty.git bitty-terminal --locked",
        };

        const installHints: Record<SupportedLang, Record<string, string>> = {
          en: {
            unix: translations.en.installHintUnix,
            win: translations.en.installHintWin,
            pkg: translations.en.installHintPkg,
            cargo: translations.en.installHintCargo,
          },
          "zh-CN": {
            unix: translations["zh-CN"].installHintUnix,
            win: translations["zh-CN"].installHintWin,
            pkg: translations["zh-CN"].installHintPkg,
            cargo: translations["zh-CN"].installHintCargo,
          },
        };

        let currentActiveTabKey = "unix";

        function applyLanguage(lang: SupportedLang) {
          currentLang = lang;
          document.documentElement.setAttribute("data-lang", lang);
          try {
            localStorage.setItem("bitty_lang", lang);
          } catch {}

          const dict = translations[lang];
          if (!dict) return;

          // Update all data-i18n elements
          document
            .querySelectorAll<HTMLElement>("[data-i18n]")
            .forEach((el) => {
              const key = el.getAttribute("data-i18n") as keyof Translations;
              if (key && dict[key]) {
                el.textContent = dict[key];
              }
            });

          // Update all data-i18n-placeholder elements
          document
            .querySelectorAll<HTMLInputElement>("[data-i18n-placeholder]")
            .forEach((el) => {
              const key = el.getAttribute(
                "data-i18n-placeholder",
              ) as keyof Translations;
              if (key && dict[key]) {
                el.placeholder = dict[key];
              }
            });

          // Update current hint text
          const hint = document.getElementById("dl-hint-text");
          if (hint && installHints[lang]?.[currentActiveTabKey]) {
            hint.textContent = installHints[lang][currentActiveTabKey];
          }

          // Dispatch updated event for header synchronization
          window.dispatchEvent(
            new CustomEvent("bitty-lang-updated", { detail: { lang } }),
          );
        }

        // 2. OS Tabs switching logic (Zero CLS)
        const dlTabs = document.querySelectorAll<HTMLButtonElement>(".dl-tab");
        const dlCommandText = document.getElementById("dl-command-text");
        const copyBtn = document.getElementById("copy-dl-btn");
        const copyLabel = document.getElementById("copy-dl-label");

        const dlTabList = Array.from(dlTabs);
        const activateDlTab = (tab: HTMLButtonElement, focus = true) => {
          const key = tab.getAttribute("data-dl-tab");
          if (!key) return;
          currentActiveTabKey = key;

          dlTabs.forEach((t) => {
            t.classList.remove("active");
            t.setAttribute("aria-selected", "false");
            t.tabIndex = -1;
          });
          tab.classList.add("active");
          tab.setAttribute("aria-selected", "true");
          tab.tabIndex = 0;

          if (focus) tab.focus();

          if (dlCommandText && installCommands[key]) {
            dlCommandText.textContent = installCommands[key];
          }
          const hint = document.getElementById("dl-hint-text");
          if (hint && installHints[currentLang]?.[key]) {
            hint.textContent = installHints[currentLang][key];
          }
        };

        dlTabs.forEach((tab) => {
          tab.addEventListener("click", () => activateDlTab(tab, false));
          tab.addEventListener("keydown", (e) => {
            const index = dlTabList.indexOf(tab);
            if (index === -1) return;
            let nextIndex = -1;

            if (e.key === "ArrowRight") {
              nextIndex = (index + 1) % dlTabList.length;
            } else if (e.key === "ArrowLeft") {
              nextIndex = (index - 1 + dlTabList.length) % dlTabList.length;
            } else if (e.key === "Home") {
              nextIndex = 0;
            } else if (e.key === "End") {
              nextIndex = dlTabList.length - 1;
            }

            if (nextIndex !== -1) {
              e.preventDefault();
              const nextTab = dlTabList[nextIndex];
              if (nextTab) activateDlTab(nextTab, true);
            }
          });
        });

        // 3. One-click copy
        copyBtn?.addEventListener("click", async () => {
          const text = dlCommandText?.textContent?.trim() || "";
          try {
            await navigator.clipboard.writeText(text);
            if (copyLabel) {
              const dict = translations[currentLang] || translations.en;
              copyLabel.textContent = dict.copiedBtnLabel;
              setTimeout(() => {
                const nowDict = translations[currentLang] || translations.en;
                copyLabel.textContent = nowDict.copyBtnLabel;
              }, 2000);
            }
          } catch {}
        });

        // 4. Initial language detection & header toggle listener
        window.addEventListener("bitty-lang-toggle", ((
          e: CustomEvent<{ nextLang: SupportedLang }>,
        ) => {
          const target =
            e.detail?.nextLang || (currentLang === "zh-CN" ? "en" : "zh-CN");
          applyLanguage(target);
        }) as EventListener);

        // Check stored preference or navigator language
        let initialLang: SupportedLang = "en";
        try {
          const saved = localStorage.getItem("bitty_lang") as SupportedLang;
          if (saved === "zh-CN" || saved === "en") {
            initialLang = saved;
          } else if (
            navigator.language &&
            navigator.language.startsWith("zh")
          ) {
            initialLang = "zh-CN";
          }
        } catch {}

        applyLanguage(initialLang);

        // Async IP-based geolocation check via Cloudflare trace if user hasn't explicitly set preference
        try {
          if (!localStorage.getItem("bitty_lang")) {
            fetch("/cdn-cgi/trace")
              .then((res) => res.text())
              .then((text) => {
                const locMatch = text.match(/loc=([A-Z]{2})/);
                if (locMatch) {
                  const loc = locMatch[1];
                  if (["CN", "HK", "MO", "TW"].includes(loc)) {
                    if (!localStorage.getItem("bitty_lang")) {
                      applyLanguage("zh-CN");
                    }
                  }
                }
              })
              .catch(() => {});
          }
        } catch {}
      })();
    </script>
