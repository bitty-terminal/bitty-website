---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="The pre-implementation website foundation for the Bitty project."
    />
    <title>Bitty — Website foundation</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <main id="main-content">
      <p class="eyebrow">Website foundation</p>
      <h1>Bitty</h1>
      <p class="summary">
        This static shell establishes the website build and delivery boundary.
        Product documentation and terminal functionality are not published here
        yet.
      </p>
      <p class="status" role="status">Pre-implementation · No public release</p>
    </main>
    <footer>
      <p>Built as a small, accessible, static foundation.</p>
    </footer>
  </body>
</html>
